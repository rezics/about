{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Cloudflare Pages project rezics-about (REZICS account), which serves about.rezics.com:
  // dist/ as static files, and functions/ only for `/` and unprefixed paths (dist/_routes.json).
  "name": "rezics-about",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01"
}
