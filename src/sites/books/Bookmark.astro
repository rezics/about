---
/**
 * 書籤歸位 (landing signature). A shelf of volume squares: the Work row on top, a row per
 * language edition below, the omnibus as one wide square. The red bookmark stands in the gap
 * after the last volume read; the reading-language row is marked; the next readable square is
 * outlined and a square still waiting for the reader's language says so.
 *
 * Phones first: the row labels stay put and the twelve columns sit on a track that shows about
 * five volumes. With motion the track pans with the bookmark (the same variable, --mark); without
 * script or under reduced motion it is a horizontal scroll-snap row. On wide screens all twelve
 * columns show. The server renders the final state; bookmark.ts drives it from the reading
 * position. The figure is decorative (aria-hidden); the steps beside it carry the meaning.
 */
import site from '../../content/sites/books';
import { PUBLISHED, ROWS, STEPS, VOLUMES, state, type Cell, type Row } from './bookmark-state';

const s = site.strings.landing.bookmark;
const fin = state(STEPS);
const vols = Array.from({ length: VOLUMES }, (_, i) => i + 1);
const rowIndex: Record<Row, number> = { ja: 2, zh: 3, omni: 4, en: 5 };
const flags = (cell: Cell) => {
  const [row, n] = cell.split(':') as [string, string];
  const read = row === 'work' ? fin.volumes.includes(Number(n)) : fin.read.includes(cell);
  return {
    'data-read': read ? '' : undefined,
    'data-next': fin.next === cell ? '' : undefined,
    'data-wait': fin.wait === cell ? '' : undefined,
  };
};
const [readingRow, readingVol] = (fin.reading ?? 'work:1').split(':') as [string, string];
const lineRow = readingRow === 'work' ? 1 : rowIndex[readingRow as Row];
const show = ROWS.filter((r) => fin.rows[r]).join(' ');
---
<div class="bm" data-bookmark data-captions={JSON.stringify(s.captions)}>
  <figure class="bm__stage" data-bm-stage>
    <figcaption class="sr-only">{s.figure}</figcaption>
    <div class="bm__frame" aria-hidden="true" data-bm-frame data-show={show} data-lang={fin.lang} style={`--mark:${fin.mark}`}>
      <div class="bm__labels">
        <span class="bm__label bm__label--work">{s.rows.work}</span>
        {ROWS.map((row) => <span class="bm__label" data-label={row}>{s.rows[row]}</span>)}
      </div>
      <div class="bm__track" data-bm-track>
        <div class="bm__grid" data-bm-grid>
          {vols.map((v) => (
            <span class="bm__cell bm__cell--work" data-cell={`work:${v}`} style={`--r:1;--v:${v}`} {...flags(`work:${v}` as Cell)}>
              <span class="bm__num">{v}</span>
            </span>
          ))}
          {ROWS.map((row) =>
            row === 'omni' ? (
              <span class="bm__cell bm__cell--omni" data-row="omni" data-pub data-cell="omni:1" style={`--r:${rowIndex.omni};--v:1`} {...flags('omni:1')}>
                <span class="bm__omni">{s.omnibusCell}</span>
              </span>
            ) : (
              vols.map((v) => (
                <span
                  class="bm__cell"
                  data-row={row}
                  data-pub={PUBLISHED[row].includes(v) ? '' : undefined}
                  data-cell={`${row}:${v}`}
                  style={`--r:${rowIndex[row]};--v:${v}`}
                  {...flags(`${row}:${v}` as Cell)}
                >
                  <span class="bm__wait">{s.waiting}</span>
                </span>
              ))
            ),
          )}
          <span class="bm__line" data-bm-line style={`--lr:${lineRow};--lv:${readingVol}`}></span>
          <span class="bm__ribbon"></span>
        </div>
      </div>
    </div>
    <p class="bm__caption" aria-hidden="true" data-bm-caption>{s.captions[fin.step]}</p>
  </figure>
</div>

<script>
  import { initBookmark } from './bookmark';
  initBookmark();
</script>

<style>
  .bm__stage {
    container-type: inline-size;
    padding: clamp(14px, 2.4cqi, 28px);
    background: var(--bk-t08);
    border-top: 2px solid var(--field);
  }
  .bm__frame {
    --gap: clamp(3px, 0.55cqi, 6px);
    --label: clamp(3em, 11cqi, 5.5em);
    /* Wide: all twelve volumes. Phones (below): about five, on a track that pans. */
    --cell: calc((100cqi - var(--label) - 12 * var(--gap)) / 12);
    --step: calc(var(--cell) + var(--gap));
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr);
    column-gap: var(--gap);
  }
  @container (max-width: 560px) {
    .bm__frame { --cell: calc((100cqi - var(--label) - var(--gap) - 4.4 * var(--gap)) / 5.4); }
  }
  .bm__labels, .bm__grid { display: grid; grid-auto-rows: var(--cell); row-gap: var(--gap); }
  .bm__labels { padding-bottom: calc(var(--gap) + 12px); }
  .bm__track { overflow: clip; padding-top: var(--gap); margin-top: calc(-1 * var(--gap)); }
  .bm__grid {
    position: relative;
    grid-template-columns: repeat(12, var(--cell));
    column-gap: var(--gap);
    width: max-content;
    padding-bottom: calc(var(--gap) + 12px);
  }
  @container (max-width: 560px) {
    /* The track follows the bookmark: about two volumes stay visible before it. */
    :global(.motion) .bm__grid {
      translate: calc(-1 * clamp(0px, (var(--mark) - 2) * var(--step), 12 * var(--step) - var(--gap) - (100cqi - var(--label) - var(--gap)))) 0;
    }
    :global(html:not(.motion)) .bm__track { overflow-x: auto; scroll-snap-type: x mandatory; }
    :global(html:not(.motion)) .bm__cell--work { scroll-snap-align: start; }
  }

  .bm__label {
    align-self: center;
    font-size: clamp(0.6875rem, 2.4cqi, 0.875rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--c-muted);
    white-space: nowrap;
    transition: color var(--d-s) var(--ease-snap), opacity var(--d-m) var(--ease-snap), translate var(--d-m) var(--ease-snap);
  }
  .bm__label--work { color: var(--c-fg); }
  .bm__frame[data-lang='ja'] [data-label='ja'],
  .bm__frame[data-lang='zh'] [data-label='zh'] { color: var(--c-fg); }
  .bm__frame[data-lang='ja'] [data-label='ja']::before,
  .bm__frame[data-lang='zh'] [data-label='zh']::before {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.35em;
    background: var(--field);
    vertical-align: 0.05em;
  }

  .bm__cell {
    position: relative;
    grid-row: var(--r);
    grid-column: var(--v);
    border: 1px solid var(--c-line);
    background: var(--bk-paper);
    transition: opacity var(--d-m) var(--ease-snap), translate var(--d-m) var(--ease-snap);
    transition-delay: calc(var(--v) * 30ms);
  }
  .bm__cell--omni { grid-column: 1 / span 3; display: grid; place-items: center; }
  .bm__cell[data-pub] { border: 1.5px solid var(--field); }
  .bm__cell::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: var(--field);
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--d-s) var(--ease-snap);
  }
  .bm__cell[data-read]::before { clip-path: inset(0 0 0 0); }
  .bm__cell[data-next] { outline: 2px solid var(--field); outline-offset: 2px; background: var(--bk-t16); }
  .bm__cell[data-wait] { border: 1.5px dashed var(--field); }
  .bm__wait {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(0.5625rem, 1.7cqi, 0.75rem);
    font-weight: 700;
    color: var(--field);
    opacity: 0;
    transition: opacity var(--d-s);
  }
  @container (max-width: 560px) { .bm__wait { font-size: 0.6875rem; } }
  .bm__cell[data-wait] .bm__wait { opacity: 1; }
  .bm__num, .bm__omni {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    height: 100%;
    font-family: 'Archivo', var(--f-cjk);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: clamp(0.75rem, 2.3cqi, 1rem);
    color: var(--field);
    transition: color var(--d-s) var(--ease-snap);
  }
  .bm__omni { white-space: nowrap; }
  .bm__cell[data-read] .bm__num, .bm__cell[data-read] .bm__omni { color: var(--on-field); }

  /* Rows not yet on the shelf wait faintly, shifted back along their row; they slot in. */
  .bm__frame:not([data-show~='ja']) [data-row='ja'],
  .bm__frame:not([data-show~='zh']) [data-row='zh'],
  .bm__frame:not([data-show~='omni']) [data-row='omni'],
  .bm__frame:not([data-show~='en']) [data-row='en'] {
    opacity: 0.22;
    translate: -14px 0;
  }

  /* The bookmark: a red ribbon in the gap after the last volume read, its square on the rail. */
  .bm__ribbon {
    position: absolute;
    top: calc(-1 * var(--gap));
    left: 0;
    width: 3px;
    height: calc(5 * var(--cell) + 5 * var(--gap) + 12px);
    background: var(--c-mark);
    translate: calc(max(1.5px, var(--mark) * var(--step) - var(--gap) / 2) - 1.5px) 0;
    pointer-events: none;
  }
  .bm__ribbon::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    background: var(--c-mark);
  }
  /* The idle reading line: the page under the bookmark being read (motion only). */
  .bm__line {
    display: none;
    grid-row: var(--lr);
    grid-column: var(--lv);
    align-self: end;
    z-index: 2;
    height: 3px;
    margin: 0 18% 18%;
    background: var(--field);
    transform-origin: 0 50%;
    pointer-events: none;
  }
  :global(.motion) .bm__line { display: block; }

  .bm__caption {
    margin-top: clamp(10px, 1.6cqi, 18px);
    font-size: var(--t-s);
    font-weight: 700;
    line-height: 1.5;
    min-height: 3em;
  }
</style>
