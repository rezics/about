---
// An inner page's opening with its photograph (books): the kit's photo row with the page's h1 in
// its text block, so the first screen has one focal point (the heading beside the picture)
// instead of a text-only head followed by a second heading and a picture under the fold. The
// eyebrow is the site's name; the text takes five columns, the picture the other six, feet
// level. Phones: the text first, then the picture across the width. Pages without a picture
// open on the kit's PageHead. The picture is the largest paint on desktop, so it loads at once
// and is never hidden for a reveal.
import Picture from '../../kit/components/Picture.astro';
import Clauses from '../../kit/Clauses.astro';

interface Props {
  label: string;
  title: string;
  lede: string;
  image: { src: string; widths: number[]; alt: string; width: number; height: number };
}
const { label, title, lede, image } = Astro.props;
---
<section class="bk-head" aria-labelledby="page-title">
  <div class="grid">
    <div class="bk-head__text">
      <p class="eyebrow bk-head__label">{label}</p>
      <h1 id="page-title" class="bk-head__title"><Clauses text={title} /></h1>
      <p class="bk-head__lede lead">{lede}</p>
    </div>
    <div class="bk-head__pic">
      <Picture src={image.src} widths={image.widths} alt={image.alt} width={image.width} height={image.height} sizes="(max-width: 767px) 100vw, 50vw" priority />
    </div>
  </div>
</section>
<style>
  .bk-head { padding-top: clamp(56px, 7vw, 112px); }
  .bk-head .grid { align-items: end; }
  .bk-head__text { grid-column: 1 / 6; grid-row: 1; padding-bottom: 8px; }
  .bk-head__pic { grid-column: 7 / 13; grid-row: 1; min-width: 0; }
  .bk-head__label { margin-bottom: 20px; }
  .bk-head__title { font-size: var(--t-hero); line-height: var(--lh-title); }
  .bk-head__lede { margin-top: 24px; font-size: 16px; line-height: 1.9; color: var(--c-text); max-width: none; }
  @media (max-width: 1023px) {
    .bk-head__text { grid-column: 1 / 7; }
    .bk-head__pic { grid-column: 7 / 13; }
  }
  @media (max-width: 767px) {
    .bk-head { padding-top: 48px; }
    .bk-head__text, .bk-head__pic { grid-row: auto; }
    .bk-head__label { margin-bottom: 16px; }
    .bk-head__title { font-size: 30px; }
    .bk-head__pic { margin-top: 36px; margin-inline: calc(var(--gutter) * -1); }
  }
</style>
