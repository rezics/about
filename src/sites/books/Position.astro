---
// The Wiki+ page's reading-position example (示意): pick a position (radio pills) and the people
// and events from later chapters fold away. Works without script: one CSS rule per position hides
// the entries whose first chapter lies beyond it.
import site from '../../content/sites/books';

const p = site.strings.wiki.position;
const css = p.positions
  .map((pos, i) => `.pos:has(#pos-${i}:checked) [data-ch]{--late:0}` + p.entries.filter((e) => e.chapter > pos.chapter).map((e) => `.pos:has(#pos-${i}:checked) [data-ch="${e.chapter}"]{--late:1}`).join(''))
  .join('');
const status = (i: number) => (i === p.positions.length - 1 ? p.statusAll : p.status.replace('{n}', String(p.positions[i]!.chapter)));
---
<div class="pos">
  <style is:inline set:html={css}></style>
  <fieldset class="pos__control">
    <legend class="label pos__legend">{p.control}</legend>
    {p.positions.map((pos, i) => (
      <label class="pos__pill"><input type="radio" name="wiki-position" id={`pos-${i}`} checked={i === 3} />{pos.label}</label>
    ))}
  </fieldset>
  <div class="pos__card">
    <div class="pos__statuses" aria-live="polite">
      {p.positions.map((_, i) => <p class="pos__status" data-for={i}>{status(i)}</p>)}
    </div>
    <div class="pos__groups">
      {(['people', 'events'] as const).map((g) => (
        <div class="pos__group">
          <h3 class="t-h3">{p.groups[g]}</h3>
          <ul role="list" class="pos__list">
            {p.entries.filter((e) => e.group === g).map((e) => (
              <li class="pos__entry" data-ch={e.chapter}>
                <span class="pos__name">{e.name}</span>
                {e.aliases && <span class="pos__alias">{p.aliases}{e.aliases}</span>}
                <span class="pos__note">{e.note}</span>
                <span class="pos__src label">{p.source.replace('{n}', String(e.chapter))}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="bk-note">{p.rail}</p>
  </div>
</div>
<style>
  .pos { display: flex; flex-direction: column; gap: 18px; }
  .pos__control { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .pos__legend { float: left; margin-right: 8px; color: var(--c-muted); }
  .pos__pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    background: var(--c-soft);
    font-size: var(--t-s);
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--d-s) var(--ease-soft);
  }
  .pos__pill input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .pos__pill:has(input:checked) { background: var(--field); color: #fff; }
  .pos__pill:has(:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .pos__card { display: flex; flex-direction: column; gap: 22px; padding: clamp(20px, 3vw, 36px); border-radius: var(--r-card); background: var(--c-surface); border: 1px solid var(--c-line); box-shadow: var(--shadow-card); }
  .pos__status { display: none; font-weight: 500; }
  .pos:has(#pos-0:checked) .pos__status[data-for='0'], .pos:has(#pos-1:checked) .pos__status[data-for='1'],
  .pos:has(#pos-2:checked) .pos__status[data-for='2'], .pos:has(#pos-3:checked) .pos__status[data-for='3'],
  .pos:has(#pos-4:checked) .pos__status[data-for='4'], .pos:has(#pos-5:checked) .pos__status[data-for='5'] { display: block; }
  .pos__groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); }
  .pos__list { display: flex; flex-direction: column; margin-top: 10px; }
  .pos__entry { --late: 0; display: flex; flex-direction: column; gap: 2px; padding-block: 12px; border-top: 1px solid var(--c-line); }
  /* A later entry folds into a quiet placeholder: its line stays, its text goes. */
  .pos__entry[data-ch] { opacity: calc(1 - var(--late) * 0.62); }
  .pos__entry[data-ch] > * { filter: blur(calc(var(--late) * 5px)); transition: filter var(--d-m) var(--ease-soft); }
  .pos__name { font-weight: 500; }
  .pos__alias, .pos__note { color: var(--c-muted); font-size: var(--t-s); }
  .pos__src { color: var(--c-muted); }
  @media (max-width: 599px) {
    .pos__groups { grid-template-columns: minmax(0, 1fr); }
  }
</style>
