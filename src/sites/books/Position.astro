---
// The Wiki+ page's reading-position example (示意): pick a position (radio pills, the checked
// one in ink) and the people and events from later chapters fold away into a quiet placeholder
// in their hairline lists; their text is hidden, so it is neither seen nor read out. Works
// without script: the rules below, one selector per position and later entry, are generated here.
import site from '../../content/sites/books';

const p = site.strings.wiki.position;
const late = p.positions.flatMap((pos, i) =>
  [...new Set(p.entries.filter((e) => e.chapter > pos.chapter).map((e) => e.chapter))].map((ch) => `.pos:has(#pos-${i}:checked) .pos__entry[data-ch="${ch}"]`),
);
const css = late.length
  ? `${late.map((sel) => `${sel} > *`).join(',')}{visibility:hidden}${late.map((sel) => `${sel}::after`).join(',')}{opacity:1}`
  : '';
const status = (i: number) => (i === p.positions.length - 1 ? p.statusAll : p.status.replace('{n}', String(p.positions[i]!.chapter)));
---
<div class="pos">
  <style is:inline set:html={css}></style>
  <fieldset class="pos__control">
    <legend class="pos__legend">{p.control}</legend>
    {p.positions.map((pos, i) => (
      <label class="pos__pill"><input type="radio" name="wiki-position" id={`pos-${i}`} checked={i === 3} />{pos.label}</label>
    ))}
  </fieldset>
  <div class="pos__card">
    <div class="pos__statuses" aria-live="polite">
      {p.positions.map((_, i) => <p class="pos__status" data-for={i}>{status(i)}</p>)}
    </div>
    <div class="pos__groups">
      {(['people', 'events'] as const).map((g) => (
        <div class="pos__group">
          <h3>{p.groups[g]}</h3>
          <ul role="list" class="pos__list">
            {p.entries.filter((e) => e.group === g).map((e) => (
              <li class="pos__entry" data-ch={e.chapter}>
                <span class="pos__name serif">{e.name}</span>
                {e.aliases && <span class="pos__alias">{p.aliases}{e.aliases}</span>}
                <span class="pos__note">{e.note}</span>
                <span class="pos__src">{p.source.replace('{n}', String(e.chapter))}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="pos__rail">{p.rail}</p>
  </div>
</div>
<style>
  .pos { display: flex; flex-direction: column; gap: 28px; }
  .pos__control { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .pos__legend { float: left; margin-right: 12px; font-size: 13px; color: var(--c-muted); letter-spacing: 0.04em; }
  .pos__pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid var(--c-line-strong, rgb(38 41 45 / 0.3));
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s var(--ease-soft, ease), color 0.3s var(--ease-soft, ease), border-color 0.3s var(--ease-soft, ease);
  }
  .pos__pill:hover { border-color: var(--c-fg); }
  .pos__pill input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .pos__pill:has(input:checked) { background: var(--c-fg); border-color: var(--c-fg); color: var(--c-bg); }
  .pos__pill:has(:focus-visible) { outline: 2px solid var(--focus, var(--c-link)); outline-offset: 3px; }
  .pos__card { display: flex; flex-direction: column; gap: 28px; }
  .pos__status { display: none; font-size: 15px; color: var(--c-muted); }
  .pos:has(#pos-0:checked) .pos__status[data-for='0'], .pos:has(#pos-1:checked) .pos__status[data-for='1'],
  .pos:has(#pos-2:checked) .pos__status[data-for='2'], .pos:has(#pos-3:checked) .pos__status[data-for='3'],
  .pos:has(#pos-4:checked) .pos__status[data-for='4'], .pos:has(#pos-5:checked) .pos__status[data-for='5'] { display: block; }
  .pos__groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px var(--gutter); }
  .pos__group h3 { font-size: 13px; font-weight: 400; color: var(--c-muted); letter-spacing: 0.04em; }
  .pos__list { display: flex; flex-direction: column; margin-top: 12px; border-bottom: 1px solid var(--c-line); }
  .pos__entry { position: relative; display: flex; flex-direction: column; gap: 4px; padding: 18px 0 20px; border-top: 1px solid var(--c-line); }
  /* A later entry folds into a quiet placeholder: its row stays, its text goes (hidden, so it is
     not read out either) and two soft paper bars stand in for it. */
  .pos__entry::after {
    content: '';
    position: absolute;
    left: 0;
    top: 22px;
    width: min(60%, 14em);
    height: 12px;
    background: rgb(38 41 45 / 0.1);
    box-shadow: 0 24px 0 -1px rgb(38 41 45 / 0.06);
    opacity: 0;
    transition: opacity 0.4s var(--ease-soft, ease);
    pointer-events: none;
  }
  .pos__name { font-size: 18px; font-weight: 600; line-height: 1.5; }
  .pos__alias, .pos__note { color: var(--c-text); font-size: 15px; line-height: 1.8; }
  .pos__src { font-size: 13px; color: var(--c-muted); }
  .pos__rail { font-size: 13px; color: var(--c-muted); }
  @media (max-width: 767px) {
    .pos__groups { grid-template-columns: minmax(0, 1fr); }
    .pos__legend { float: none; width: 100%; margin: 0 0 4px; }
  }
  @media (prefers-reduced-motion: reduce) { .pos__entry::after, .pos__pill { transition: none; } }
</style>
