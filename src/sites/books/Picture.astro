---
/**
 * One of the books site's pictures (public/images/sites/books/<name>-960|320.avif|webp), on its
 * field colour so the square is never empty while it loads.
 */
interface Props {
  name: string;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { name, alt, sizes = '(max-width: 767px) 92vw, 33vw', eager = false, class: className } = Astro.props;
const base = `/images/sites/books/${name}`;
---
<picture class:list={['bk-pic', className]}>
  <source type="image/avif" srcset={`${base}-320.avif 320w, ${base}-960.avif 960w`} sizes={sizes} />
  <source type="image/webp" srcset={`${base}-320.webp 320w, ${base}-960.webp 960w`} sizes={sizes} />
  <img src={`${base}-960.webp`} alt={alt} width="960" height="960" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</picture>
<style>
  .bk-pic { display: block; aspect-ratio: 1; background: var(--field, #1d5a47); overflow: clip; }
  .bk-pic img { width: 100%; height: 100%; object-fit: cover; }
</style>
