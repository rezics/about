---
// /games/store/ (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head, what is on the
// page before you pay, one purchase in six steps, what you keep as flat tiles, the ink band on
// privacy, what this store does not do, the next page and the closing block.
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import ItemList from '../../kit/components/ItemList.astro';
import TileRow from '../../kit/components/TileRow.astro';
import Band from '../../kit/components/Band.astro';
import ProductCall from '../../kit/components/ProductCall.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields } from '../../kit/theme';
import { accentRamp } from '../../kit/color';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.store;
const accent = kindFields.games.field;
const page = site.pages.find((p) => p.slug === 'store')!;
const ramp = accentRamp(accent);
const keep = s.keep.squares.map((q, i) => ({ name: q.title, line: q.body, ...ramp[[0, 2, 4][i] ?? 0]! }));
---
<PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede}>
  <ProductCall />
  <a class="link-draw" href="#purchase">{s.hero.secondary}</a>
</PageHead>

<Sec label="01" title={s.checkout.headline}>
  <p class="text">{s.checkout.caption}</p>
  <ItemGrid slot="wide" items={s.checkout.cells} cols={4} />
</Sec>

<Sec id="purchase" label="02" title={s.purchase.headline}>
  <p class="text">{s.purchase.lede}</p>
  <ItemGrid slot="wide" items={s.purchase.steps} cols={3} numbered />
</Sec>

<Sec label="03" title={s.keep.headline}>
  <p class="text">{s.keep.body}</p>
  <TileRow slot="wide" items={keep} cols={3} height={200} label={s.keep.headline} />
</Sec>

<Band label={page.label} title={s.privacy.statement} text={s.privacy.body} />

<ItemList label="04" title={s.refuses.headline} items={s.refuses.rows} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
<Closing bg={accent} />
