---
// /games/store/ (DESIGN.md "Direction v2"): the intro beside the shop window, what is on the page
// before you pay, one purchase in six steps, what you keep, the privacy statement, what this store
// does not do, and the next page.
import PageIntro from '../../kit/components/PageIntro.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import ItemList from '../../kit/components/ItemList.astro';
import Statement from '../../kit/components/Statement.astro';
import ProductCall from '../../kit/components/ProductCall.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Arrow from '../../kit/components/Arrow.astro';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.store;
---
<PageIntro title={s.hero.headline} lede={s.hero.lede} image={{ base: '/images/sites/games/store', alt: s.hero.imageAlt, ratio: 1 }}>
  <ProductCall />
  <a class="link-draw" href="#purchase">{s.hero.secondary}<Arrow dir="down" /></a>
</PageIntro>

<section class="g-sec" aria-labelledby="checkout-title">
  <div class="container g-stack">
    <SectionHead id="checkout-title" title={s.checkout.headline} lede={s.checkout.caption} />
    <ItemGrid items={s.checkout.cells} cols={4} />
  </div>
</section>

<section id="purchase" class="g-sec" aria-labelledby="purchase-title">
  <div class="container g-stack">
    <SectionHead id="purchase-title" title={s.purchase.headline} lede={s.purchase.lede} />
    <ItemGrid items={s.purchase.steps} cols={3} numbered />
  </div>
</section>

<section class="g-sec" aria-labelledby="keep-title">
  <div class="container g-stack">
    <SectionHead id="keep-title" title={s.keep.headline} lede={s.keep.body} />
    <ItemGrid items={s.keep.squares} cols={3} look="cards" />
  </div>
</section>

<Statement text={s.privacy.statement} sub={s.privacy.body} />

<ItemList title={s.refuses.headline} items={s.refuses.rows} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
