---
// /games/store/ (SITE.md "v3"): the opening with the slit photograph, eight things shown before
// paying, six purchase steps as a row of tiles, what you keep (prose), the privacy statement,
// what the store does not do, the closing.
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import TileMasonry, { type MasonryItem } from '../../kit/components/TileMasonry.astro';
import Closing from '../../kit/components/Closing.astro';
import site from '../../content/sites/games';
import Opening from './Opening.astro';
import { sectionPicture } from './pictures';
import { sequence } from './tiles';
import './games.css';

const s = site.strings.store;
const pad = (n: number) => String(n).padStart(2, '0');
// The six steps from light to deep: a purchase that settles in.
const steps: MasonryItem[] = s.purchase.steps.map((t, i) => ({ id: `step-${i + 1}`, rel: pad(i + 1), name: t.title, line: t.body, ...sequence[i]! }));
const columns = steps.map((t) => [{ id: t.id, h: 1 }]);
const phone = [0, 2, 4].map((i) => [{ id: steps[i]!.id }, { id: steps[i + 1]!.id }]);
---
<Opening label={site.name} title={s.hero.headline} lede={s.hero.lead} image={sectionPicture('store')} />

<Section eyebrow={s.checkout.label} title={s.checkout.headline} lead={s.checkout.lead}>
  <FactList items={s.checkout.items} />
</Section>

<Section eyebrow={s.purchase.label} title={s.purchase.headline} lead={s.purchase.lead}>
  <TileMasonry slot="wide" items={steps} columns={columns} phone={phone} height={300} phoneRow={150} label={s.purchase.headline} />
</Section>

<Section eyebrow={s.keep.label} title={s.keep.headline} lead={[s.keep.lead, s.keep.more]} />

<Statement text={s.privacy.text} sub={s.privacy.more} note={s.privacy.note} />

<Section eyebrow={s.refuses.label} title={s.refuses.headline}>
  <FactList items={s.refuses.items} />
</Section>

<Closing title={s.closing} body={site.strings.closingBody} />
