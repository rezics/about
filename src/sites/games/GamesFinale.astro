---
// The finale of every games page: the next page of the site in its field, and on the last page
// the next site (games → software, DESIGN.md site chain).
import Finale from '../../kit/components/Finale.astro';
import { siteFor, nextSite, pageHref } from '../../kit/sites';
import { fieldOf } from '../../kit/theme';
import site from '../../content/sites/games';

const found = siteFor(Astro.url.pathname);
const i = found ? site.pages.findIndex((p) => p.slug === found.page.slug) : 0;
const nextPage = site.pages[i + 1];
const other = nextSite(site);
const label = nextPage ? site.strings.finale.nextPage : site.strings.finale.nextSite;
const name = nextPage ? nextPage.label : (other?.name ?? site.name);
const href = nextPage ? pageHref(site, nextPage) : (other?.base ?? site.base);
const field = nextPage ? fieldOf(site.theme) : fieldOf(other?.theme);
---
<Finale label={label} name={name} href={href} field={field} />
