---
// /games/reviews/ (DESIGN.md "Direction v2"): the intro, a score per version (示意), whose score
// it is, what a review is about, how ranking works, the talk statement, and the next page.
import PageIntro from '../../kit/components/PageIntro.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import ItemList from '../../kit/components/ItemList.astro';
import Pills from '../../kit/components/Pills.astro';
import Statement from '../../kit/components/Statement.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.reviews;
---
<PageIntro title={s.hero.headline} lede={s.hero.lede} align="start" />

<section class="g-sec" aria-labelledby="versions-title">
  <div class="container g-stack">
    <SectionHead id="versions-title" title={s.versions.headline} lede={s.versions.lede} />
    <ItemGrid items={s.versions.frames} cols={5} look="cards" />
    <p class="g-cap">{s.versions.caption}</p>
  </div>
</section>

<section class="g-sec" aria-labelledby="who-title">
  <div class="container g-two">
    <SectionHead id="who-title" title={s.who.headline} lede={s.who.body} />
    <div class="g-panel" data-reveal="up">
      <Pills items={s.who.tabs} label={s.who.tabsLabel} tone="tint" />
      <Pills items={s.who.toggle} label={s.who.periodLabel} />
      <ul class="g-notes">
        {s.who.items.map((it) => <li>{it}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="g-sec" aria-labelledby="targets-title">
  <div class="container g-stack">
    <SectionHead id="targets-title" title={s.targets.headline} lede={s.targets.lede} />
    <ItemGrid items={s.targets.tiles} cols={5} />
  </div>
</section>

<ItemList title={s.rules.headline} items={s.rules.rows} />

<Statement text={s.talk.poster} sub={s.talk.body} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
