---
// /games/reviews/ (SITE.md "v3"): the opening, a score per version (示意), whose score it is,
// what a review is about, the statement on three kinds of talk, how ranking works, the closing.
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import TileMasonry, { type MasonryItem, type MasonryPlace, type MasonryRowPlace } from '../../kit/components/TileMasonry.astro';
import Closing from '../../kit/components/Closing.astro';
import site from '../../content/sites/games';
import Opening from './Opening.astro';
import { blue, sequence } from './tiles';
import './games.css';

const s = site.strings.reviews;
// Versions from the launch day to the complete edition, light to deep.
const versions: MasonryItem[] = s.versions.tiles.map((t, i) => ({ id: `v${i}`, name: t.title, line: t.body, ...sequence[i + 1]! }));
const vColumns = versions.map((v) => [{ id: v.id, h: 1 }]);
const vPhone: MasonryRowPlace[][] = [[{ id: 'v0' }, { id: 'v1' }], [{ id: 'v2' }, { id: 'v3' }], [{ id: 'v4' }]];

const tones = [blue.accent, blue.light, blue.deep, blue.tint, blue.lightest];
const targets: MasonryItem[] = s.targets.tiles.map((t, i) => ({ id: `t${i}`, name: t.title, line: t.body, ...tones[i]! }));
const tColumns: MasonryPlace[][] = [
  [{ id: 't0', h: 1 }],
  [{ id: 't1', h: 1 }, { id: 't2', h: 1 }],
  [{ id: 't3', h: 1.4 }, { id: 't4', h: 1 }],
];
const tPhone: MasonryRowPlace[][] = [[{ id: 't0' }, { id: 't1' }], [{ id: 't2' }, { id: 't3' }], [{ id: 't4' }]];
---
<Opening label={site.name} title={s.hero.headline} lede={s.hero.lead} />

<Section eyebrow={s.versions.label} title={s.versions.headline} lead={s.versions.lead}>
  <div slot="wide">
    <TileMasonry items={versions} columns={vColumns} phone={vPhone} height={260} label={s.versions.headline} />
    <p class="g-cap">{s.versions.caption}</p>
  </div>
</Section>

<Section eyebrow={s.who.label} title={s.who.headline} lead={s.who.lead}>
  <FactList items={s.who.items} />
</Section>

<Section eyebrow={s.targets.label} title={s.targets.headline} lead={s.targets.lead}>
  <TileMasonry slot="wide" items={targets} columns={tColumns} phone={tPhone} height={440} label={s.targets.headline} />
</Section>

<Statement text={s.talk.text} sub={s.talk.more} note={s.talk.note} />

<Section eyebrow={s.rules.label} title={s.rules.headline}>
  <FactList items={s.rules.items} />
</Section>

<Closing title={s.closing} body={site.strings.closingBody} />
