---
// /games/releases/ (DESIGN.md "Direction v2"): the intro beside the sorted releases, the table
// that binds language and platform to one release (示意), release states, languages,
// requirements, bundles, the offers statement, and the next page.
import PageIntro from '../../kit/components/PageIntro.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Statement from '../../kit/components/Statement.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import site from '../../content/sites/games';
import ReleaseTable from './ReleaseTable.astro';
import './games.css';

const s = site.strings.releases;
---
<PageIntro title={s.hero.headline} lede={s.hero.lede} image={{ base: '/images/sites/games/releases', alt: s.languages.imageAlt, ratio: 1 }} />

<section class="g-sec" aria-label={s.hero.caption}>
  <div class="container">
    <ReleaseTable copy={s.hero} example={site.strings.example} />
  </div>
</section>

<section class="g-sec" aria-labelledby="states-title">
  <div class="container g-stack">
    <SectionHead id="states-title" title={s.states.headline} lede={s.states.lede} />
    <ItemGrid items={s.states.steps} cols={5} numbered />
  </div>
</section>

<section class="g-sec" aria-labelledby="lang-title">
  <div class="container g-stack">
    <SectionHead id="lang-title" title={s.languages.headline} lede={s.languages.body} />
    <ItemGrid items={s.languages.items} cols={3} look="cards" />
  </div>
</section>

<section class="g-sec" aria-labelledby="req-title">
  <div class="container g-stack">
    <SectionHead id="req-title" title={s.requirements.headline} lede={s.requirements.lede} />
    <ItemGrid items={s.requirements.columns} cols={3} />
  </div>
</section>

<section class="g-sec" aria-labelledby="bundle-title">
  <div class="container g-stack">
    <SectionHead id="bundle-title" title={s.bundles.headline} lede={s.bundles.lede} />
    <ItemGrid items={s.bundles.tiles} cols={3} look="cards" />
  </div>
</section>

<Statement text={s.offers.statement} sub={s.offers.body} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
