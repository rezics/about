---
// /games/releases/ (SITE.md "v3"): the opening, the release filter (示意), release states,
// three kinds of language, what one release can hold, the statement on 未知, requirements, the
// closing.
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import TileMasonry, { type MasonryItem, type MasonryPlace, type MasonryRowPlace } from '../../kit/components/TileMasonry.astro';
import Closing from '../../kit/components/Closing.astro';
import site from '../../content/sites/games';
import Opening from './Opening.astro';
import ReleaseTable from './ReleaseTable.astro';
import { blue } from './tiles';
import './games.css';

const s = site.strings.releases;
// What one release can hold: the complete edition tallest (it holds the others), then what it
// holds, then what stands beside it.
const tones = [blue.accent, blue.light, blue.deep, blue.tint, blue.deeper, blue.lightest];
const ids = ['complete', 'base', 'expansion', 'soundtrack', 'remake', 'mod'];
const bundles: MasonryItem[] = s.bundles.tiles.map((t, i) => ({ id: ids[i]!, name: t.title, line: t.body, ...tones[i]! }));
const columns: MasonryPlace[][] = [
  [{ id: 'complete', h: 1 }],
  [{ id: 'base', h: 1 }, { id: 'expansion', h: 1 }],
  [{ id: 'soundtrack', h: 1.3 }, { id: 'remake', h: 1 }, { id: 'mod', h: 1 }],
];
const phone: MasonryRowPlace[][] = [[{ id: 'complete' }], [{ id: 'base' }, { id: 'expansion' }], [{ id: 'soundtrack' }, { id: 'remake' }], [{ id: 'mod' }]];
// Requirements: who said it. The official claim in the blue, the measurement in a tint, the
// unknown in the lightest tint.
const needTones = [blue.accent, blue.tint, blue.lightest];
const needs: MasonryItem[] = s.requirements.tiles.map((t, i) => ({ id: `n${i}`, name: t.title, line: t.body, ...needTones[i]! }));
const needColumns: MasonryPlace[][] = [[{ id: 'n0', h: 1 }], [{ id: 'n1', h: 1 }], [{ id: 'n2', h: 1 }]];
const needPhone: MasonryRowPlace[][] = [[{ id: 'n0' }, { id: 'n1' }], [{ id: 'n2' }]];
---
<Opening label={site.name} title={s.hero.headline} lede={s.hero.lead} />

<Section eyebrow={s.filter.label} title={s.filter.headline} lead={s.filter.lead}>
  <ReleaseTable copy={s.filter} example={site.strings.example} />
</Section>

<Section eyebrow={s.states.label} title={s.states.headline} lead={s.states.lead}>
  <FactList items={s.states.items} numbered />
</Section>

<Section eyebrow={s.languages.label} title={s.languages.headline} lead={s.languages.lead}>
  <FactList items={s.languages.items} />
</Section>

<Section eyebrow={s.bundles.label} title={s.bundles.headline} lead={s.bundles.lead}>
  <div slot="wide">
    <TileMasonry items={bundles} columns={columns} phone={phone} height={460} label={s.bundles.headline} />
    <p class="g-cap">{s.bundles.caption}</p>
  </div>
</Section>

<Statement text={s.offers.text} sub={s.offers.more} note={s.offers.note} />

<Section eyebrow={s.requirements.label} title={s.requirements.headline} lead={s.requirements.lead}>
  <TileMasonry slot="wide" items={needs} columns={needColumns} phone={needPhone} height={300} phoneRow={150} label={s.requirements.headline} />
</Section>

<Closing title={s.closing} body={site.strings.closingBody} />
