---
// /games/releases/ (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head with the
// table that binds language and platform to one release (示意), release states, languages as
// flat tiles, the ink band on requirements, bundles, the offers statement, the next page and the
// closing block.
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Band from '../../kit/components/Band.astro';
import Statement from '../../kit/components/Statement.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields } from '../../kit/theme';
import site from '../../content/sites/games';
import ReleaseTable from './ReleaseTable.astro';
import './games.css';

const s = site.strings.releases;
const accent = kindFields.games.field;
const page = site.pages.find((p) => p.slug === 'releases')!;
---
<PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede}>
  <div class="rel-table"><ReleaseTable copy={s.hero} example={site.strings.example} /></div>
</PageHead>

<Sec label="01" title={s.states.headline}>
  <p class="text">{s.states.lede}</p>
  <ItemGrid slot="wide" items={s.states.steps} cols={5} numbered />
</Sec>

<Sec label="02" title={s.languages.headline}>
  <p class="text">{s.languages.body}</p>
  <ItemGrid slot="wide" items={s.languages.items} cols={3} look="cards" />
</Sec>

<Band label={page.label} title={s.requirements.headline} text={s.requirements.lede} items={s.requirements.columns} />

<Sec label="03" title={s.bundles.headline}>
  <p class="text">{s.bundles.lede}</p>
  <ItemGrid slot="wide" items={s.bundles.tiles} cols={3} />
</Sec>

<Statement text={s.offers.statement} note={s.offers.body} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
<Closing bg={accent} />

<style>
  .rel-table { flex: 1 1 100%; margin-top: 24px; min-width: 0; }
</style>
