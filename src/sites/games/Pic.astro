---
// One of the games site's five illustrations (public/images/sites/games/<name>-960|320.avif|webp)
// on the games field, so the square is never empty while it loads.
interface Props {
  name: 'releases' | 'store' | 'library' | 'guides' | 'creators';
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { name, alt, sizes = '(max-width: 767px) 100vw, 50vw', eager = false, class: className } = Astro.props;
const base = `/images/sites/games/${name}`;
---
<picture class:list={['g-pic', className]}>
  <source type="image/avif" srcset={`${base}-320.avif 320w, ${base}-960.avif 960w`} sizes={sizes} />
  <source type="image/webp" srcset={`${base}-320.webp 320w, ${base}-960.webp 960w`} sizes={sizes} />
  <img src={`${base}-960.webp`} alt={alt} width="960" height="960" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</picture>
