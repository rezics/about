---
// Display text set one sentence per line, so a statement never breaks inside a phrase across
// two sentences. The text stays one string in the content file.
interface Props {
  text: string;
}
const { text } = Astro.props;
const lines = text.split(/(?<=。)/).map((s) => s.trim()).filter(Boolean);
---
{lines.map((line) => <span class="g-line">{line}</span>)}
<style>
  .g-line { display: block; }
</style>
