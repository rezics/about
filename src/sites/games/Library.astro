---
// /games/library/ (SITE.md "v3"): the opening with the tray photograph, five statuses, each
// playthrough a save (示意), the takeout statement, one library across kinds, playtime, the
// closing.
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import Table from '../../kit/components/Table.astro';
import TileMasonry, { type MasonryItem, type MasonryPlace, type MasonryRowPlace } from '../../kit/components/TileMasonry.astro';
import Closing from '../../kit/components/Closing.astro';
import site from '../../content/sites/games';
import Opening from './Opening.astro';
import { sectionPicture } from './pictures';
import { kindTile } from './tiles';
import './games.css';

const s = site.strings.library;
const together: MasonryItem[] = s.together.tiles.map((t) => ({ id: t.to, name: t.name, line: t.at, ...kindTile(t.to) }));
const columns: MasonryPlace[][] = [
  [{ id: 'games', h: 1 }],
  [{ id: 'books', h: 3 }, { id: 'manga', h: 2 }],
  [{ id: 'anime', h: 2 }, { id: 'visual-novels', h: 3 }],
];
const phone: MasonryRowPlace[][] = [[{ id: 'games' }], [{ id: 'books' }, { id: 'anime' }], [{ id: 'manga' }, { id: 'visual-novels' }]];
---
<Opening label={site.name} title={s.hero.headline} lede={s.hero.lead} image={sectionPicture('library')} />

<Section eyebrow={s.status.label} title={s.status.headline}>
  <FactList items={s.status.items} />
</Section>

<Section eyebrow={s.slots.label} title={s.slots.headline} lead={s.slots.lead}>
  <Table columns={s.slots.columns} rows={s.slots.rows.map((r) => [r.slot, r.release, r.state])} caption={s.slots.caption} label={s.slots.headline} />
</Section>

<Statement text={s.takeout.text} sub={s.takeout.more} note={s.takeout.note} />

<Section eyebrow={s.together.label} title={s.together.headline} lead={s.together.lead}>
  <div slot="wide">
    <TileMasonry items={together} columns={columns} phone={phone} height={420} label={s.together.headline} />
    <p class="g-cap">{s.together.caption}</p>
  </div>
</Section>

<Section eyebrow={s.playtime.label} title={s.playtime.headline} lead={s.playtime.lead}>
  <FactList items={s.playtime.items} />
  <p class="g-note">{s.playtime.note}</p>
</Section>

<Closing title={s.closing} body={site.strings.closingBody} />
