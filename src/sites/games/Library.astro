---
// /games/library/ (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head, five states,
// every playthrough its own record (示意), one library across kinds as flat tiles in their fields,
// playtime, the ink band on takeout, the next page and the closing block.
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Table from '../../kit/components/Table.astro';
import TileRow from '../../kit/components/TileRow.astro';
import Band from '../../kit/components/Band.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields } from '../../kit/theme';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.library;
const accent = kindFields.games.field;
const page = site.pages.find((p) => p.slug === 'library')!;
const together = s.together.tiles.map((t) => ({ name: t.at, rel: t.name, bg: kindFields[t.to].field, on: kindFields[t.to].on }));
---
<PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

<Sec label="01" title={s.status.headline}>
  <ItemGrid slot="wide" items={s.status.chapters} cols={5} numbered />
</Sec>

<Sec label="02" title={s.slots.headline}>
  <div class="g-stack">
    <p class="text">{s.slots.lede}</p>
    <Table columns={s.slots.columns} rows={s.slots.rows.map((r) => [r.slot, r.release, r.state])} caption={s.slots.caption} label={s.slots.headline} />
  </div>
</Sec>

<Sec label="03" title={s.together.headline}>
  <p class="text">{s.together.lede}</p>
  <div slot="wide" class="g-stack">
    <TileRow items={together} cols={5} height={180} label={s.together.headline} />
    <p class="g-cap">{s.together.caption}</p>
    <p class="text g-lists">{s.together.lists}</p>
  </div>
</Sec>

<Sec label="04" title={s.playtime.headline}>
  <div class="g-stack">
    <p class="text">{s.playtime.lede}</p>
    <p class="g-cap">{s.playtime.note}</p>
  </div>
  <ItemGrid slot="wide" items={s.playtime.facts} cols={4} look="cards" />
</Sec>

<Band label={page.label} title={s.takeout.statement} text={s.takeout.body} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
<Closing bg={accent} />

<style>
  .g-lists { max-width: 46em; }
</style>
