---
// /games/creators/ (SITE.md "v3"): the opening with the standing fold, rights, the statement
// ledger (labels only), the statement on listing honestly, one name across kinds, a Realm and
// a Zone, the closing.
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import TileMasonry, { type MasonryItem } from '../../kit/components/TileMasonry.astro';
import Closing from '../../kit/components/Closing.astro';
import site from '../../content/sites/games';
import Opening from './Opening.astro';
import Ledger from './Ledger.astro';
import { sectionPicture } from './pictures';
import { blue, kindTile } from './tiles';
import './games.css';

const s = site.strings.creators;
const works: MasonryItem[] = s.name.tiles.map((t, i) => ({ id: `w${i}`, name: t.name, line: t.role, ...(t.to ? kindTile(t.to) : blue.lightest) }));
const columns = works.map((w) => [{ id: w.id, h: 1 }]);
const phone = [[{ id: 'w0' }, { id: 'w1' }], [{ id: 'w2' }, { id: 'w3' }]];
---
<Opening label={site.name} title={s.hero.headline} lede={s.hero.lead} image={sectionPicture('creators')} />

<Section eyebrow={s.rights.label} title={s.rights.headline}>
  <FactList items={s.rights.items} />
</Section>

<Section eyebrow={s.ledger.label} title={s.ledger.headline}>
  <Ledger rows={s.ledger.rows} label={s.ledger.headline} />
  <p class="g-note">{s.ledger.note}</p>
  <p class="g-note">{s.ledger.reserve}</p>
  <p class="g-cap">{s.ledger.caption}</p>
</Section>

<Statement text={s.rules.text} sub={s.rules.more} note={s.rules.note} />

<Section eyebrow={s.name.label} title={s.name.headline} lead={s.name.lead}>
  <div slot="wide">
    <TileMasonry items={works} columns={columns} phone={phone} height={260} phoneRow={130} label={s.name.headline} />
    <p class="g-cap">{s.name.caption}</p>
  </div>
</Section>

<Section eyebrow={s.home.label} title={s.home.headline} lead={s.home.lead}>
  <FactList items={s.home.items} />
</Section>

<Closing title={s.closing} />
