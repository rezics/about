---
// /games/creators/ (DESIGN.md "Direction v2"): the intro beside the studio desk, what you keep and
// what you license, the statement line by line, one name across everything you make, a home for
// the game after release, the rules statement, and the next site.
import PageIntro from '../../kit/components/PageIntro.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import ItemList from '../../kit/components/ItemList.astro';
import Statement from '../../kit/components/Statement.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import { kindFields } from '../../kit/theme';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.creators;
---
<PageIntro title={s.hero.headline} lede={s.hero.lede} image={{ base: '/images/sites/games/creators', alt: s.hero.imageAlt, ratio: 1 }} />

<ItemList title={s.rights.headline} items={s.rights.rows} />

<section class="g-sec" aria-labelledby="ledger-title">
  <div class="container g-two">
    <div class="g-stack">
      <SectionHead id="ledger-title" title={s.ledger.headline} lede={s.ledger.note} />
      <p class="g-cap">{s.ledger.reserve}</p>
    </div>
    <div class="g-panel" data-reveal="up">
      <ol class="cr-ledger" role="list">
        {s.ledger.rows.map((r) => (
          <li class:list={['cr-row', r.total && 'cr-row--total']}>
            <span class="cr-op label">{r.op ?? ''}</span>
            <span class="cr-label">{r.label}</span>
          </li>
        ))}
      </ol>
      <p class="g-cap">{s.ledger.caption}</p>
    </div>
  </div>
</section>

<section class="g-sec" aria-labelledby="name-title">
  <div class="container g-stack">
    <SectionHead id="name-title" title={s.name.headline} lede={s.name.lede} />
    <ul class="cr-tiles" role="list" data-reveal="slot">
      {s.name.tiles.map((t) => (
        <li class="cr-tile" style={`--dot:${t.to ? kindFields[t.to].field : 'var(--c-muted)'}`}>
          <span class="cr-tile__dot" aria-hidden="true"></span>
          <span class="cr-tile__name">{t.name}</span>
          <span class="cr-tile__role">{t.role}</span>
        </li>
      ))}
    </ul>
    <p class="g-cap">{s.name.caption}</p>
  </div>
</section>

<section class="g-sec" aria-labelledby="home-title">
  <div class="container g-stack">
    <SectionHead id="home-title" title={s.home.headline} lede={s.home.body} />
    <ItemGrid items={s.home.items} cols={2} look="cards" />
  </div>
</section>

<Statement text={s.rules.statement} sub={s.rules.body} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />

<style>
  .cr-ledger { display: flex; flex-direction: column; }
  .cr-row { display: grid; grid-template-columns: 3.5em minmax(0, 1fr); align-items: baseline; gap: 12px; padding-block: 12px; border-top: 1px solid var(--c-line); }
  .cr-row:first-child { border-top: 0; }
  .cr-row--total { border-top: 1.5px solid var(--c-fg); font-weight: 500; }
  .cr-op { color: var(--c-muted); }
  .cr-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .cr-tile { display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: var(--r-card); background: var(--c-surface); border: 1px solid var(--c-line); box-shadow: var(--shadow-card); }
  .cr-tile__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--dot); margin-bottom: 6px; }
  .cr-tile__name { font-size: var(--t-h3); font-weight: 500; }
  .cr-tile__role { color: var(--c-muted); font-size: var(--t-s); }
  @media (max-width: 767px) { .cr-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
