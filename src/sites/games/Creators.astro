---
// /games/creators/ (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head, what you keep
// and what you license, the statement line by line, one name across everything you make as flat
// tiles, a home for the game after release, the ink band on the rules, the next site and the
// closing block.
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import ItemList from '../../kit/components/ItemList.astro';
import TileRow from '../../kit/components/TileRow.astro';
import Band from '../../kit/components/Band.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields, palette } from '../../kit/theme';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.creators;
const accent = kindFields.games.field;
const page = site.pages.find((p) => p.slug === 'creators')!;
const names = s.name.tiles.map((t) => ({ name: t.name, line: t.role, bg: t.to ? kindFields[t.to].field : palette.ink, on: t.to ? kindFields[t.to].on : ('paper' as const) }));
---
<PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

<ItemList label="01" title={s.rights.headline} items={s.rights.rows} />

<Sec label="02" title={s.ledger.headline}>
  <div class="g-stack">
    <p class="text">{s.ledger.note}</p>
    <ol class="cr-ledger" role="list">
      {s.ledger.rows.map((r) => (
        <li class:list={['cr-row', r.total && 'cr-row--total']}>
          <span class="cr-op label">{r.op ?? ''}</span>
          <span>{r.label}</span>
        </li>
      ))}
    </ol>
    <p class="g-cap">{s.ledger.reserve}</p>
    <p class="g-cap">{s.ledger.caption}</p>
  </div>
</Sec>

<Sec label="03" title={s.name.headline}>
  <p class="text">{s.name.lede}</p>
  <div slot="wide" class="g-stack">
    <TileRow items={names} cols={4} height={200} label={s.name.headline} />
    <p class="g-cap">{s.name.caption}</p>
  </div>
</Sec>

<Sec label="04" title={s.home.headline}>
  <p class="text">{s.home.body}</p>
  <ItemGrid slot="wide" items={s.home.items} cols={2} look="cards" />
</Sec>

<Band label={page.label} title={s.rules.statement} text={s.rules.body} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
<Closing bg={accent} />

<style>
  .cr-ledger { border-top: 1px solid var(--c-line); }
  .cr-row { display: grid; grid-template-columns: 4em minmax(0, 1fr); align-items: baseline; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--c-line); }
  .cr-row--total { border-top: 1.5px solid var(--c-fg); font-weight: 600; }
</style>
