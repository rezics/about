---
/**
 * 開箱, the games site's signature (SITE.md "Signature moment"). The 版本 part opens into an
 * inventory of one fictional game's releases; a red cursor steps from slot to slot and the
 * description box shows the selected release.
 *
 * Phone first: on a phone the inventory is one horizontal scroll-snap row of slots with the
 * description under it; from 768 px it is a 4 × 3 inventory with the description beside it.
 * Without script it is a radio group: arrow keys move the selection natively and CSS
 * (:has(:checked)) shows the matching description. The driver (inventory.ts) adds the opening,
 * the stepping cursor, the scroll mapping on desktop and the idle stepping.
 */
import { partById, site as shared } from '../../kit/content';
import { kindFields, fieldStyle } from '../../kit/theme';
import type { GamesStrings } from '../../content/sites/games';
import type { PartId } from '../../content/schema';

interface Props {
  copy: GamesStrings['landing']['inventory'];
  parts: PartId[];
}
const { copy, parts } = Astro.props;
const SLOTS = 12;
const empties = SLOTS - copy.items.length;
// One rule per item: show its description when its radio is checked (works without script).
const css = copy.items
  .map((it) => `.inv:has(input[value='${it.id}']:checked) .inv__d[data-for='${it.id}']{display:block}`)
  .join('');
---
<section class="inv band-field" data-inventory aria-labelledby="inv-title" style={fieldStyle(kindFields.games)}>
  <style is:inline set:html={css}></style>
  <div class="inv__stage grid" data-inv-stage>
    <div class="inv__aside">
      <h2 id="inv-title" class="t-l" data-split="lines">{copy.headline}</h2>
      <p class="inv__lede">{copy.lede}</p>
      <ul class="inv__parts g-parts" role="list" aria-hidden="true">
        {parts.map((p) => (
          <li class:list={['g-part', p === 'editions' && 'inv__source']} data-inv-source={p === 'editions' ? '' : undefined}>{partById(p).name}</li>
        ))}
      </ul>
    </div>

    <fieldset class="inv__grid" data-inv-grid>
      <legend class="sr-only">{copy.headline}</legend>
      <div class="inv__slots" aria-hidden="true" data-inv-slots>
        {Array.from({ length: SLOTS }, () => <span class="inv__slot"></span>)}
      </div>
      <div class="inv__cells" data-inv-cells>
        {copy.items.map((it, i) => (
          <label class="inv__cell" data-inv-item>
            <input class="inv__radio" type="radio" name="inv-release" value={it.id} checked={i === 0} aria-describedby={`inv-d-${it.id}`} />
            <span class="inv__label"><span>{it.label[0]}</span><span>{it.label[1]}</span></span>
          </label>
        ))}
        {Array.from({ length: empties }, () => <span class="inv__cell inv__cell--empty" aria-hidden="true"></span>)}
        <span class="g-cursor inv__cursor" aria-hidden="true" data-inv-cursor></span>
      </div>
    </fieldset>

    <div class="inv__desc">
      <p class="inv__desc-head mono">{copy.descHeading}</p>
      {copy.items.map((it) => (
        <div class="inv__d" id={`inv-d-${it.id}`} data-for={it.id}>
          <p class="inv__d-title t-m">{it.label[0]}，{it.label[1]}</p>
          <p class="inv__d-body">{it.body}</p>
        </div>
      ))}
    </div>

    <div class="inv__foot">
      <p class="inv__caption mono">{copy.caption}</p>
      <button class="inv__toggle link-draw" type="button" data-inv-toggle data-pause={shared.ui.pause} data-play={shared.ui.play} hidden>
        {shared.ui.pause}
      </button>
    </div>
  </div>
</section>

<style>
  .inv { position: relative; padding-block: 64px; --c-line: rgb(244 245 242 / 0.22); --c-line-strong: rgb(244 245 242 / 0.5); --c-bg: var(--field); }
  .inv__stage { row-gap: 24px; align-content: center; }
  .inv__aside, .inv__grid, .inv__desc, .inv__foot { grid-column: 1 / -1; }
  .inv__aside { display: flex; flex-direction: column; gap: 18px; }
  .inv__lede { line-height: var(--lh-text); max-width: var(--measure); }
  .inv__parts .g-part { min-height: 32px; padding: 5px 10px; }
  .inv__source { background: var(--c-paper); color: var(--g-field); border-color: var(--c-paper); }
  .inv__grid { position: relative; border: 0; padding: 0; margin: 0; min-width: 0; }

  /* Phone: one row of slots that scrolls sideways and snaps. */
  .inv__slots { display: none; }
  .inv__cells {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 38%;
    gap: 6px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding: 4px var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .inv__cell { position: relative; aspect-ratio: 1; display: block; container-type: inline-size; cursor: pointer; scroll-snap-align: start; }
  .inv__cell:not(.inv__cell--empty) {
    background: rgb(14 20 32 / 0.2);
    border: 1px solid var(--c-line-strong);
    box-shadow: inset 0 0 0 4px var(--g-field), inset 0 0 0 5px var(--c-line);
  }
  .inv__cell--empty { border: 1px dashed var(--c-line-strong); }
  .inv__cell--empty ~ .inv__cell--empty { display: none; }
  .inv__radio { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .inv__label {
    position: absolute;
    inset: auto 9cqi 9cqi 9cqi;
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    font-weight: 700;
    font-size: clamp(0.8125rem, 13cqi, 1.25rem);
    line-height: 1.2;
    pointer-events: none;
    transition: opacity var(--d-s) var(--ease-snap);
  }
  .inv__label > span:last-child { font-weight: 400; opacity: 0.86; }
  .inv__cell.is-moving .inv__label { opacity: 0; }
  .inv__cell:has(:focus-visible) { outline: 2px solid var(--c-paper); outline-offset: 3px; }
  /* Without the driver the checked cell carries the cursor itself. */
  .inv__cursor { display: none; }
  .inv:not(.is-live) .inv__cell:has(:checked)::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 3px solid var(--c-mark);
    box-shadow: 0 0 0 1px var(--c-paper), inset 0 0 0 1px var(--c-paper);
    pointer-events: none;
  }
  .inv.is-live .inv__cursor { display: block; }
  @media (hover: hover) {
    .inv__cell:not(.inv__cell--empty):hover { background: rgb(14 20 32 / 0.34); }
  }

  /* The description box: paper on the field. */
  .inv__desc { background: var(--c-paper); color: var(--c-ink); padding: 18px; min-height: 196px; --c-muted: #566070; }
  .inv__desc-head { color: var(--c-muted); margin-bottom: 12px; }
  .inv__d { display: none; }
  .inv__d-title { margin-bottom: 8px; }
  .inv__d-body { line-height: var(--lh-text); }
  .inv__foot { display: flex; flex-direction: column; gap: 4px; }
  .inv__caption { color: var(--c-paper); opacity: 0.9; }
  .inv__toggle { color: var(--c-paper); font-size: var(--t-s); min-height: 44px; align-self: flex-start; }

  /* From 768 px: the 4 × 3 inventory with its slot frames. */
  @media (min-width: 768px) {
    .inv { padding-block: var(--space-normal); }
    .inv__grid { grid-column: 1 / span 8; }
    .inv__desc { grid-column: 9 / span 4; align-self: start; min-height: 240px; padding: 20px; }
    .inv__foot { flex-direction: row; justify-content: space-between; align-items: baseline; gap: 16px; }
    .inv__slots, .inv__cells { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: row; grid-auto-columns: auto; gap: 6px; }
    .inv__slots { position: absolute; inset: 0; }
    .inv__slot { border: 1px dashed var(--c-line-strong); }
    .inv__cells { overflow: visible; margin: 0; padding: 0; scroll-snap-type: none; }
    .inv__cell--empty { visibility: hidden; }
    .inv__cell--empty ~ .inv__cell--empty { display: block; }
  }
  @media (min-width: 1024px) {
    .inv__aside { grid-column: 1 / span 4; }
    .inv__grid { grid-column: 5 / span 5; }
    .inv__desc { grid-column: 10 / span 3; }
    .inv__foot { grid-column: 5 / span 8; }
  }

  /* Desktop with motion: the stage pins while the section scrolls (the driver adds .is-pinned). */
  .inv.is-pinned { height: 280svh; padding-block: 0; }
  .inv.is-pinned .inv__stage {
    position: sticky;
    top: calc(var(--header-h) + var(--bar-h));
    height: calc(100svh - var(--header-h) - var(--bar-h));
    padding-block: 32px;
  }
  .inv.is-pinned .inv__grid { justify-self: start; width: 100%; max-width: calc((100svh - var(--header-h) - var(--bar-h) - 140px) * 4 / 3); }
</style>

<script>
  import { startInventory } from './inventory';
  startInventory();
</script>
