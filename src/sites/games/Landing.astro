---
// /games/ (DESIGN.md "Direction v2": Swiss grid, flat tiles): the hero with the wall of the site's
// own pages, the nine example releases as flat tiles (示意), the statement, the ink band on the
// store, the eight parts, the neighbouring kinds, the next page and the closing block.
import HeroWall from '../../kit/components/HeroWall.astro';
import Sec from '../../kit/components/Sec.astro';
import TileRow from '../../kit/components/TileRow.astro';
import Statement from '../../kit/components/Statement.astro';
import Band from '../../kit/components/Band.astro';
import PartsList from '../../kit/components/PartsList.astro';
import ProductCall from '../../kit/components/ProductCall.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindById, kindHref } from '../../kit/content';
import { kindFields } from '../../kit/theme';
import { accentRamp } from '../../kit/color';
import { pageWall } from '../../kit/pageWall';
import { pageHref } from '../../kit/sites';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.landing;
const L = s.labels;
const kind = kindById('games');
const accent = kindFields.games.field;
const pageBy = (slug: string) => site.pages.find((p) => p.slug === slug)!;
const wall = pageWall(site, accent, s.pages.rows);
const ramp = accentRamp(accent);
const releases = s.releases.items.map((it, i) => ({ name: it.label[1], rel: it.label[0], line: it.body, ...ramp[[0, 1, 2, 3, 4, 5, 0, 3, 2][i] ?? 0]! }));
const neighbours = s.connections.squares.map((c) => ({
  name: kindById(c.to).name,
  tag: kindById(c.to).tag,
  line: c.body,
  href: kindHref(c.to),
  bg: kindFields[c.to].field,
  on: kindFields[c.to].on,
}));
---
<HeroWall label={site.name} title={s.hero.headline} lede={s.hero.lede} items={wall.items} wide={wall.wide} phone={wall.phone} phoneHeight={860} bar>
  <ProductCall />
  <a class="link-draw" href={pageHref(site, pageBy('releases'))}>{s.hero.secondary}</a>
</HeroWall>

<Sec label={L.releases} title={s.releases.headline} link={{ href: pageHref(site, pageBy('releases')), text: s.releases.link }}>
  <p class="text">{s.releases.lede}</p>
  <div slot="wide" class="g-stack">
    <TileRow items={releases} cols={3} height={230} phoneHeight={200} label={s.releases.caption} class="g-releases" />
    <p class="g-cap">{s.releases.caption}</p>
  </div>
</Sec>

<Statement text={s.specifics.statement} note={s.specifics.body} />

<Band label={L.store} title={s.store.headline} text={s.store.body.join('')}>
  <p class="g-band-links">
    <a class="link-draw" href={pageHref(site, pageBy('store'))}>{s.store.links[0]}</a>
    <a class="link-draw" href={pageHref(site, pageBy('creators'))}>{s.store.links[1]}</a>
  </p>
</Band>

<Sec label={L.parts} title={s.parts.headline}>
  <div class="g-stack">
    <p class="text">{s.parts.lede}</p>
    <PartsList parts={kind.parts} notes={s.parts.notes} level="h3" />
    <p class="g-cap">{s.parts.caption}</p>
  </div>
</Sec>

<Sec label={L.connections} title={s.connections.headline}>
  <p class="text">{s.connections.lede}</p>
  <TileRow slot="wide" items={neighbours} cols={5} label={s.connections.headline} />
</Sec>

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
<Closing bg={accent} />

<style>
  .g-band-links { grid-column: 8 / 13; margin-top: 28px; display: flex; flex-wrap: wrap; gap: 16px 28px; }
  @media (max-width: 767px) { :global(.g-releases) { grid-template-columns: minmax(0, 1fr) !important; } }
</style>
