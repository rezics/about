---
// /games/ (SITE.md "v3"): the photograph hero, releases recorded apart, the statement, the site's
// six pages, the store beside its photograph, the five neighbouring kinds, the closing.
import PhotoHero from '../../kit/components/PhotoHero.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import PhotoRow from '../../kit/components/PhotoRow.astro';
import TileMasonry, { type MasonryItem, type MasonryPlace, type MasonryRowPlace } from '../../kit/components/TileMasonry.astro';
import ProductCall from '../../kit/components/ProductCall.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindById, kindHref } from '../../kit/content';
import { pageHref } from '../../kit/sites';
import site from '../../content/sites/games';
import { heroPicture, sectionPicture } from './pictures';
import { blue, kindTile } from './tiles';
import './games.css';

const s = site.strings.landing;
const page = (slug: string) => site.pages.find((p) => p.slug === slug)!;
const href = (slug: string) => pageHref(site, page(slug));

// The six pages in the games blue: the two most used pages carry the deepest tone and the tallest tiles.
const tones: Record<string, { bg: string; on: 'paper' | 'ink' }> = {
  releases: blue.accent,
  store: blue.deep,
  library: blue.tint,
  reviews: blue.light,
  guides: blue.deeper,
  creators: blue.lightest,
};
const pages: MasonryItem[] = Object.keys(tones).map((slug) => ({
  id: slug,
  name: page(slug).label,
  line: s.pages.lines[slug],
  href: href(slug),
  ...tones[slug]!,
}));
const pageColumns: MasonryPlace[][] = [
  [{ id: 'releases', h: 5 }, { id: 'reviews', h: 3 }],
  [{ id: 'store', h: 4 }, { id: 'guides', h: 4 }],
  [{ id: 'library', h: 3 }, { id: 'creators', h: 5 }],
];
const pagePhone: MasonryRowPlace[][] = [
  [{ id: 'releases' }, { id: 'store' }],
  [{ id: 'library' }, { id: 'reviews' }],
  [{ id: 'guides' }, { id: 'creators' }],
];

const kinds: MasonryItem[] = s.connections.tiles.map((t) => ({
  id: t.to,
  name: kindById(t.to).name,
  line: t.line,
  href: kindHref(t.to),
  ...kindTile(t.to),
}));
const kindColumns: MasonryPlace[][] = [
  [{ id: 'visual-novels', h: 1 }],
  [{ id: 'books', h: 3 }, { id: 'manga', h: 2 }],
  [{ id: 'anime', h: 3 }, { id: 'software', h: 2 }],
];
const kindPhone: MasonryRowPlace[][] = [[{ id: 'visual-novels' }], [{ id: 'books' }, { id: 'anime' }], [{ id: 'manga' }, { id: 'software' }]];
---
<PhotoHero class="g-hero" copyMax="min(470px, calc(36vw - var(--gutter)))" eyebrow={site.name} title={s.hero.headline} lede={s.hero.lede} image={heroPicture} bar>
  <ProductCall />
</PhotoHero>

<Section eyebrow={s.releases.label} title={s.releases.headline} lead={s.releases.lead} link={{ href: href('releases'), text: s.releases.link }}>
  <FactList items={s.releases.items} />
  <p class="g-cap">{s.releases.caption}</p>
</Section>

<Statement text={s.versions.text} sub={s.versions.more} note={s.versions.note} />

<Section eyebrow={s.pages.label} title={s.pages.headline}>
  <TileMasonry slot="wide" items={pages} columns={pageColumns} phone={pagePhone} height={520} label={s.pages.headline} />
</Section>

<PhotoRow
  side="right"
  eyebrow={s.store.label}
  title={s.store.headline}
  body={s.store.lead}
  link={{ href: href('store'), text: s.store.link }}
  image={sectionPicture('store')}
/>

<Section eyebrow={s.connections.label} title={s.connections.headline} lead={s.connections.lead}>
  <TileMasonry slot="wide" items={kinds} columns={kindColumns} phone={kindPhone} height={420} label={s.connections.headline} />
</Section>

<Closing title={s.closing} body={site.strings.closingBody} />
