---
// /games/guides/ (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head, the Wiki+
// that follows your progress (示意), guides pinned to versions, the rules of Wiki+, adaptations as
// flat tiles in their fields (示意), the ink band on Zones, the next page and the closing block.
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import ItemList from '../../kit/components/ItemList.astro';
import TileRow from '../../kit/components/TileRow.astro';
import Band from '../../kit/components/Band.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields } from '../../kit/theme';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.guides;
const accent = kindFields.games.field;
const page = site.pages.find((p) => p.slug === 'guides')!;
const chain = s.adaptations.chain.map((c) => ({ name: c.name, rel: c.relation ?? '原作', line: c.body, bg: kindFields[c.to].field, on: kindFields[c.to].on }));
---
<PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

<Sec label="01" title={s.fog.headline}>
  <p class="text">{s.fog.lede}</p>
  <div slot="wide" class="g-stack">
    <div class="gd-groups">
      {s.fog.groups.map((g) => (
        <div class="gd-group">
          <h3 class="gd-title">{g.title}</h3>
          <ul role="list" class="gd-list">
            {g.cells.map((c) => (
              <li><span>{c.name}</span><span class="label">{s.fog.from.replace('{n}', String(c.from))}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="g-cap">{s.fog.caption}</p>
  </div>
</Sec>

<Sec label="02" title={s.guides.headline}>
  <p class="text">{s.guides.body}</p>
  <ItemGrid slot="wide" items={s.guides.items} cols={2} />
</Sec>

<ItemList label="03" title={s.rules.headline} items={s.rules.rows} />

<Sec label="04" title={s.adaptations.headline}>
  <div class="g-stack">
    <p class="text">{s.adaptations.lede}</p>
    <p class="g-cap">{s.adaptations.note}</p>
  </div>
  <div slot="wide" class="g-stack">
    <TileRow items={chain} cols={5} height={240} label={s.adaptations.headline} />
    <p class="g-cap">{s.adaptations.caption}</p>
  </div>
</Sec>

<Band label={page.label} title={s.zone.statement} text={s.zone.body} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />
<Closing bg={accent} />

<style>
  .gd-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px var(--gutter); }
  .gd-title { font-size: 18px; font-weight: 600; padding-bottom: 12px; }
  .gd-list { border-top: 1px solid var(--c-line); }
  .gd-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--c-line); }
  @media (max-width: 767px) { .gd-groups { grid-template-columns: minmax(0, 1fr); } }
</style>
