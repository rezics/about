---
// /games/guides/ (SITE.md "v3"): the opening, the folded strip beside the spoiler rule, guides
// for a version, the five Wiki+ rules, the statement on a game's own Zone, the approved
// example's adaptations, the closing.
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import PhotoRow from '../../kit/components/PhotoRow.astro';
import TileMasonry, { type MasonryItem, type MasonryRowPlace } from '../../kit/components/TileMasonry.astro';
import Closing from '../../kit/components/Closing.astro';
import site from '../../content/sites/games';
import Opening from './Opening.astro';
import { sectionPicture } from './pictures';
import { kindTile } from './tiles';
import './games.css';

const s = site.strings.guides;
const fogPicture = sectionPicture('guides');
const chain: MasonryItem[] = s.adaptations.chain.map((c, i) => ({ id: `a${i}`, name: c.name, line: c.line, rel: c.rel, ...kindTile(c.to) }));
const columns = chain.map((c) => [{ id: c.id, h: 1 }]);
const phone: MasonryRowPlace[][] = [[{ id: 'a0' }, { id: 'a1' }], [{ id: 'a2' }, { id: 'a3' }], [{ id: 'a4' }]];
---
{/* PhotoRow does not expose Picture.priority. This body-allowed preload starts the
    phone's first visible photograph before lazy-image discovery after font layout. */}
<link rel="preload" as="image" type="image/avif" href={`${fogPicture.phone.src}-640.avif`} media="(max-width: 767px)" fetchpriority="high" />
<Opening label={site.name} title={s.hero.headline} lede={s.hero.lead} />

<PhotoRow side="left" eyebrow={s.fog.label} title={s.fog.headline} body={s.fog.lead} image={fogPicture} />

<Section eyebrow={s.guides.label} title={s.guides.headline} lead={[s.guides.lead, s.guides.more]} />

<Section eyebrow={s.rules.label} title={s.rules.headline}>
  <FactList items={s.rules.items} />
</Section>

<Statement text={s.zone.text} sub={s.zone.more} note={s.zone.note} />

<Section eyebrow={s.adaptations.label} title={s.adaptations.headline} lead={[s.adaptations.lead, s.adaptations.note]}>
  <div slot="wide">
    <TileMasonry items={chain} columns={columns} phone={phone} height={280} phoneRow={164} label={s.adaptations.caption} />
    <p class="g-cap">{s.adaptations.caption}</p>
  </div>
</Section>

<Closing title={s.closing} body={site.strings.closingBody} />
