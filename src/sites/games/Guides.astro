---
// /games/guides/ (DESIGN.md "Direction v2"): the intro beside the map, the Wiki+ that follows
// your progress (示意), guides pinned to versions, the rules of Wiki+, adaptations (示意), the
// Zone statement, and the next page.
import PageIntro from '../../kit/components/PageIntro.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import ItemList from '../../kit/components/ItemList.astro';
import Statement from '../../kit/components/Statement.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import { kindFields } from '../../kit/theme';
import site from '../../content/sites/games';
import './games.css';

const s = site.strings.guides;
---
<PageIntro title={s.hero.headline} lede={s.hero.lede} image={{ base: '/images/sites/games/guides', alt: s.guides.imageAlt, ratio: 1 }} />

<section class="g-sec" aria-labelledby="fog-title">
  <div class="container g-stack">
    <SectionHead id="fog-title" title={s.fog.headline} lede={s.fog.lede} />
    <div class="gd-groups" data-reveal="slot">
      {s.fog.groups.map((g) => (
        <div class="g-panel gd-group">
          <h3 class="t-h3">{g.title}</h3>
          <ul role="list" class="gd-list">
            {g.cells.map((c) => (
              <li><span>{c.name}</span><span class="label gd-from">{s.fog.from.replace('{n}', String(c.from))}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="g-cap">{s.fog.caption}</p>
  </div>
</section>

<section class="g-sec" aria-labelledby="guides-title">
  <div class="container g-stack">
    <SectionHead id="guides-title" title={s.guides.headline} lede={s.guides.body} />
    <ItemGrid items={s.guides.items} cols={2} />
  </div>
</section>

<ItemList title={s.rules.headline} items={s.rules.rows} />

<section class="g-sec" aria-labelledby="adapt-title">
  <div class="container g-stack">
    <SectionHead id="adapt-title" title={s.adaptations.headline} lede={s.adaptations.lede} />
    <ol class="gd-chain" role="list" data-reveal="slot">
      {s.adaptations.chain.map((c) => (
        <li class="gd-link" style={`--dot:${kindFields[c.to].field}`}>
          {c.relation ? <span class="label gd-rel">{c.relation}</span> : <span class="label gd-rel gd-rel--none" aria-hidden="true">·</span>}
          <span class="gd-name"><span class="gd-dot" aria-hidden="true"></span>{c.name}</span>
          <span class="gd-body">{c.body}</span>
        </li>
      ))}
    </ol>
    <p class="g-note">{s.adaptations.note}</p>
    <p class="g-cap">{s.adaptations.caption}</p>
  </div>
</section>

<Statement text={s.zone.statement} sub={s.zone.body} />

<SiteFinale nextPage={site.strings.finale.nextPage} nextSite={site.strings.finale.nextSite} />

<style>
  .gd-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .gd-list { display: flex; flex-direction: column; }
  .gd-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-block: 12px; border-top: 1px solid var(--c-line); }
  .gd-from { color: var(--c-muted); white-space: nowrap; }
  .gd-chain { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .gd-link { display: flex; flex-direction: column; gap: 8px; padding: 20px; border-radius: var(--r-card); background: var(--c-surface); border: 1px solid var(--c-line); box-shadow: var(--shadow-card); }
  .gd-rel { color: var(--c-muted); }
  .gd-rel--none { visibility: hidden; }
  .gd-name { display: flex; align-items: center; gap: 8px; font-size: var(--t-h3); font-weight: 500; }
  .gd-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--dot); flex: none; }
  .gd-body { color: var(--c-muted); font-size: var(--t-s); line-height: 1.7; }
  @media (max-width: 1023px) {
    .gd-groups { grid-template-columns: minmax(0, 1fr); }
    .gd-chain { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) { .gd-chain { grid-template-columns: minmax(0, 1fr); } }
</style>
