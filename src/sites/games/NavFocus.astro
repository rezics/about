---
// Keep the current chapter visible after keyboard focus traverses the scrolling site bar.
// The kit handles initial navigation; this fills the focus-out case within games only.
---
<script>
  import { onPage } from '../../engine';

  onPage(() => {
    if (document.body.dataset.site !== 'games') return;
    const bar = document.querySelector<HTMLElement>('[data-sitebar]');
    const tabs = bar?.querySelector<HTMLElement>('.sitebar__tabs');
    if (!bar || !tabs) return;

    const restoreCurrent = () => queueMicrotask(() => {
      if (!tabs.isConnected || bar.contains(document.activeElement) || !matchMedia('(max-width: 767px)').matches) return;
      const current = tabs.querySelector<HTMLElement>('[aria-current="page"]');
      if (!current) return;
      const left = current.getBoundingClientRect().left - tabs.getBoundingClientRect().left + tabs.scrollLeft;
      tabs.scrollTo({ left, behavior: 'auto' });
    });
    bar.addEventListener('focusout', restoreCurrent);
    return () => bar.removeEventListener('focusout', restoreCurrent);
  });
</script>
