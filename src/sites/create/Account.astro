---
/**
 * The statement of account (創作與發行, section 結算): the lines a creator's statement carries and
 * what fills each, never amounts or shares. The kit's fact-list form (hairlines, the line's name
 * in the serif on the left, what fills it on the right); the three deductions sit under a small
 * 扣除 label and step in, and net receipts stand under a stronger rule.
 */
interface Row {
  label: string;
  detail: string;
  kind: 'paid' | 'deduct' | 'net' | 'share';
}
interface Props {
  rows: Row[];
  deduct: string;
  caption: string;
  label: string;
}
const { rows, deduct, caption, label } = Astro.props;
const firstDeduct = rows.findIndex((r) => r.kind === 'deduct');
---
<figure class="account">
  <ul class="account__rows" role="list" aria-label={label}>
    {rows.map((r, i) => (
      <li class:list={['account__row', `account__row--${r.kind}`]}>
        <p class="account__label serif">
          {i === firstDeduct && <span class="account__group eyebrow">{deduct}</span>}
          {r.label}
        </p>
        <p class="account__detail">{r.detail}</p>
      </li>
    ))}
  </ul>
  <figcaption class="account__cap">{caption}</figcaption>
</figure>
<style>
  .account__rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--c-line); }
  .account__row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 5fr); gap: 8px var(--gutter); padding: 24px 0 26px; border-bottom: 1px solid var(--c-line); }
  .account__label { font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem); line-height: 1.55; }
  .account__group { display: block; margin-bottom: 6px; }
  .account__row--deduct .account__label { padding-left: 1.5em; font-weight: 500; color: var(--c-text); }
  .account__row--net { border-top: 1px solid var(--c-fg); margin-top: -1px; }
  .account__detail { font-size: 16px; line-height: 1.9; color: var(--c-text); align-self: end; }
  .account__cap { margin-top: 20px; max-width: 34em; font-size: var(--t-xs); line-height: 1.8; color: var(--c-muted); }
  @media (max-width: 767px) {
    .account__row { grid-template-columns: minmax(0, 1fr); padding: 20px 0 22px; }
    .account__detail { align-self: auto; }
  }
</style>
