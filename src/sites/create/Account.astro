---
/**
 * The statement of account (創作與發行, section 結算): the lines a creator's statement carries and
 * what fills each, never amounts or shares. The kit's fact-row form (hairlines, the line's name
 * in the serif, what fills it beside it): the three deductions sit under their own 扣除 header
 * and step in, net receipts stand under an ink rule. Name and text stay side by side on phones
 * too, so the statement still reads as one sum.
 */
interface Row {
  label: string;
  detail: string;
  kind: 'paid' | 'deduct' | 'net' | 'share';
}
interface Props {
  rows: Row[];
  deduct: string;
  caption: string;
  label: string;
}
const { rows, deduct, caption, label } = Astro.props;
const firstDeduct = rows.findIndex((r) => r.kind === 'deduct');
---
<figure class="account">
  <ul class="account__rows" role="list" aria-label={label}>
    {rows.map((r, i) => (
      <>
        {i === firstDeduct && <li class="account__group" aria-hidden="true"><span class="eyebrow">{deduct}</span></li>}
        <li class:list={['account__row', `account__row--${r.kind}`]}>
          <p class="account__label serif">{r.kind === 'deduct' && <span class="sr-only">{deduct}：</span>}{r.label}</p>
          <p class="account__detail">{r.detail}</p>
        </li>
      </>
    ))}
  </ul>
  <figcaption><p class="account__cap phrase">{caption}</p></figcaption>
</figure>
<style>
  .account__rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--c-line); }
  .account__row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 5fr); gap: 8px var(--gutter); align-items: baseline; padding: 24px 0 26px; border-bottom: 1px solid var(--c-line); }
  .account__group { padding: 22px 0 0; }
  .account__label { font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem); line-height: 1.55; }
  .account__row--deduct { padding-left: 1.5em; }
  .account__row--deduct .account__label { font-weight: 500; color: var(--c-text); }
  .account__row--net { border-top: 1px solid var(--c-fg); margin-top: -1px; }
  .account__detail { font-size: 16px; line-height: 1.9; color: var(--c-text); }
  .account__cap { margin-top: 20px; max-width: 40em; font-size: var(--t-xs); line-height: 1.8; color: var(--c-muted); }
  @media (max-width: 767px) {
    .account__row { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 4px 16px; padding: 18px 0 20px; }
    .account__row--deduct { padding-left: 1em; }
    .account__label { font-size: 1.0625rem; }
    .account__detail { font-size: 15px; line-height: 1.8; }
  }
</style>
