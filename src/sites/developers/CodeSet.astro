---
/**
 * Two or three small code blocks side by side (the kit's CodeTile), each under a short label:
 * the same request sent two ways, or the answers to one request. Under them an optional shared
 * block across the row (what every block reaches) and a caption. Phones: one column.
 */
import CodeTile from '../../kit/components/CodeTile.astro';
import type { Shown } from '../../content/sites/developers';

interface Props {
  items: Shown[];
  shared?: Shown;
  caption?: string;
  class?: string;
}
const { items, shared, caption, class: className } = Astro.props;
---
<div class:list={['cset', className]} style={`--n:${items.length}`}>
  <ul class="cset__row" role="list">
    {items.map((it) => (
      <li class="cset__item">
        <p class="eyebrow cset__label">{it.label}</p>
        <CodeTile code={it.sample.code} caption={it.caption} label={it.label} class="cset__code" />
      </li>
    ))}
  </ul>
  {shared && (
    <div class="cset__shared">
      <p class="eyebrow cset__label">{shared.label}</p>
      <CodeTile code={shared.sample.code} label={shared.label} class="cset__code" />
    </div>
  )}
  {caption && <p class="cset__caption">{caption}</p>}
</div>
<style>
  .cset__row { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 3px; }
  .cset__item, .cset__shared { min-width: 0; display: flex; flex-direction: column; }
  .cset__label { margin-bottom: 12px; }
  .cset__item :global(.cset__code) { flex: 1 1 auto; }
  .cset__shared { margin-top: 28px; }
  .cset__caption { margin-top: 18px; max-width: 40em; font-size: 13px; line-height: 1.8; color: var(--c-muted); }
  @media (max-width: 767px) {
    .cset__row { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
