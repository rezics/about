---
// PhotoRow does not forward Picture's priority prop. A responsive image preload before the
// page head starts the first photo's request while the copy and fonts are laid out. Preload
// links are allowed in the body, so MiniSiteLayout and its shared head can stay unchanged.
import type { MangaPicture } from '../../content/sites/manga';
import { photo } from './pictures';

interface Props {
  picture: MangaPicture;
}
const { picture } = Astro.props;
const image = photo(picture);
const sources = image.widths.map((width) => `${image.src}-${width}.avif ${width}w`).join(', ');
---
<link
  rel="preload"
  as="image"
  type="image/avif"
  href={`${image.src}-800.avif`}
  imagesrcset={sources}
  imagesizes="(max-width: 767px) 100vw, 58vw"
  fetchpriority="high"
/>
