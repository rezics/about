---
/**
 * The byline specimen (社群, section 署名): one post as two kinds of reader see it. Two radio pills
 * pick the reader; the byline swaps who leads (the lead name first, in ink and 600, with its
 * mark; the other name muted; a Realm-led line carries 追蹤). CSS only (`:has()`), so it works
 * without script; without `:has()` the follower's view stays. An illustration (示意).
 */
interface Props {
  toggleLabel: string;
  toggle: [string, string];
  you: string;
  realm: string;
  follow: string;
  post: string;
  caption: string;
}
const { toggleLabel, toggle, you, realm, follow, post, caption } = Astro.props;
---
<figure class="byline">
  <fieldset class="byline__pick">
    <legend class="sr-only">{toggleLabel}</legend>
    <label class="byline__opt"><input class="sr-only" type="radio" name="byline-reader" value="follower" checked /><span>{toggle[0]}</span></label>
    <label class="byline__opt"><input class="sr-only" type="radio" name="byline-reader" value="new" /><span>{toggle[1]}</span></label>
  </fieldset>
  <div class="byline__post" aria-live="polite">
    <p class="byline__meta byline__meta--you">
      <span class="byline__lead"><span class="byline__mark byline__mark--you" aria-hidden="true"></span>{you}</span>
      <span class="byline__dot" aria-hidden="true">·</span>
      <span class="byline__other">{realm}</span>
    </p>
    <p class="byline__meta byline__meta--realm">
      <span class="byline__lead"><span class="byline__mark byline__mark--realm" aria-hidden="true"></span>{realm}</span>
      <span class="byline__dot" aria-hidden="true">·</span>
      <span class="byline__other">{you}</span>
      <span class="byline__follow">{follow}</span>
    </p>
    <p class="byline__text serif">{post}</p>
  </div>
  <figcaption><p class="byline__cap phrase">{caption}</p></figcaption>
</figure>
<style>
  .byline { margin: 0 0 72px; }
  .byline__pick { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; border: 0; }
  .byline__opt {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--c-fg);
    box-shadow: inset 0 0 0 1px var(--c-line-strong);
    cursor: pointer;
    transition: background-color 0.3s var(--ease-snap), color 0.3s var(--ease-snap), box-shadow 0.3s var(--ease-snap), scale var(--d-s) var(--ease-soft);
  }
  @media (hover: hover) { .byline__opt:hover { box-shadow: inset 0 0 0 1px var(--c-fg); } }
  .byline__opt:active { scale: 0.98; }
  .byline__opt:has(input:checked) { background: var(--c-pill); color: var(--c-on-pill); box-shadow: none; }
  @media (hover: hover) { .byline__opt:has(input:checked):hover { background: var(--c-link); } }
  .byline__opt:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }

  .byline__post { margin-top: 32px; padding: 40px 0 44px; border-block: 1px solid var(--c-line); }
  .byline__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: 16px; line-height: 1.6; }
  .byline__meta--realm { display: none; }
  .byline:has(input[value='new']:checked) .byline__meta--you { display: none; }
  .byline:has(input[value='new']:checked) .byline__meta--realm { display: flex; }
  .byline__lead { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--c-fg); }
  .byline__mark { width: 16px; height: 16px; flex: none; }
  .byline__mark--you { background: var(--c-link); }
  .byline__mark--realm { background: var(--field); }
  .byline__dot, .byline__other { color: var(--c-muted); }
  .byline__follow { margin-left: 6px; font-weight: 600; color: var(--c-link); }
  .byline__text { margin-top: 20px; font-size: clamp(1.375rem, 1.1rem + 1.1vw, 2rem); line-height: 1.5; letter-spacing: var(--track-display); }
  .byline__cap { margin-top: 14px; font-size: var(--t-xs); line-height: 1.7; color: var(--c-muted); }
  @media (max-width: 767px) {
    .byline { margin-bottom: 44px; }
    .byline__post { margin-top: 24px; padding: 28px 0 30px; }
    .byline__text { margin-top: 14px; }
  }
</style>
