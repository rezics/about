---
// Home (v3, .temp/sites/V3-SPEC.md; the reference mock .temp/sites/v3-home-mock.html): one idea
// per section, slow rhythm. The photograph hero, the nine kinds as a tile masonry, the
// statement, one identity across kinds and languages, community and Zones, the five modules,
// developers and AI agents with one real request, the principles, the closing. It names no work.
import PageLayout from '../kit/layouts/PageLayout.astro';
import PhotoHero from '../kit/components/PhotoHero.astro';
import Section from '../kit/components/Section.astro';
import TileMasonry, { type MasonryPlace, type MasonryRowPlace } from '../kit/components/TileMasonry.astro';
import Statement from '../kit/components/Statement.astro';
import PhotoRow from '../kit/components/PhotoRow.astro';
import IndexRows from '../kit/components/IndexRows.astro';
import CodeTile from '../kit/components/CodeTile.astro';
import FactList from '../kit/components/FactList.astro';
import Closing from '../kit/components/Closing.astro';
import ProductCall from '../kit/components/ProductCall.astro';
import { kinds, modules, site, moduleHref } from '../kit/content';
import { kindTiles } from '../kit/tiles';

const h = site.home;
const tiles = kindTiles(kinds.map((k) => k.id), h.kinds.lines);
// The mock's masonry: four columns that end level, the larger kinds taller; the three hubs are
// small and carry no line.
const columns: MasonryPlace[][] = [
  [{ id: 'books', h: 5 }, { id: 'mcp', h: 2, line: false }],
  [{ id: 'anime', h: 3 }, { id: 'software', h: 4 }],
  [{ id: 'manga', h: 4 }, { id: 'visual-novels', h: 3 }],
  [{ id: 'games', h: 4 }, { id: 'skills', h: 1.5, line: false }, { id: 'apis', h: 1.5, line: false }],
];
const phone: MasonryRowPlace[][] = [
  [{ id: 'books' }, { id: 'anime' }],
  [{ id: 'mcp', line: false }, { id: 'software' }],
  [{ id: 'manga' }, { id: 'visual-novels' }],
  [{ id: 'games', w: 2 }, { id: 'skills', line: false }, { id: 'apis', line: false }],
];
const moduleRows = modules.map((m) => ({ name: m.name, desc: h.platform.modules[m.id], href: moduleHref(m.id) }));
---
<PageLayout meta={site.meta} home action={false}>
  <PhotoHero
    class="home-hero"
    title={h.hero.headline}
    lede={h.hero.lede}
    image={{
      src: '/images/home/hero',
      widths: [960, 1920],
      width: 1920,
      height: 1280,
      alt: h.hero.imageAlt,
      position: '0% 50%',
      phone: { src: '/images/home/hero-phone', widths: [640, 960], width: 960, height: 640, position: '50% 50%' },
    }}
  >
    <ProductCall label={h.hero.primary} />
  </PhotoHero>

  <Section id="products" class="home-kinds" eyebrow={h.kinds.eyebrow} title={h.kinds.headline}>
    <TileMasonry slot="wide" items={tiles} columns={columns} phone={phone} height={560} label={h.kinds.eyebrow} />
  </Section>

  <Statement text={h.statement.text} sub={h.statement.sub} />

  <PhotoRow
    side="left"
    eyebrow={h.identity.eyebrow}
    title={h.identity.headline}
    body={h.identity.body}
    link={{ href: '/engine/universal-index/', text: h.identity.link }}
    image={{ src: '/images/home/identity', widths: [640, 1200], width: 1200, height: 800, alt: h.identity.imageAlt }}
  />

  <PhotoRow
    side="right"
    eyebrow={h.community.eyebrow}
    title={h.community.headline}
    body={h.community.body}
    link={{ href: '/engine/community/', text: h.community.link }}
    image={{ src: '/images/home/zones', widths: [640, 1200], width: 1200, height: 800, alt: h.community.imageAlt }}
  />

  <Section eyebrow={h.platform.eyebrow} title={h.platform.headline} lead={h.platform.lead}>
    <IndexRows rows={moduleRows} />
  </Section>

  <Section eyebrow={h.agents.eyebrow} title={h.agents.headline} lead={h.agents.lead} link={{ href: '/developers/', text: h.agents.link }}>
    <CodeTile code={h.agents.code} caption={h.agents.caption} label={h.agents.codeLabel} class="home-code" />
  </Section>

  <Section eyebrow={h.principles.eyebrow} title={h.principles.headline}>
    <FactList items={h.principles.items} />
  </Section>

  <Closing title={h.finale.headline} body={h.finale.body} />
</PageLayout>

<style>
  /* The approved mock's copy measure and two-line headline. At narrow desktop aspect ratios,
     keep the empty left paper in view rather than cropping into it from the right. */
  :global(.home-hero .phero__copy) { max-width: min(32vw, 470px); }
  :global(.home-hero .phero__title) { font-size: clamp(34px, 3.6vw, 56px); }
  :global(.home-hero .phero__title .clause) { display: block; width: max-content; white-space: nowrap; }
  :global(.home-code) { max-width: 620px; }
  @media (max-width: 767px) {
    :global(.home-hero .phero__copy) { max-width: none; }
    :global(.home-hero .phero__title) { font-size: 30px; }
    :global(.home-hero .phero__lede) { margin-top: 24px; }
    :global(.home-hero .phero__act) { margin-top: 32px; }
  }
  @media (max-width: 359px) {
    :global(.home-kinds .tile) { --pad: 12px; }
    :global(.home-kinds .tile__name--latin) { --tile-name: 20px; }
  }
</style>
