---
// Home (DESIGN.md "Direction v2"; the reference mock .temp/mocks/home.html, section for section):
// the hero with the wall of the nine kinds, the index section and its adaptation chain, the
// community band, the platform statement over the module index, developers and agents with a
// real request, the principles, the closing block. It names no specific work.
import PageLayout from '../kit/layouts/PageLayout.astro';
import HeroWall from '../kit/components/HeroWall.astro';
import type { WallItem, WallPlace } from '../kit/components/TileWall.astro';
import Sec from '../kit/components/Sec.astro';
import TextCols from '../kit/components/TextCols.astro';
import TileRow from '../kit/components/TileRow.astro';
import Band from '../kit/components/Band.astro';
import Statement from '../kit/components/Statement.astro';
import IndexRows from '../kit/components/IndexRows.astro';
import CodeTile from '../kit/components/CodeTile.astro';
import ItemList from '../kit/components/ItemList.astro';
import Closing from '../kit/components/Closing.astro';
import ProductCall from '../kit/components/ProductCall.astro';
import Clauses from '../kit/Clauses.astro';
import { kinds, modules, site, kindHref, moduleHref } from '../kit/content';
import { kindFields } from '../kit/theme';

const h = site.home;
const wall: WallItem[] = kinds.map((k) => ({
  id: k.id,
  name: k.name,
  tag: k.tag,
  line: k.summary,
  href: kindHref(k.id),
  bg: kindFields[k.id].field,
  on: kindFields[k.id].on,
}));
// The wall as in the mock: three columns, the larger kinds taller; small tiles carry no line.
const wide: WallPlace[][] = [
  [{ id: 'books', h: 5 }, { id: 'visual-novels', h: 3 }, { id: 'software', h: 2.4, line: false }],
  [{ id: 'anime', h: 3.2 }, { id: 'manga', h: 3.4 }, { id: 'skills', h: 2, line: false }],
  [{ id: 'mcp', h: 2.4 }, { id: 'games', h: 4.4 }, { id: 'apis', h: 2, line: false }],
];
const phone: WallPlace[][] = [
  [{ id: 'books', h: 5 }, { id: 'visual-novels', h: 3 }, { id: 'software', h: 2.4, line: false }, { id: 'mcp', h: 2.2, line: false }],
  [{ id: 'anime', h: 3.2 }, { id: 'manga', h: 3.4 }, { id: 'skills', h: 2, line: false }, { id: 'games', h: 3.6 }, { id: 'apis', h: 2, line: false }],
];
const chain = h.index.chain.map((c) => ({ name: c.name, rel: c.rel, bg: kindFields[c.kind].field, on: kindFields[c.kind].on }));
const moduleRows = modules.map((m) => ({ name: m.name, desc: h.platform.modules[m.id], href: moduleHref(m.id) }));
---
<PageLayout meta={site.meta} home action={false}>
  <HeroWall label={h.hero.label} title={h.hero.headline} lede={h.hero.lede} items={wall} wide={wide} phone={phone} phoneHeight={980}>
    <ProductCall label={h.hero.primary} />
    <a class="link-draw" href="#index">{h.hero.secondary}</a>
  </HeroWall>

  <Sec id="index" label={h.index.label} title={h.index.headline} link={{ href: '/engine/universal-index/', text: h.index.link }}>
    <TextCols paragraphs={h.index.body} />
    <TileRow slot="wide" items={chain} cols={4} label={h.index.label} />
  </Sec>

  <Band label={h.community.label} title={h.community.headline} text={h.community.body} items={h.community.items} />

  <Statement text={h.platform.headline} sub={h.platform.more}>
    <IndexRows rows={moduleRows} />
  </Statement>

  <section class="agents" aria-labelledby="agents-title">
    <div class="grid">
      <div class="agents__text">
        <p class="mlabel">{h.agents.label}</p>
        <h2 id="agents-title" class="agents__title"><Clauses text={h.agents.headline} /></h2>
        <p class="text agents__body">{h.agents.body}</p>
        <a class="link-draw agents__link" href="/developers/">{h.agents.link}</a>
      </div>
      <CodeTile code={h.agents.code} caption={h.agents.caption} label={h.agents.codeLabel} class="agents__code" />
    </div>
  </section>

  <ItemList label={h.principles.headline} items={h.principles.items} />

  <Closing title={h.finale.headline} body={h.finale.body} />
</PageLayout>

<style>
  .agents { padding-top: var(--space-section); }
  .agents .grid { align-items: start; }
  .agents__text { grid-column: 1 / 6; }
  .agents__title { margin-top: 22px; font-size: clamp(1.75rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.3; }
  .agents__body { margin-top: 22px; }
  .agents__link { margin-top: 28px; }
  :global(.agents__code) { grid-column: 7 / 13; }
  @media (max-width: 767px) {
    :global(.agents__code) { margin-top: 32px; }
  }
</style>
