---
// Home (DESIGN.md "Direction v2", Rhythm): the centred intro over a large painted image, two
// text-and-image rows, one statement, the nine products as a calm card row, a third row, the
// commitments, and the closing panel into REZICS. It names no specific work.
import PageLayout from '../kit/layouts/PageLayout.astro';
import PageIntro from '../kit/components/PageIntro.astro';
import MediaRow from '../kit/components/MediaRow.astro';
import Statement from '../kit/components/Statement.astro';
import SectionHead from '../kit/components/SectionHead.astro';
import CardRow, { type CardItem } from '../kit/components/CardRow.astro';
import ItemList from '../kit/components/ItemList.astro';
import ClosingPanel from '../kit/components/ClosingPanel.astro';
import ProductCall from '../kit/components/ProductCall.astro';
import Arrow from '../kit/components/Arrow.astro';
import { kinds, site, kindHref } from '../kit/content';
import { kindFields } from '../kit/theme';

const h = site.home;
const card = (group: 'works' | 'agents'): CardItem[] =>
  kinds
    .filter((k) => k.group === group)
    .map((k, i) => ({ title: k.name, body: k.summary, href: kindHref(k.id), art: { field: kindFields[k.id].field, variant: i } }));
---
<PageLayout meta={site.meta} home action={false}>
  <PageIntro
    title={h.hero.headline}
    lede={h.hero.lede}
    image={{ base: '/images/home/hero', alt: h.hero.imageAlt, widths: [640, 1024, 1536], ratio: 16 / 9 }}
  >
    <ProductCall label={h.hero.primary} />
    <a class="link-draw" href="#products">{h.hero.secondary}<Arrow dir="down" /></a>
  </PageIntro>

  <MediaRow title={h.index.headline} body={h.index.body} image={{ base: '/images/home/index', alt: h.index.imageAlt }}>
    <a class="link-draw" href="/engine/universal-index/">{h.index.link}<Arrow /></a>
  </MediaRow>

  <MediaRow title={h.community.headline} body={h.community.body} image={{ base: '/images/home/community', alt: h.community.imageAlt }} reverse>
    <a class="link-draw" href="/engine/community/">{h.community.link}<Arrow /></a>
  </MediaRow>

  <Statement text={h.statement.text} sub={h.statement.body}>
    <a class="link-draw" href="/engine/">{h.statement.link}<Arrow /></a>
  </Statement>

  <section id="products" class="products" aria-labelledby="products-title">
    <div class="container">
      <SectionHead id="products-title" title={h.products.headline} lede={h.products.lede} />
    </div>
    <div class="products__group">
      <p class="container products__label label">{site.nav.groups.works}</p>
      <CardRow items={card('works')} cols={3} ratio={16 / 9} bare />
    </div>
    <div class="products__group">
      <p class="container products__label label">{site.nav.groups.agents}</p>
      <CardRow items={card('agents')} cols={3} ratio={16 / 9} bare />
    </div>
  </section>

  <MediaRow title={h.agents.headline} body={h.agents.body} image={{ base: '/images/home/open', alt: h.agents.imageAlt }}>
    <a class="link-draw" href="/developers/">{h.agents.link}<Arrow /></a>
  </MediaRow>

  <ItemList title={h.principles.headline} items={h.principles.items} class="principles" />

  <ClosingPanel title={h.finale.headline} body={h.finale.body} />
</PageLayout>

<style>
  .products { padding-block: calc(var(--space-section) / 2); }
  .products__group { margin-top: clamp(32px, 4vw, 56px); }
  .products__label { color: var(--c-muted); margin-bottom: 16px; }
</style>
