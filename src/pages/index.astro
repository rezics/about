---
// Home (DESIGN.md "Composition plan"): each layout family once, the composing square first.
import PageLayout from '../kit/layouts/PageLayout.astro';
import Section from '../kit/components/Section.astro';
import Composer from '../kit/components/Composer.astro';
import KindSquare from '../kit/components/KindSquare.astro';
import ModuleSquare from '../kit/components/ModuleSquare.astro';
import EmptySquare from '../kit/components/EmptySquare.astro';
import NotifyCall from '../kit/components/NotifyCall.astro';
import { kinds, modules, partById, site, moduleHref, kindById } from '../kit/content';
import { kindFields } from '../kit/theme';

const h = site.home;
const items = kinds.map((k) => ({ id: k.id, name: k.name, field: kindFields[k.id], parts: k.parts }));
const identity = partById('identity');
---
<PageLayout meta={site.meta} home>
  <!-- 1 Hero: split frame, the composing square as the scene -->
  <section class="hero grid" aria-labelledby="hero-title" data-hero>
    <div class="hero__text">
      <h1 id="hero-title" class="t-xl hero__title">{h.hero.headline}</h1>
      <p class="lede hero__lede">{h.hero.lede}</p>
      <div class="hero__actions">
        <NotifyCall label={h.hero.primary} />
        <a class="link-draw hero__secondary" href="#index">{h.hero.secondary}<span class="arrow" aria-hidden="true"> ↓</span></a>
      </div>
    </div>
    <div class="hero__scene">
      <Composer items={items} class="hero__composer" data-hero-composer />
      <p class="hero__caption mono">{h.hero.caption}</p>
    </div>
  </section>

  <!-- 2 Index: gallery wall of the nine kinds, one cell left for the next -->
  <Section id="index" mood="normal" labelledby="index-title" class="index">
    <div class="col-1-4 index__text">
      <h2 id="index-title" class="t-l">{h.index.headline}</h2>
      <p class="muted">{h.index.body}</p>
    </div>
    <ul class="col-5-12 index__grid" role="list" data-reveal="slot">
      {kinds.map((k, i) => (
        <li>
          <KindSquare kind={k.id} mode="flood" describe sizes="(max-width: 767px) 33vw, 22vw" data-index-first={i === 0 ? '' : undefined} />
        </li>
      ))}
      <li class="index__next"><EmptySquare label={h.index.nextKind} /></li>
    </ul>
  </Section>

  <!-- 3 One identity: sticky square left, chapters right -->
  <Section mood="normal" labelledby="identity-title" class="identity" data-chapters>
    <div class="col-1-5 identity__stage-wrap">
      <div class="identity__stage" data-stage data-state="0" aria-hidden="true">
        {h.identity.chapters.map((c, i) => (
          <div class="identity__layer" data-layer={i}>
            <KindSquare kind={c.kind} mode="image" link={false} sizes="(max-width: 767px) 40vw, 34vw" />
          </div>
        ))}
        <span class="identity__tag"><span>{identity.name}</span><span class="mono">{identity.id}</span></span>
      </div>
    </div>
    <div class="col-7-12 identity__text">
      <h2 id="identity-title" class="t-l">{h.identity.headline}</h2>
      <p class="lede">{h.identity.body}</p>
      <ol class="identity__chapters" role="list">
        {h.identity.chapters.map((c, i) => (
          <li class="identity__chapter" data-chapter data-active={i === 0 ? '' : undefined}>
            <span class="identity__kind mono">{kindById(c.kind).name}</span>
            <h3 class="t-l">{c.title}</h3>
            <p class="identity__body">{c.body}</p>
            <div class="identity__inline" aria-hidden="true"><KindSquare kind={c.kind} mode="image" link={false} sizes="40vw" /></div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- 4 Community: asymmetric pair -->
  <Section mood="airy" labelledby="community-title" class="community">
    <div class="col-1-6 community__square">
      <ModuleSquare module="community" />
    </div>
    <div class="community__text">
      <h2 id="community-title" class="t-l">{h.community.headline}</h2>
      <p class="muted">{h.community.body}</p>
      <dl class="community__points">
        {h.community.points.map((p) => (
          <div>
            <dt class="t-m">{p.title}</dt>
            <dd>{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <!-- 5 Engine: index list with a preview square -->
  <Section mood="normal" labelledby="engine-title" class="engine" data-preview-list>
    <div class="col-1-4 engine__aside">
      <h2 id="engine-title" class="t-l">{h.engine.headline}</h2>
      <p class="muted">{h.engine.body}</p>
      <div class="engine__preview" data-preview aria-hidden="true">
        {modules.map((m, i) => (
          <div class="engine__preview-item" data-preview-item={m.id} data-active={i === 0 ? '' : undefined}>
            <ModuleSquare module={m.id} link={false} />
          </div>
        ))}
      </div>
    </div>
    <ol class="col-5-12 engine__list" role="list">
      {modules.map((m, i) => (
        <li>
          <a class="engine__row" href={moduleHref(m.id)} data-preview-key={m.id} data-active={i === 0 ? '' : undefined}>
            <span class="engine__name t-l">{m.name}</span>
            <span class="engine__summary">{m.summary}</span>
            <span class="arrow engine__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </Section>

  <!-- 6 Agents and developers: facts on an ink band -->
  <Section mood="normal" band="ink" labelledby="agents-title" class="agents">
    <div class="col-1-5 agents__text">
      <h2 id="agents-title" class="t-l">{h.agents.headline}</h2>
      <p class="muted">{h.agents.body}</p>
      <p><a class="link-draw agents__more" href="/developers/">{site.nav.developers}<span class="arrow" aria-hidden="true"> →</span></a></p>
    </div>
    <dl class="col-7-12 agents__facts">
      {h.agents.facts.map((f) => (
        <div class="agents__fact">
          <dt class="t-m">{f.title}</dt>
          <dd class="muted">{f.body}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- 7 Principles: statement -->
  <Section mood="airy" labelledby="principles-title" class="principles">
    <h2 id="principles-title" class="col-1-4 principles__title mono">{h.principles.headline}</h2>
    <ol class="col-5-12 principles__list" role="list">
      {h.principles.items.map((p) => (
        <li>
          <p class="principles__item" data-split="lines">{p.title}</p>
          <p class="muted principles__body">{p.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- 8 Finale: the giant call to action; the notify square follows in the footer -->
  <Section mood="normal" labelledby="finale-title" class="finale-cta">
    <h2 id="finale-title" class="col-1-10 finale-cta__title" data-split="lines">{h.finale.headline}</h2>
    <p class="col-1-6 lede">{h.finale.body}</p>
    <div class="col-7-12 finale-cta__action"><NotifyCall /></div>
  </Section>
</PageLayout>

<script>
  import { initHero } from '../home/hero';
  initHero();
</script>

<style>
  /* 1 Hero */
  .hero {
    position: relative;
    z-index: 2;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(24px, 4vw, 56px);
    align-items: center;
    row-gap: 40px;
  }
  .hero__text { grid-column: 1 / span 6; display: flex; flex-direction: column; gap: 28px; }
  .hero__title { max-width: 9.5em; margin-left: -0.04em; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; }
  .hero__secondary { font-weight: 700; min-height: 24px; }
  .hero__scene { grid-column: 7 / span 6; justify-self: end; width: min(100%, calc(100svh - var(--header-h) - 150px)); min-width: min(100%, 420px); }
  .hero__caption { margin-top: 12px; color: var(--c-muted); }
  :global(.motion .hero__composer:not(.is-assembled) .composer__part[data-on='true']),
  :global(.motion .hero__composer:not(.is-assembled) .composer__item[data-on='true']) { visibility: hidden; }
  @media (max-width: 899px) {
    .hero { min-height: 0; }
    .hero__text, .hero__scene { grid-column: 1 / -1; }
    .hero__scene { justify-self: stretch; width: 100%; min-width: 0; }
  }

  /* 2 Index */
  .index__text { display: flex; flex-direction: column; gap: 16px; align-self: start; position: sticky; top: calc(var(--header-h) + 32px); }
  .index__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(8px, 1vw, 16px); }
  @media (max-width: 767px) {
    .index__text { position: static; }
    .index__grid { gap: 6px; }
  }

  /* 3 Identity */
  .identity__stage-wrap { align-self: stretch; }
  .identity__stage { position: sticky; top: calc(var(--header-h) + 48px); aspect-ratio: 1; }
  .identity__layer { position: absolute; inset: 0; clip-path: inset(100% 0 0 0); transition: clip-path var(--d-l) var(--ease-snap); }
  .identity__stage[data-state='0'] .identity__layer[data-layer='0'],
  .identity__stage[data-state='1'] .identity__layer[data-layer='1'],
  .identity__stage[data-state='2'] .identity__layer[data-layer='2'],
  .identity__stage[data-state='3'] .identity__layer[data-layer='3'] { clip-path: inset(0 0 0 0); z-index: 1; }
  .identity__tag {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: calc(100% / 3);
    aspect-ratio: 1;
    padding: 12px;
    background: var(--c-paper);
    color: var(--c-ink);
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.5rem);
    border: 1px solid var(--c-line-strong);
  }
  .identity__tag .mono { color: var(--c-muted); }
  .identity__text { display: flex; flex-direction: column; gap: 24px; }
  .identity__chapters { margin-top: 24px; }
  .identity__chapter {
    min-height: 62svh;
    padding-block: 32px;
    border-top: 1px solid var(--c-line);
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: var(--measure);
    opacity: 0.45;
    transition: opacity var(--d-m) var(--ease-snap);
  }
  .identity__chapter[data-active] { opacity: 1; }
  :global(html:not(.js)) .identity__chapter { opacity: 1; }
  .identity__kind { color: var(--c-muted); }
  .identity__body { font-size: var(--t-m); line-height: 1.65; }
  .identity__inline { display: none; width: 40%; margin-top: 8px; }
  @media (max-width: 767px) {
    .identity__stage-wrap { display: none; }
    .identity__chapter { min-height: 0; opacity: 1; }
    .identity__inline { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .identity__chapter { opacity: 1; }
  }

  /* 4 Community */
  .community__text { grid-column: 8 / span 5; align-self: end; display: flex; flex-direction: column; gap: 20px; }
  .community__points { display: grid; gap: 20px; margin-top: 12px; }
  .community__points div { border-top: 1px solid var(--c-line); padding-top: 14px; }
  .community__points dd { color: var(--c-muted); margin-top: 6px; }
  @media (max-width: 767px) {
    .community__text { grid-column: 1 / -1; }
  }

  /* 5 Engine */
  .engine__aside { display: flex; flex-direction: column; gap: 16px; align-self: start; position: sticky; top: calc(var(--header-h) + 32px); }
  .engine__preview { position: relative; aspect-ratio: 1; margin-top: 16px; overflow: clip; }
  .engine__preview-item { position: absolute; inset: 0; translate: 0 101%; transition: translate var(--d-m) var(--ease-snap); }
  .engine__preview-item[data-active] { translate: 0 0; z-index: 1; }
  .engine__list { border-top: 1px solid var(--c-line-strong); }
  .engine__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) auto;
    align-items: center;
    gap: var(--gutter);
    min-height: clamp(88px, 9vw, 128px);
    border-bottom: 1px solid var(--c-line-strong);
    background: linear-gradient(var(--c-ink) 0 0) left bottom / 0% 3px no-repeat;
    transition: background-size var(--d-m) var(--ease-snap);
  }
  .engine__name { line-height: 1.1; }
  .engine__summary { color: var(--c-muted); }
  .engine__arrow { font-size: var(--t-m); }
  @media (hover: hover) {
    .engine__row:hover { background-size: 100% 3px; }
    .engine__row:hover .engine__arrow { translate: 0.4em 0; }
  }
  .engine__row:focus-visible { background-size: 100% 3px; }
  @media (max-width: 767px) {
    .engine__aside { position: static; }
    .engine__preview { display: none; }
    .engine__row { grid-template-columns: 1fr auto; padding-block: 16px; row-gap: 4px; }
    .engine__summary { grid-column: 1; grid-row: 2; }
    .engine__arrow { grid-row: 1 / span 2; grid-column: 2; }
  }

  /* 6 Agents */
  .agents__text { display: flex; flex-direction: column; gap: 20px; }
  .agents__more { font-weight: 700; }
  .agents__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--c-line-strong); border-left: 1px solid var(--c-line-strong); }
  .agents__fact { aspect-ratio: 1; padding: clamp(16px, 2vw, 28px); border-right: 1px solid var(--c-line-strong); border-bottom: 1px solid var(--c-line-strong); display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }
  @media (max-width: 767px) {
    .agents__fact { aspect-ratio: auto; min-height: 160px; }
  }

  /* 7 Principles */
  .principles__title { color: var(--c-muted); align-self: start; padding-top: 1.2em; font-size: var(--t-s); }
  .principles__list { display: flex; flex-direction: column; gap: clamp(40px, 6vw, 88px); }
  .principles__item { font-weight: 900; font-size: clamp(2rem, 1rem + 4vw, 4.5rem); line-height: 1.1; letter-spacing: var(--track-display); }
  .principles__body { margin-top: 12px; font-size: var(--t-m); }

  /* 8 Finale */
  .finale-cta { border-top: 1px solid var(--c-line); }
  .finale-cta__title { font-weight: 900; font-size: clamp(3rem, 0.8rem + 8.6vw, 10rem); line-height: 1.04; letter-spacing: var(--track-display); margin-left: -0.05em; }
  .finale-cta__action { align-self: end; justify-self: start; }
</style>
