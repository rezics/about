---
// 路線圖 (v3; src/sites/engine/SITE.md): the hero, the order in five steps, the kinds after the
// nine, the statement, what one graph makes possible, what will not change, the closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PhotoHero from '../../kit/components/PhotoHero.astro';
import Section from '../../kit/components/Section.astro';
import Statement from '../../kit/components/Statement.astro';
import FactList from '../../kit/components/FactList.astro';
import Closing from '../../kit/components/Closing.astro';
import ProductCall from '../../kit/components/ProductCall.astro';
import site from '../../content/sites/roadmap';

const s = site.strings;
---
<MiniSiteLayout>
  <PhotoHero
    bar
    title={s.hero.headline}
    lede={s.hero.lede}
    image={{
      src: '/images/sites/roadmap/hero',
      widths: [960, 1920],
      width: 1920,
      height: 1280,
      alt: s.hero.alt,
      position: '100% 60%',
      phone: { src: '/images/sites/roadmap/hero-phone', widths: [640, 960], width: 960, height: 640 },
    }}
  >
    <ProductCall />
  </PhotoHero>

  <Section eyebrow={s.order.label} title={s.order.headline} lead={s.order.lead}>
    <FactList items={s.order.steps} numbered />
  </Section>

  <Section eyebrow={s.further.label} title={s.further.headline} lead={s.further.lead}>
    <FactList items={s.further.items} />
  </Section>

  <Statement text={s.statement[0]} sub={s.statement[1]} />

  <Section eyebrow={s.promises.label} title={s.promises.headline} lead={s.promises.lead}>
    <FactList items={s.promises.items} />
  </Section>

  <Section eyebrow={s.constant.label} title={s.constant.headline}>
    <FactList items={s.constant.items} />
  </Section>

  <Closing title={s.closing} />
</MiniSiteLayout>
