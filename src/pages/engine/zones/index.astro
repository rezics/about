---
// 站點 (v3; src/sites/engine/SITE.md): the family opening, then one idea per section (routes,
// templates, themes, Wiki+, shared identities, revisions) around an illustrative Wiki+, then the
// family closing (statement, the ring of the five modules, the closing).
import MiniSiteLayout from '../../../kit/layouts/MiniSiteLayout.astro';
import PhotoHero from '../../../kit/components/PhotoHero.astro';
import PhotoRow from '../../../kit/components/PhotoRow.astro';
import Section from '../../../kit/components/Section.astro';
import Statement from '../../../kit/components/Statement.astro';
import FactList from '../../../kit/components/FactList.astro';
import Closing from '../../../kit/components/Closing.astro';
import ProductCall from '../../../kit/components/ProductCall.astro';
import ModuleRing from '../../../sites/engine/ModuleRing.astro';
import Routes from '../../../sites/zones/Routes.astro';
import { moduleById } from '../../../kit/content';
import { splitStatement } from '../../../sites/engine/family';
import site from '../../../content/sites/zones';
import '../../../sites/engine/hero.css';

const s = site.strings;
const statement = splitStatement(moduleById('zones').statement);
---
<MiniSiteLayout>
  <PhotoHero
    bar
    class="modules-hero"
    eyebrow={s.hero.eyebrow}
    title={s.hero.headline}
    lede={s.hero.lede}
    image={{
      src: '/images/sites/zones/hero',
      widths: [960, 1920],
      width: 1920,
      height: 1280,
      alt: s.hero.alt,
      position: '100% 40%',
      phone: { src: '/images/sites/zones/hero-phone', widths: [640, 960], width: 960, height: 640 },
    }}
  >
    <ProductCall />
  </PhotoHero>

  <Section eyebrow={s.routes.label} title={s.routes.headline} lead={s.routes.lead}>
    <Routes entries={s.routes.entries} caption={s.routes.caption} />
    <p class="z-after">{s.routes.note}</p>
  </Section>

  <Section eyebrow={s.templates.label} title={s.templates.headline} lead={s.templates.lead}>
    <FactList items={s.templates.steps} numbered />
    <p class="z-after">{s.templates.note}</p>
  </Section>

  <Section eyebrow={s.themes.label} title={s.themes.headline} lead={s.themes.lead}>
    <FactList items={s.themes.items} />
  </Section>

  <Section eyebrow={s.wiki.label} title={s.wiki.headline} lead={s.wiki.lead}>
    <FactList items={s.wiki.items} />
  </Section>

  <PhotoRow
    eyebrow={s.shared.label}
    title={s.shared.headline}
    body={[s.shared.lead, s.shared.more]}
    image={{ src: '/images/sites/zones/shared', widths: [640, 1200], width: 1200, height: 800, alt: s.shared.alt }}
  />

  <Section eyebrow={s.log.label} title={s.log.headline} lead={s.log.lead}>
    <p class="z-caption">{s.log.caption}</p>
    <FactList items={s.log.entries} />
    <FactList class="z-more" items={s.log.items} />
  </Section>

  <Statement text={statement[0]} sub={statement[1]} />
  <ModuleRing current="zones" />
  <Closing title={s.closing} />
</MiniSiteLayout>

<style>
  .z-after { margin-top: 32px; max-width: 34em; font-size: 16px; line-height: 1.9; color: var(--c-text); }
  .z-caption { margin-bottom: 20px; font-size: 13px; line-height: 1.6; color: var(--c-muted); }
  :global(.z-more) { margin-top: 72px; }
  @media (max-width: 767px) { :global(.z-more) { margin-top: 48px; } }
</style>
