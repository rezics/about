---
// 創作與發行 /engine/create/ (v3; plan in src/sites/community/SITE.md). One picture, one idea per
// section: writing, the private world, chapters, editions, what publishing does not grant,
// translations and rights, selling, the statement of account, then the module family's closing.
import MiniSiteLayout from '../../../kit/layouts/MiniSiteLayout.astro';
import '../../../sites/community/module-hero.css';
import PhotoHero from '../../../kit/components/PhotoHero.astro';
import Section from '../../../kit/components/Section.astro';
import FactList from '../../../kit/components/FactList.astro';
import Statement from '../../../kit/components/Statement.astro';
import ProductCall from '../../../kit/components/ProductCall.astro';
import FactGrid from '../../../sites/community/FactGrid.astro';
import Account from '../../../sites/create/Account.astro';
import EditionRecord from '../../../sites/create/EditionRecord.astro';
import ModuleEnd from '../../../sites/community/ModuleEnd.astro';
import ModuleContents from '../../../sites/community/ModuleContents.astro';
import { site as shared } from '../../../kit/content';
import site from '../../../content/sites/create';

const s = site.strings;
---
<MiniSiteLayout>
  <PhotoHero
    class="module-hero"
    bar
    eyebrow={shared.nav.engine}
    title={s.hero.headline}
    lede={s.hero.lede}
    image={{
      src: '/images/sites/create/hero',
      widths: [960, 1920],
      width: 1920,
      height: 1280,
      alt: s.hero.imageAlt,
      position: '0% 50%',
      phone: { src: '/images/sites/create/hero-phone', widths: [640, 780, 960], width: 960, height: 640, position: '50% 50%' },
    }}
  >
    <ProductCall />
  </PhotoHero>

  <ModuleContents label={s.contentsLabel} items={[
    { id: "create-writing", label: s.writing.label },
    { id: "create-world", label: s.world.label },
    { id: "create-chapters", label: s.chapters.label },
    { id: "create-editions", label: s.editions.label },
    { id: "create-rights", label: s.rights.label },
    { id: "create-sell", label: s.sell.label },
    { id: "create-account", label: s.account.label },
  ]} />

  <Section id="create-writing" eyebrow={s.writing.label} title={s.writing.headline} lead={s.writing.lead}>
    <FactList items={s.writing.facts!} />
  </Section>

  <Section id="create-world" eyebrow={s.world.label} title={s.world.headline} lead={s.world.lead}>
    <FactGrid items={s.world.facts!} label={s.world.headline} />
  </Section>

  <Section id="create-chapters" eyebrow={s.chapters.label} title={s.chapters.headline} lead={s.chapters.lead}>
    <FactList items={s.chapters.facts!} />
  </Section>

  <Section id="create-editions" eyebrow={s.editions.label} title={s.editions.headline} lead={s.editions.lead}>
    <EditionRecord {...s.editions.specimen} />
    <FactGrid items={s.editions.facts!} label={s.editions.headline} />
    <p class="module-note phrase">{s.editions.note}</p>
  </Section>

  <Statement text={s.copyright.statement} sub={s.copyright.sub} />

  <Section id="create-rights" eyebrow={s.rights.label} title={s.rights.headline} lead={s.rights.lead}>
    <FactList items={s.rights.facts!} />
  </Section>

  <Section id="create-sell" eyebrow={s.sell.label} title={s.sell.headline} lead={s.sell.lead}>
    <FactGrid items={s.sell.facts!} label={s.sell.headline} />
  </Section>

  <Section id="create-account" eyebrow={s.account.label} title={s.account.headline} lead={s.account.lead}>
    <Account rows={s.account.rows} deduct={s.account.deduct} caption={s.account.caption} label={s.account.label} />
  </Section>

  <ModuleEnd current="create" family={s.family} />
</MiniSiteLayout>

<style>
  .module-note { margin-top: 12px; max-width: 40em; font-size: var(--t-xs); line-height: 1.8; color: var(--c-muted); }
</style>
