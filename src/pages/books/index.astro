---
// 書庫 landing (DESIGN.md "Direction v2"; src/sites/books/SITE.md): the centred intro over the
// reading room, the kinds of books, the reading figure and its six steps, a reading row, the six
// pages as cards, the writing row, the eight parts, the neighbouring kinds, and the next page.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageIntro from '../../kit/components/PageIntro.astro';
import MediaRow from '../../kit/components/MediaRow.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import CardRow, { type CardItem } from '../../kit/components/CardRow.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import PartsList from '../../kit/components/PartsList.astro';
import Pills from '../../kit/components/Pills.astro';
import ProductCall from '../../kit/components/ProductCall.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Arrow from '../../kit/components/Arrow.astro';
import { kindById, kindHref } from '../../kit/content';
import { kindFields } from '../../kit/theme';
import { pageHref } from '../../kit/sites';
import Progress from '../../sites/books/Progress.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.landing;
const kind = kindById('books');
const pageBy = (slug: string) => site.pages.find((p) => p.slug === slug)!;
const pages: CardItem[] = s.pages.rows.map((r, i) => ({
  title: pageBy(r.slug).label,
  body: r.body,
  href: pageHref(site, pageBy(r.slug)),
  art: { field: kindFields.books.field, variant: i },
}));
const neighbours: CardItem[] = s.connections.squares.map((c, i) => ({
  title: kindById(c.kind).name,
  body: c.label,
  href: kindHref(c.kind),
  art: { field: kindFields[c.kind].field, variant: i + 1 },
}));
---
<MiniSiteLayout>
  <PageIntro title={s.hero.headline} lede={s.hero.lede} image={{ base: '/images/sites/books/hero', alt: s.hero.alt }}>
    <ProductCall />
    <a class="link-draw" href="#bookmark">{s.hero.secondary}<Arrow dir="down" /></a>
  </PageIntro>

  <section class="bk-sec" aria-labelledby="shelf-title">
    <div class="container bk-shelf">
      <SectionHead id="shelf-title" title={s.shelf.headline} lede={s.shelf.caption} align="center" />
      <Pills items={s.shelf.words} tone="tint" class="bk-shelf__pills" />
    </div>
  </section>

  <section id="bookmark" class="bk-sec" aria-labelledby="bm-title">
    <div class="container bk-stack">
      <SectionHead id="bm-title" title={s.bookmark.headline} lede={s.bookmark.intro} />
      <Progress />
      <ItemGrid items={s.bookmark.steps} cols={3} numbered />
    </div>
  </section>

  <MediaRow title={s.reading.headline} body={s.reading.body} image={{ base: '/images/sites/books/nook', alt: s.reading.alt }} reverse>
    <a class="link-draw" href={pageHref(site, pageBy('wiki'))}>{s.reading.link}<Arrow /></a>
  </MediaRow>

  <CardRow title={s.pages.headline} items={pages} cols={3} ratio={16 / 9} />

  <MediaRow title={s.writing.headline} body={s.writing.body} image={{ base: '/images/sites/books/desk', alt: s.writing.alt }}>
    <a class="link-draw" href={pageHref(site, pageBy('serial'))}>{s.writing.links[0]}<Arrow /></a>
    <a class="link-draw" href={pageHref(site, pageBy('publish'))}>{s.writing.links[1]}<Arrow /></a>
  </MediaRow>

  <section class="bk-sec" aria-labelledby="parts-title">
    <div class="container bk-stack">
      <SectionHead id="parts-title" title={s.parts.headline} lede={s.parts.caption} />
      <PartsList parts={kind.parts} notes={kind.partNotes} level="h3" />
    </div>
  </section>

  <CardRow title={s.connections.headline} lede={s.connections.line} items={neighbours} cols={4} ratio={4 / 3} />

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
</MiniSiteLayout>

<style>
  .bk-shelf { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .bk-shelf :global(.pills__list) { justify-content: center; }
</style>
