---
// 書庫 landing (v3, SITE.md "Pages"): the photograph hero with the bookmark, the editions photo
// row, the bookmark's rules as facts, the reading-position statement, writing and publishing
// beside the folded strip, the site's own pages and the neighbouring kinds as tile masonry, the
// eight parts, and the closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PhotoHero from '../../kit/components/PhotoHero.astro';
import PhotoRow from '../../kit/components/PhotoRow.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import TileMasonry from '../../kit/components/TileMasonry.astro';
import ProductCall from '../../kit/components/ProductCall.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindById, kindHref } from '../../kit/content';
import { kindFields } from '../../kit/theme';
import { pageHref } from '../../kit/sites';
import site from '../../content/sites/books';
import { pictures } from '../../sites/books/pictures';
import { tones } from '../../sites/books/tones';
import Parts from '../../sites/books/Parts.astro';
import '../../sites/books/books.css';

const s = site.strings.landing;
const href = (slug: string) => pageHref(site, site.pages.find((p) => p.slug === slug)!);

// The site's own pages in the greens of its photographs: the Work page in the accent, the rest
// from the deepest green to the sage of the bookmark (src/sites/books/tones.ts).
const tileTone = { work: tones.accent, wiki: tones.deep, editions: tones.green, library: tones.sage, serial: tones.deepest, publish: tones.olive };
const pageTiles = s.pages.rows.map((r) => {
  const page = site.pages.find((p) => p.slug === r.slug)!;
  const tone = tileTone[r.slug as keyof typeof tileTone];
  return { id: r.slug, name: page.label, line: r.line, href: href(r.slug), bg: tone.bg, on: tone.on };
});

const kindTiles = s.connections.tiles.map((t) => ({
  id: t.kind,
  name: kindById(t.kind).name,
  line: t.line,
  href: kindHref(t.kind),
  bg: kindFields[t.kind].field,
  on: kindFields[t.kind].on,
}));

---
<MiniSiteLayout>
  <PhotoHero title={s.hero.headline} lede={s.hero.lede} image={{ ...pictures.hero, alt: s.hero.alt }} bar>
    <ProductCall />
  </PhotoHero>

  <PhotoRow
    eyebrow={s.editions.label}
    title={s.editions.headline}
    body={[s.editions.lead, s.editions.caption]}
    link={{ href: href('editions'), text: s.editions.link }}
    image={{ ...pictures.editions, alt: s.editions.alt }}
  />

  <Section eyebrow={s.progress.label} title={s.progress.headline} lead={s.progress.lead}>
    <FactList items={s.progress.steps} />
  </Section>

  <Statement text={s.reading.text} sub={s.reading.sub} />

  <PhotoRow
    side="left"
    eyebrow={s.writing.label}
    title={s.writing.headline}
    body={s.writing.body}
    link={{ href: href('serial'), text: s.writing.link }}
    image={{ ...pictures.serial, alt: s.writing.alt }}
  />

  <Section eyebrow={s.pages.label} title={s.pages.headline}>
    <TileMasonry
      slot="wide"
      label={s.pages.headline}
      items={pageTiles}
      columns={[
        [{ id: 'work', h: 5 }, { id: 'library', h: 3 }],
        [{ id: 'wiki', h: 4 }, { id: 'serial', h: 4 }],
        [{ id: 'editions', h: 4.5 }, { id: 'publish', h: 3.5 }],
      ]}
      phone={[[{ id: 'work' }], [{ id: 'wiki' }, { id: 'editions' }], [{ id: 'library' }, { id: 'serial' }], [{ id: 'publish' }]]}
      height={520}
    />
  </Section>

  <Section eyebrow={s.parts.label} title={s.parts.headline} lead={s.parts.lead}>
    <Parts />
  </Section>

  <Section eyebrow={s.connections.label} title={s.connections.headline} lead={s.connections.lead}>
    <TileMasonry
      slot="wide"
      label={s.connections.headline}
      items={kindTiles}
      columns={[[{ id: 'anime', h: 3 }, { id: 'manga', h: 2 }], [{ id: 'visual-novels', h: 1 }], [{ id: 'games', h: 1 }]]}
      height={420}
    />
  </Section>

  <Closing title={site.strings.common.closing.title} body={site.strings.common.closing.body} />
</MiniSiteLayout>
