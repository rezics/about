---
// 書庫 landing (DESIGN.md "Direction v2": Swiss grid, flat tiles): the hero with the wall of the
// site's own pages, the reading figure and its six steps, one work's editions as tiles (示意),
// the ink band on reading position, the kinds of books, writing and publishing, the eight parts,
// the neighbouring kinds, the next page and the closing block in the books field.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import HeroWall from '../../kit/components/HeroWall.astro';
import Sec from '../../kit/components/Sec.astro';
import TextCols from '../../kit/components/TextCols.astro';
import TileRow from '../../kit/components/TileRow.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Band from '../../kit/components/Band.astro';
import PartsList from '../../kit/components/PartsList.astro';
import Pills from '../../kit/components/Pills.astro';
import ProductCall from '../../kit/components/ProductCall.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindById, kindHref } from '../../kit/content';
import { kindFields } from '../../kit/theme';
import { accentRamp } from '../../kit/color';
import { pageWall } from '../../kit/pageWall';
import { pageHref } from '../../kit/sites';
import Progress from '../../sites/books/Progress.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.landing;
const L = s.labels;
const kind = kindById('books');
const accent = kindFields.books.field;
const pageBy = (slug: string) => site.pages.find((p) => p.slug === slug)!;
const wall = pageWall(site, accent, s.pages.rows);
const ramp = accentRamp(accent);
const editions = s.editions.tiles.map((t, i) => ({ name: t.name, line: t.line, rel: '示意', ...ramp[[0, 2, 4, 1][i] ?? 0]! }));
const neighbours = s.connections.squares.map((c) => ({
  name: kindById(c.kind).name,
  tag: kindById(c.kind).tag,
  line: c.label,
  href: kindHref(c.kind),
  bg: kindFields[c.kind].field,
  on: kindFields[c.kind].on,
}));
---
<MiniSiteLayout>
  <HeroWall label={site.name} title={s.hero.headline} lede={s.hero.lede} items={wall.items} wide={wall.wide} phone={wall.phone} phoneHeight={860} bar>
    <ProductCall />
    <a class="link-draw" href="#bookmark">{s.hero.secondary}</a>
  </HeroWall>

  <Sec id="bookmark" label={L.bookmark} title={s.bookmark.headline}>
    <div class="bk-stack">
      <p class="text">{s.bookmark.intro}</p>
      <Progress />
    </div>
    <ItemGrid slot="wide" items={s.bookmark.steps} cols={3} numbered />
  </Sec>

  <Sec label={L.editions} title={s.editions.headline}>
    <p class="text">{s.editions.lede}</p>
    <div slot="wide" class="bk-stack">
      <TileRow items={editions} cols={4} label={s.editions.headline} />
      <p class="bk-note">{s.editions.caption}</p>
    </div>
  </Sec>

  <Band label={L.reading} title={s.reading.headline} text={s.reading.body.join('')}>
    <p class="bk-band-link"><a class="link-draw" href={pageHref(site, pageBy('wiki'))}>{s.reading.link}</a></p>
  </Band>

  <Sec label={s.shelf.headline}>
    <div class="bk-stack">
      <p class="text">{s.shelf.caption}</p>
      <Pills items={s.shelf.words} tone="tint" />
    </div>
  </Sec>

  <Sec label={L.writing} title={s.writing.headline}>
    <TextCols paragraphs={s.writing.body} />
    <div class="bk-links">
      <a class="link-draw" href={pageHref(site, pageBy('serial'))}>{s.writing.links[0]}</a>
      <a class="link-draw" href={pageHref(site, pageBy('publish'))}>{s.writing.links[1]}</a>
    </div>
  </Sec>

  <Sec label={L.parts} title={s.parts.headline}>
    <div class="bk-stack">
      <p class="text">{s.parts.caption}</p>
      <PartsList parts={kind.parts} notes={kind.partNotes} level="h3" />
    </div>
  </Sec>

  <Sec label={L.connections} title={s.connections.headline}>
    <p class="text">{s.connections.line}</p>
    <TileRow slot="wide" items={neighbours} cols={4} label={s.connections.headline} />
  </Sec>

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
  <Closing bg={accent} />
</MiniSiteLayout>

<style>
  .bk-band-link { grid-column: 8 / 13; margin-top: 28px; }
</style>
