---
// Wiki+ (src/sites/books/SITE.md, page 2): full-bleed band, the four steps, read to your chapter
// (position control, chapter rail, entries), what REZICS never receives, the wiki's routes,
// how review works.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import Section from '../../kit/components/Section.astro';
import Square from '../../kit/components/Square.astro';
import Finale from '../../kit/components/Finale.astro';
import { kindFields } from '../../kit/theme';
import { pageHref } from '../../kit/sites';
import Picture from '../../sites/books/Picture.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.wiki;
const p = s.position;
const next = site.pages.find((pg) => pg.slug === 'editions')!;
const total = p.positions[p.positions.length - 1]!.chapter;
const chapters = Array.from({ length: total }, (_, i) => i + 1);
const marks = new Set(p.positions.map((x) => x.chapter));
const routeField = { field: '#e1e9e3', on: 'ink' } as const;
---
<MiniSiteLayout>
  <!-- S1 Hero: full-bleed field band -->
  <Section mood="none" band="field" labelledby="wi-title" class="wih">
    <div class="wih__text">
      <h1 id="wi-title" class="t-xl wih__title" data-split="lines" data-intro>{s.hero.headline}</h1>
      <p class="lede">{s.hero.lede}</p>
    </div>
    <div class="wih__pic">
      <Picture name="books-wiki" alt={s.hero.alt} eager sizes="(max-width: 767px) 92vw, 36vw" />
    </div>
  </Section>

  <!-- S2 From one file to a wiki: a row of four squares (a real sequence) -->
  <Section mood="normal" labelledby="wi-flow" class="wif">
    <h2 id="wi-flow" class="col-full t-l">{s.flow.headline}</h2>
    <ol class="col-full wif__strip" role="list" data-reveal="slot">
      {s.flow.frames.map((f, i) => (
        <li class="wif__frame" style={`--i:${i}`}>
          <div class="wif__square">
            <span class="wif__n" aria-hidden="true">{i + 1}</span>
            <h3 class="wif__name">{f.title}</h3>
          </div>
          <p class="wif__body">{f.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- S3 Read to your chapter: position control, chapter rail, entries -->
  <Section mood="normal" labelledby="wi-pos" class="wip">
    <div class="col-1-8 wip__head">
      <h2 id="wi-pos" class="t-l">{p.headline}</h2>
      <p class="muted">{p.intro}</p>
    </div>
    <div class="col-full wip__stage" data-position>
      <div class="wip__control js-only" role="group" aria-label={p.control}>
        {p.positions.map((pos) => (
          <button type="button" class="wip__pos" data-pos={pos.chapter} aria-pressed="false">{pos.label}</button>
        ))}
      </div>
      <div class="wip__rail" data-rail data-total={total} style={`--pos:${total};--total:${total}`} role="img" aria-label={p.rail}>
        {chapters.map((c) => <span class:list={['wip__ch', marks.has(c) && 'wip__ch--mark']}></span>)}
        <span class="wip__mark" aria-hidden="true"></span>
      </div>
      <div class="wip__panel">
        <div class="wip__groups">
          {(['people', 'events'] as const).map((g) => (
            <section class="wip__group" data-group aria-label={p.groups[g]}>
              <h3 class="wip__group-title">{p.groups[g]}</h3>
              <ul role="list" class="wip__entries">
                {p.entries.filter((e) => e.group === g).map((e) => (
                  <li class="wip__entry" data-entry data-chapter={e.chapter}>
                    <span class="wip__name">{e.name}</span>
                    {e.aliases && <span class="wip__aliases">{p.aliases}{e.aliases}</span>}
                    <span class="wip__note">{e.note}</span>
                    <span class="wip__source mono">{p.source.replace('{n}', String(e.chapter))}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <div class="wip__side">
          <p class="wip__status" aria-live="polite" data-status data-pattern={p.status} data-all={p.statusAll}>{p.statusAll}</p>
          <ul role="list" class="wip__rules">
            {p.rules.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <!-- S4 REZICS never receives the text: statement + fine print -->
  <Section mood="airy" band="ink" labelledby="wi-text" class="wit">
    <h2 id="wi-text" class="col-1-10 t-mega wit__statement" data-split="lines">{s.text.statement}</h2>
    <ul class="col-5-12 wit__facts" role="list">
      {s.text.facts.map((f) => <li>{f}</li>)}
    </ul>
  </Section>

  <!-- S5 What a wiki holds: gallery wall of route squares around the Work page -->
  <Section mood="normal" labelledby="wi-zone" class="wiz">
    <div class="col-1-4 wiz__text">
      <h2 id="wi-zone" class="t-l">{s.zone.headline}</h2>
      <p>{s.zone.body}</p>
    </div>
    <div class="col-5-12 wiz__wall" data-reveal="slot">
      <div class="wiz__hub">
        <Square name={s.zone.squares[0]!} field={kindFields.books} />
        <p class="wiz__hub-note">{s.zone.hub}</p>
      </div>
      {s.zone.squares.slice(1).map((name) => (
        <div class="wiz__route"><Square name={name} field={routeField} /></div>
      ))}
    </div>
  </Section>

  <!-- S6 Agents propose, people review: data/facts -->
  <Section mood="normal" labelledby="wi-rev" class="wir">
    <h2 id="wi-rev" class="col-full t-l">{s.review.headline}</h2>
    <dl class="col-full wir__states">
      {s.review.states.map((st) => (
        <div class="wir__state">
          <dt class="wir__word">{st.title}</dt>
          <dd class="wir__def">{st.body}</dd>
        </div>
      ))}
    </dl>
    <ul class="col-5-12 wir__rules" role="list">
      {s.review.rules.map((r) => <li>{r}</li>)}
    </ul>
  </Section>

  <Finale label={s.finaleLead} name={next.label} href={pageHref(site, next)} field={kindFields.books} />
</MiniSiteLayout>

<script>
  import { initPosition } from '../../sites/books/position';
  initPosition();
</script>

<style>
  /* S1 */
  .wih { padding-block: clamp(32px, 5vw, 72px); }
  .wih :global(.sec__grid) { align-items: center; }
  .wih__text { grid-column: 1 / span 7; display: flex; flex-direction: column; gap: 24px; }
  .wih__title { max-width: 11em; }
  .wih__pic { grid-column: 9 / span 4; }
  @media (max-width: 767px) {
    .wih__text, .wih__pic { grid-column: 1 / -1; }
    .wih__pic { order: -1; max-width: 360px; }
  }

  /* S2 */
  .wif__strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
  .wif__frame { display: flex; flex-direction: column; gap: 16px; }
  .wif__square {
    position: relative;
    aspect-ratio: 1;
    container-type: inline-size;
    padding: 7cqi;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-top: 2px solid var(--field);
  }
  .wif__frame:nth-child(1) .wif__square { background: var(--bk-t08); }
  .wif__frame:nth-child(2) .wif__square { background: var(--bk-t16); }
  .wif__frame:nth-child(3) .wif__square { background: var(--bk-t32); }
  .wif__frame:nth-child(4) .wif__square { background: var(--field); color: var(--on-field); }
  .wif__n { font-family: 'Archivo', sans-serif; font-weight: 800; font-stretch: 125%; font-size: 26cqi; line-height: 0.9; }
  .wif__name { font-weight: 900; font-size: clamp(1.125rem, 11cqi, 2rem); line-height: 1.2; }
  .wif__body { max-width: 24em; }
  @media (max-width: 899px) {
    .wif__strip { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; }
    .wif__frame { scroll-snap-align: start; }
  }

  /* S3 */
  .wip__head { display: flex; flex-direction: column; gap: 12px; }
  .wip__stage { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 24px); }
  :global(html:not(.js)) .js-only { display: none; }
  .wip__control { display: flex; flex-wrap: wrap; gap: 6px; }
  .wip__pos {
    position: relative;
    min-height: 44px;
    padding: 0 16px;
    border: 1.5px solid var(--field);
    font-weight: 700;
    color: var(--field);
    overflow: clip;
    isolation: isolate;
    transition: color var(--d-s) var(--ease-snap);
  }
  .wip__pos::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--field);
    clip-path: inset(100% 0 0 0);
    transition: clip-path var(--d-m) var(--ease-snap);
  }
  .wip__pos[aria-pressed='true'] { color: var(--on-field); }
  .wip__pos[aria-pressed='true']::before { clip-path: inset(0 0 0 0); }
  @media (hover: hover) { .wip__pos:hover::before { clip-path: inset(0 0 0 0); } .wip__pos:hover { color: var(--on-field); } }
  .wip__pos:focus-visible::before { clip-path: inset(0 0 0 0); }
  .wip__pos:focus-visible { color: var(--on-field); }
  .wip__rail {
    position: relative;
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(var(--total), minmax(0, 1fr));
    gap: 2px;
    height: 34px;
    padding-bottom: 12px;
  }
  .wip__ch { background: var(--bk-t16); }
  .wip__ch--mark { background: var(--bk-t32); }
  .wip__mark {
    position: absolute;
    top: -6px;
    bottom: 0;
    left: 0;
    translate: calc(var(--pos) / var(--total) * 100cqi - 1.5px) 0;
    width: 3px;
    background: var(--c-mark);
  }
  .wip__mark::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 10px; height: 10px; margin-left: -5px; background: var(--c-mark); }
  .wip__panel { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--gutter); align-items: start; }
  .wip__groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); }
  .wip__group-title { font-weight: 700; color: var(--c-muted); font-size: var(--t-s); padding-bottom: 8px; border-bottom: 2px solid var(--field); }
  .wip__entries { display: flex; flex-direction: column; }
  .wip__entry { display: grid; gap: 2px; padding: 14px 0; border-bottom: 1px solid var(--c-line-strong); }
  .wip__name { font-weight: 900; font-size: var(--t-m); line-height: 1.3; }
  .wip__aliases { font-size: var(--t-s); color: var(--c-muted); }
  .wip__note { font-size: var(--t-body); }
  .wip__source { color: var(--field); font-weight: 700; }
  .wip__side { display: flex; flex-direction: column; gap: 20px; padding: 20px; background: var(--bk-t08); border-top: 2px solid var(--field); }
  .wip__status { font-weight: 700; }
  .wip__rules { display: flex; flex-direction: column; gap: 12px; font-size: var(--t-s); }
  .wip__rules li { padding-left: 14px; border-left: 2px solid var(--bk-t32); }
  @media (max-width: 899px) {
    .wip__panel { grid-template-columns: 1fr; }
    .wip__groups { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .wip__rail { gap: 1px; }
  }

  /* S4 */
  .wit__statement { max-width: 8em; }
  .wit__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px var(--gutter); }
  .wit__facts li { padding-top: 14px; border-top: 1px solid var(--c-line-strong); }
  @media (max-width: 767px) { .wit__facts { grid-template-columns: 1fr; } }

  /* S5 */
  .wiz__text { display: flex; flex-direction: column; gap: 16px; }
  .wiz__wall { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(8px, 1vw, 14px); align-items: start; }
  .wiz__hub { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; gap: 10px; }
  .wiz__hub-note { font-weight: 700; font-size: var(--t-s); }
  .wiz__route :global(.sq) { border: 1px solid var(--c-line-strong); }
  @media (max-width: 767px) {
    .wiz__wall { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .wiz__hub { grid-column: 1 / -1; grid-row: auto; }
  }

  /* S6 */
  .wir__states { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); border-top: 2px solid var(--c-fg); }
  .wir__state { padding-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .wir__word { font-weight: 900; font-size: var(--t-l); line-height: 1.1; letter-spacing: var(--track-display); color: var(--field); }
  .wir__def { margin: 0; }
  .wir__rules { display: flex; flex-direction: column; gap: 12px; }
  .wir__rules li { padding-left: 16px; border-left: 3px solid var(--field); }
  @media (max-width: 767px) { .wir__states { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 24px; } }
</style>
