---
// 書庫 Wiki+ (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head, from a file to a
// Wiki in four steps, the reading position (示意), the ink band on what REZICS never receives,
// the Wiki as a Zone, review, the next page and the closing block.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Pills from '../../kit/components/Pills.astro';
import Band from '../../kit/components/Band.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields } from '../../kit/theme';
import Position from '../../sites/books/Position.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.wiki;
const accent = kindFields.books.field;
const page = site.pages.find((p) => p.slug === 'wiki')!;
---
<MiniSiteLayout>
  <PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

  <Sec label="01" title={s.flow.headline}>
    <ItemGrid slot="wide" items={s.flow.frames} cols={4} numbered />
  </Sec>

  <Sec label="02" title={s.position.headline}>
    <p class="text">{s.position.intro}</p>
    <div slot="wide" class="bk-stack">
      <Position />
      <ul class="bk-notes">{s.position.rules.map((r) => <li>{r}</li>)}</ul>
    </div>
  </Sec>

  <Band label={page.label} title={s.text.statement}>
    <ul class="wk-facts" role="list">{s.text.facts.map((f) => <li>{f}</li>)}</ul>
  </Band>

  <Sec label="03" title={s.zone.headline}>
    <div class="bk-stack">
      <p class="text">{s.zone.body}</p>
      <Pills items={s.zone.squares} tone="tint" />
      <p class="bk-note">{s.zone.hub}</p>
    </div>
  </Sec>

  <Sec label="04" title={s.review.headline}>
    <div slot="wide" class="bk-stack">
      <ItemGrid items={s.review.states} cols={4} look="cards" />
      <ul class="bk-notes">{s.review.rules.map((r) => <li>{r}</li>)}</ul>
    </div>
  </Sec>

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
  <Closing bg={accent} />
</MiniSiteLayout>

<style>
  .wk-facts { grid-column: 1 / 13; margin-top: 56px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--gutter); }
  .wk-facts li { padding: 18px 0; border-top: 1px solid rgb(249 246 242 / 0.22); font-size: 16px; line-height: 1.8; color: rgb(249 246 242 / 0.86); }
  @media (max-width: 767px) { .wk-facts { grid-template-columns: minmax(0, 1fr); margin-top: 32px; } }
</style>
