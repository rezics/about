---
// Wiki+ (v3, SITE.md "Pages"): the heading and lede beside the cut-out photograph; the way from
// a file to a wiki in four steps; the reading-position figure and its rules; the statement
// that REZICS never receives the text, with four facts; a wiki's pages as tiles (示意); agents
// propose and people review; the closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import TileMasonry from '../../kit/components/TileMasonry.astro';
import Closing from '../../kit/components/Closing.astro';
import NextPage from '../../sites/books/NextPage.astro';
import PhotoHead from '../../sites/books/PhotoHead.astro';
import Notes from '../../sites/books/Notes.astro';
import Position from '../../sites/books/Position.astro';
import site from '../../content/sites/books';
import { pictures } from '../../sites/books/pictures';
import { tones } from '../../sites/books/tones';
import '../../sites/books/books.css';

const s = site.strings.wiki;
// The Work page in the accent, the wiki's own pages in the other greens (示意, not links).
const zoneTones = [tones.accent, tones.deep, tones.green, tones.olive, tones.sage, tones.deepest];
const zoneTiles = s.zone.tiles.map((t, i) => ({ id: `z${i}`, name: t.name, line: t.line, ...zoneTones[i]! }));
---
<MiniSiteLayout>
  <PhotoHead label={site.name} title={s.hero.headline} lede={s.hero.lede} image={{ ...pictures.wiki, alt: s.hero.alt }} />

  <Section eyebrow={s.flow.label} title={s.flow.headline}>
    <FactList items={s.flow.steps} numbered />
  </Section>

  <Section eyebrow={s.position.label} title={s.position.headline} lead={s.position.lead}>
    <Position />
    <Notes items={s.position.rules} />
  </Section>

  <Statement text={s.text.text} sub={s.text.sub}>
    <div class="bk-under"><FactList items={s.text.facts} /></div>
  </Statement>

  <Section eyebrow={s.zone.label} title={s.zone.headline} lead={s.zone.lead}>
    <div slot="wide">
      <TileMasonry
        label={s.zone.headline}
        items={zoneTiles}
        columns={[
          [{ id: 'z0', h: 1 }],
          [{ id: 'z1', h: 1 }, { id: 'z2', h: 1 }],
          [{ id: 'z3', h: 1 }, { id: 'z4', h: 1 }, { id: 'z5', h: 1 }],
        ]}
        phone={[[{ id: 'z0' }], [{ id: 'z1' }, { id: 'z2' }], [{ id: 'z3' }, { id: 'z4' }, { id: 'z5' }]]}
        height={420}
      />
      <p class="bk-note bk-note--wide">{s.zone.caption}</p>
    </div>
  </Section>

  <Section eyebrow={s.review.label} title={s.review.headline} lead={s.review.lead}>
    <FactList items={s.review.states} />
    <Notes items={s.review.rules} />
  </Section>

  <NextPage slug="wiki" lead={s.finaleLead} />

  <Closing title={site.strings.common.closing.title} body={site.strings.common.closing.body} />
</MiniSiteLayout>
