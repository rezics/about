---
// 書庫 閱讀紀錄 (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head, three readings
// of one book, moving in and out, the shelf as flat tiles, the ink band on "continue", privacy,
// the next page and the closing block.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Table from '../../kit/components/Table.astro';
import Band from '../../kit/components/Band.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields } from '../../kit/theme';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.library;
const accent = kindFields.books.field;
const page = site.pages.find((p) => p.slug === 'library')!;
---
<MiniSiteLayout>
  <PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

  <Sec label="01" title={s.reads.headline}>
    <div class="bk-stack">
      <p class="text">{s.reads.body}</p>
      <Table columns={s.reads.columns} rows={s.reads.rows} caption={s.reads.caption} label={s.reads.headline} />
    </div>
  </Sec>

  <Sec label="02" title={s.move.headline}>
    <p class="text">{s.move.statement}</p>
    <ItemGrid slot="wide" items={s.move.steps} cols={4} numbered />
  </Sec>

  <Band label={page.label} title={s.continue.poster} text={s.continue.body} />

  <Sec label="03" title={s.shelf.headline}>
    <ItemGrid slot="wide" items={s.shelf.squares} cols={3} look="cards" />
  </Sec>

  <Sec label="04" title={s.privacy.statement}>
    <ul class="bk-notes">{s.privacy.facts.map((f) => <li>{f}</li>)}</ul>
  </Sec>

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
  <Closing bg={accent} />
</MiniSiteLayout>
