---
// 閱讀紀錄 (v3, SITE.md "Pages"): the heading and lede beside the three strips; three reads of
// one book as strips; moving in and out; the statement on the Continue row; the shelf; privacy; the closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import Closing from '../../kit/components/Closing.astro';
import NextPage from '../../sites/books/NextPage.astro';
import PhotoHead from '../../sites/books/PhotoHead.astro';
import Reads from '../../sites/books/Reads.astro';
import site from '../../content/sites/books';
import { pictures } from '../../sites/books/pictures';
import '../../sites/books/books.css';

const s = site.strings.library;
---
<MiniSiteLayout>
  <PhotoHead label={site.name} title={s.hero.headline} lede={s.hero.lede} image={{ ...pictures.library, alt: s.hero.alt }} />

  <Section eyebrow={s.reads.label} title={s.reads.headline} lead={s.reads.lead}>
    <Reads />
  </Section>

  <Section eyebrow={s.move.label} title={s.move.headline}>
    <FactList items={s.move.steps} numbered />
    <p class="bk-note">{s.move.retention}</p>
  </Section>

  <Statement text={s.continue.text} sub={s.continue.sub} note={s.continue.note} />

  <Section eyebrow={s.shelf.label} title={s.shelf.headline}>
    <FactList items={s.shelf.rows} />
  </Section>

  <Section eyebrow={s.privacy.label} title={s.privacy.headline}>
    <FactList items={s.privacy.rows} />
  </Section>

  <NextPage slug="library" lead={s.finaleLead} />

  <Closing title={site.strings.common.closing.title} body={site.strings.common.closing.body} />
</MiniSiteLayout>
