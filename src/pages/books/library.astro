---
// 書庫 閱讀紀錄 (DESIGN.md "Direction v2"): the intro beside the lending desk, three readings of
// one book, moving in and out, the shelf, the "continue" statement, privacy, and the next page.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageIntro from '../../kit/components/PageIntro.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Table from '../../kit/components/Table.astro';
import Statement from '../../kit/components/Statement.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.library;
---
<MiniSiteLayout>
  <PageIntro title={s.hero.headline} lede={s.hero.lede} image={{ base: '/images/sites/books/lending', alt: s.hero.alt, ratio: 1 }} />

  <section class="bk-sec" aria-labelledby="reads-title">
    <div class="container bk-two lb-reads">
      <SectionHead id="reads-title" title={s.reads.headline} lede={s.reads.body} />
      <Table columns={s.reads.columns} rows={s.reads.rows} caption={s.reads.caption} label={s.reads.headline} />
    </div>
  </section>

  <section class="bk-sec" aria-labelledby="move-title">
    <div class="container bk-stack">
      <SectionHead id="move-title" title={s.move.headline} />
      <ItemGrid items={s.move.steps} cols={4} numbered />
      <p class="lb-note" data-reveal="up">{s.move.statement}</p>
    </div>
  </section>

  <section class="bk-sec" aria-labelledby="shelf-title">
    <div class="container bk-stack">
      <SectionHead id="shelf-title" title={s.shelf.headline} />
      <ItemGrid items={s.shelf.squares} cols={3} look="cards" />
    </div>
  </section>

  <Statement text={s.continue.poster} sub={s.continue.body} />

  <section class="bk-sec" aria-labelledby="privacy-title">
    <div class="container bk-two lb-privacy">
      <SectionHead id="privacy-title" title={s.privacy.statement} />
      <ul class="bk-notes" data-reveal="up">
        {s.privacy.facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
</MiniSiteLayout>

<style>
  .lb-reads, .lb-privacy { align-items: start; }
  .lb-privacy :global(.bk-notes) { color: var(--c-fg); }
  .lb-note { max-width: 46em; padding: 18px 22px; border-radius: var(--r-lg); background: var(--tint); }
</style>
