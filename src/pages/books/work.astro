---
// 作品頁 (v3, SITE.md "Pages"): the heading and lede; the example's title page and the eight
// blocks with their examples; the one primary action; what a rating names; what you edit and
// what you propose; the statement on languages; the closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import Closing from '../../kit/components/Closing.astro';
import NextPage from '../../sites/books/NextPage.astro';
import ExampleFacts from '../../sites/books/ExampleFacts.astro';
import TitlePage from '../../sites/books/TitlePage.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.work;
---
<MiniSiteLayout>
  <PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

  <Section eyebrow={s.sections.label} title={s.sections.headline} lead={s.sections.lead}>
    <TitlePage />
    <ExampleFacts items={s.sections.rows} />
  </Section>

  <Section eyebrow={s.action.label} title={s.action.headline} lead={s.action.lead}>
    <FactList items={s.action.rows} />
    <p class="bk-note">{s.action.caption}</p>
  </Section>

  <Section eyebrow={s.ratings.label} title={s.ratings.headline} lead={s.ratings.lead}>
    <FactList items={s.ratings.rows} />
  </Section>

  <Section eyebrow={s.edit.label} title={s.edit.headline}>
    <FactList items={s.edit.rows} />
  </Section>

  <Statement text={s.languages.text} sub={s.languages.sub} note={s.languages.note} />

  <NextPage slug="work" lead={s.finaleLead} />

  <Closing title={site.strings.common.closing.title} body={site.strings.common.closing.body} />
</MiniSiteLayout>
