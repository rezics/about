---
// 書庫 版本與系列 (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head, four kinds of
// release as flat tiles, translations and their states, what stays the same work, publication
// and reading order, the ink band on ISBNs, the next page and the closing block.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Pills from '../../kit/components/Pills.astro';
import Table from '../../kit/components/Table.astro';
import Band from '../../kit/components/Band.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields } from '../../kit/theme';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.editions;
const accent = kindFields.books.field;
const page = site.pages.find((p) => p.slug === 'editions')!;
const reading = s.orders.reading.map((i) => s.orders.squares[i]!);
---
<MiniSiteLayout>
  <PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

  <Sec label="01" title={s.releases.headline}>
    <p class="text">{s.releases.caption}</p>
    <ItemGrid slot="wide" items={s.releases.quarters} cols={4} look="cards" />
  </Sec>

  <Sec label="02" title={s.translations.headline}>
    <div class="bk-stack">
      <Pills items={s.translations.states} label={s.translations.stateLabel} tone="tint" ordered />
      <ul class="bk-notes">{s.translations.notes.map((n) => <li>{n}</li>)}</ul>
    </div>
    <ItemGrid slot="wide" items={s.translations.rows} cols={4} />
  </Sec>

  <Sec label="03" title={s.sameWork.headline}>
    <div class="bk-stack">
      <p class="text">{s.sameWork.intro}</p>
      <Table columns={s.sameWork.columns} rows={s.sameWork.rows} caption={s.sameWork.caption} label={s.sameWork.headline} />
    </div>
  </Sec>

  <Sec label="04" title={s.orders.headline}>
    <div class="bk-stack">
      <Pills items={s.orders.squares} label={s.orders.rows[0]} ordered />
      <Pills items={reading} label={s.orders.rows[1]} tone="tint" ordered />
      <ul class="bk-notes">{s.orders.notes.map((n) => <li>{n}</li>)}</ul>
    </div>
  </Sec>

  <Band label={page.label} title={s.isbn.poster} text={s.isbn.body}>
    <p class="ed-example">{s.isbn.example}</p>
  </Band>

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
  <Closing bg={accent} />
</MiniSiteLayout>

<style>
  .ed-example { grid-column: 8 / 13; margin-top: 24px; font-size: 15px; line-height: 1.8; color: rgb(249 246 242 / 0.8); }
</style>
