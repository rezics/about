---
// 版本與系列 (src/sites/books/SITE.md, page 3): poster hero with the editions picture, four kinds
// of release in a 田 grid, translations, the same-Work ledger, two orders, find it by ISBN.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import Section from '../../kit/components/Section.astro';
import Finale from '../../kit/components/Finale.astro';
import { kindFields } from '../../kit/theme';
import { pageHref } from '../../kit/sites';
import Picture from '../../sites/books/Picture.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.editions;
const o = s.orders;
const next = site.pages.find((p) => p.slug === 'library')!;
---
<MiniSiteLayout>
  <!-- S1 Hero: poster with picture -->
  <Section mood="normal" labelledby="ed-title" class="edh">
    <h1 id="ed-title" class="col-full t-xl edh__title" data-split="lines" data-intro>{s.hero.headline}</h1>
    <div class="col-5-8 edh__pic">
      <Picture name="books-editions" alt={s.hero.alt} eager sizes="(max-width: 767px) 92vw, 30vw" />
    </div>
    <p class="col-9-12 lede edh__lede">{s.hero.lede}</p>
  </Section>

  <!-- S2 Four kinds of release: one square cut in four -->
  <Section mood="normal" labelledby="ed-rel" class="edr">
    <div class="col-1-4 edr__text">
      <h2 id="ed-rel" class="t-l">{s.releases.headline}</h2>
      <p class="muted">{s.releases.caption}</p>
    </div>
    <ul class="col-5-12 edr__tian" role="list" data-reveal="slot">
      {s.releases.quarters.map((q) => (
        <li class="edr__q">
          <h3 class="edr__name">{q.title}</h3>
          <p class="edr__body">{q.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- S3 Translations: index list + passage states -->
  <Section mood="normal" labelledby="ed-tr" class="edt">
    <h2 id="ed-tr" class="col-1-8 t-l">{s.translations.headline}</h2>
    <dl class="col-full edt__rows">
      {s.translations.rows.map((r) => (
        <div class="edt__row">
          <dt class="edt__name">{r.title}</dt>
          <dd class="edt__body">{r.body}</dd>
        </div>
      ))}
    </dl>
    <div class="col-1-4 edt__label">{s.translations.stateLabel}</div>
    <ol class="col-5-12 edt__states" role="list" data-reveal="slot">
      {s.translations.states.map((st, i) => (
        <li class="edt__state" style={`--i:${i}`}><span>{st}</span></li>
      ))}
    </ol>
    <ul class="col-5-12 edt__notes" role="list">
      {s.translations.notes.map((n) => <li>{n}</li>)}
    </ul>
  </Section>

  <!-- S4 Same Work or two: ledger table -->
  <Section mood="normal" labelledby="ed-same" class="eds">
    <h2 id="ed-same" class="col-1-4 t-l">{s.sameWork.headline}</h2>
    <p class="col-5-8 eds__intro">{s.sameWork.intro}</p>
    <div class="col-full eds__wrap">
      <table class="eds__table">
        <thead>
          <tr><th scope="col">{s.sameWork.columns[0]}</th><th scope="col">{s.sameWork.columns[1]}</th></tr>
        </thead>
        <tbody>
          {s.sameWork.rows.map(([change, result]) => (
            <tr>
              <th scope="row">{change}</th>
              <td>{result}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="col-5-8 muted">{s.sameWork.caption}</p>
  </Section>

  <!-- S5 Two orders: one row that swaps order along the row -->
  <Section mood="normal" labelledby="ed-ord" class="edo">
    <h2 id="ed-ord" class="col-1-8 t-l">{o.headline}</h2>
    <div
      class="col-full edo__box"
      data-orders
      data-reading={o.reading.join(',')}
      data-publication={o.rows[0]}
      data-reading-name={o.rows[1]}
    >
      <div class="edo__live">
        <div class="edo__bar">
          <p class="edo__label" data-order-label aria-live="polite">{o.rows[0]}</p>
          <button type="button" class="btn btn--small edo__toggle" data-order-toggle aria-pressed="false" data-to-reading={o.toggle[0]} data-to-publication={o.toggle[1]}>
            <span class="btn__label"><span>{o.toggle[0]}</span><span aria-hidden="true">{o.toggle[0]}</span></span>
          </button>
        </div>
        <ol class="edo__row" role="list" data-order-row>
          {o.squares.map((sq, i) => (
            <li class:list={['edo__sq', i === 1 && 'edo__sq--extra']} data-sq><span>{sq}</span></li>
          ))}
        </ol>
      </div>
      <div class="edo__static">
        {[o.squares.map((_, i) => i), o.reading].map((order, r) => (
          <div class="edo__static-row">
            <p class="edo__label">{o.rows[r]}</p>
            <ol class="edo__row" role="list">
              {order.map((i) => <li class:list={['edo__sq', i === 1 && 'edo__sq--extra']}><span>{o.squares[i]}</span></li>)}
            </ol>
          </div>
        ))}
      </div>
    </div>
    <ul class="col-5-12 edo__notes" role="list">
      {o.notes.map((n) => <li>{n}</li>)}
    </ul>
  </Section>

  <!-- S6 Find it by ISBN: poster -->
  <Section mood="airy" band="field" labelledby="ed-isbn" class="edi">
    <h2 id="ed-isbn" class="col-full t-mega edi__poster" data-split="lines">{s.isbn.poster}</h2>
    <p class="col-5-8 edi__body">{s.isbn.body}</p>
    <p class="col-9-12 edi__example">{s.isbn.example}</p>
  </Section>

  <Finale label={s.finaleLead} name={next.label} href={pageHref(site, next)} field={kindFields.books} />
</MiniSiteLayout>

<script>
  import { initOrder } from '../../sites/books/order';
  initOrder();
</script>

<style>
  /* S1 */
  .edh { padding-top: clamp(32px, 5vw, 72px); }
  .edh__title { white-space: normal; }
  .edh__lede { align-self: end; }
  @media (max-width: 767px) { .edh__pic { max-width: 360px; } }

  /* S2 */
  .edr__text { display: flex; flex-direction: column; gap: 16px; }
  .edr__tian {
    width: min(100%, 760px);
    aspect-ratio: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    border: 2px solid var(--field);
  }
  .edr__q { container-type: inline-size; padding: clamp(16px, 7cqi, 36px); display: flex; flex-direction: column; gap: 12px; }
  .edr__q:nth-child(1) { border-right: 1px solid var(--field); border-bottom: 1px solid var(--field); }
  .edr__q:nth-child(2) { border-bottom: 1px solid var(--field); background: var(--bk-t08); }
  .edr__q:nth-child(3) { border-right: 1px solid var(--field); background: var(--bk-t08); }
  .edr__q:nth-child(4) { background: var(--field); color: var(--on-field); }
  .edr__name { font-weight: 900; font-size: clamp(1.125rem, 9cqi, 2rem); line-height: 1.15; }
  .edr__body { font-size: clamp(0.875rem, 4.6cqi, 1.0625rem); line-height: 1.65; }
  @media (max-width: 767px) {
    .edr__tian { aspect-ratio: auto; grid-template-columns: 1fr; grid-template-rows: none; }
    .edr__q { border-right: 0 !important; border-bottom: 1px solid var(--field); }
  }

  /* S3 */
  .edt__rows { border-top: 2px solid var(--c-fg); }
  .edt__row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--gutter); padding-block: 18px; border-bottom: 1px solid var(--c-line-strong); align-items: baseline; }
  .edt__name { font-weight: 900; font-size: var(--t-l); line-height: 1.15; }
  .edt__body { margin: 0; max-width: var(--measure); }
  .edt__label { font-weight: 700; align-self: center; }
  .edt__states { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .edt__state { aspect-ratio: 2 / 1; display: grid; place-items: center; font-weight: 700; border: 1.5px solid var(--field); }
  .edt__state:nth-child(2) { background: var(--bk-t16); }
  .edt__state:nth-child(3) { background: var(--bk-t32); }
  .edt__state:nth-child(4) { background: var(--field); color: var(--on-field); }
  .edt__notes { display: flex; flex-direction: column; gap: 12px; }
  .edt__notes li { padding-left: 16px; border-left: 3px solid var(--field); }
  @media (max-width: 767px) {
    .edt__row { grid-template-columns: 1fr; gap: 6px; }
    .edt__states { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* S4 */
  .eds__intro { align-self: end; }
  .eds__table { width: 100%; border-collapse: collapse; }
  .eds__table thead th { text-align: left; font-size: var(--t-s); color: var(--c-muted); font-weight: 700; padding: 0 0 10px; border-bottom: 2px solid var(--c-fg); }
  .eds__table tbody th, .eds__table td { text-align: left; padding: 16px 0; border-bottom: 1px solid var(--c-line-strong); vertical-align: top; }
  .eds__table tbody th { font-weight: 700; width: 50%; padding-right: var(--gutter); }
  .eds__table td { position: relative; padding-left: 22px; }
  .eds__table td::before { content: ''; position: absolute; left: 0; top: 24px; width: 10px; height: 10px; background: var(--field); }
  @media (max-width: 767px) {
    .eds__table thead { display: none; }
    .eds__table tr { display: grid; border-bottom: 1px solid var(--c-line-strong); padding-block: 12px; }
    .eds__table tbody th, .eds__table td { border: 0; padding-block: 4px; width: auto; }
  }

  /* S5 */
  .edo__live { display: none; }
  .edo__box.is-live .edo__live { display: block; }
  .edo__box.is-live .edo__static { display: none; }
  .edo__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .edo__label { font-weight: 900; font-size: var(--t-m); }
  .edo__static { display: flex; flex-direction: column; gap: 20px; }
  .edo__static-row { display: flex; flex-direction: column; gap: 10px; }
  .edo__row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(6px, 1vw, 14px); }
  .edo__sq {
    aspect-ratio: 1;
    container-type: inline-size;
    display: grid;
    place-items: center;
    background: var(--field);
    color: var(--on-field);
  }
  .edo__sq--extra { background: var(--bk-t16); color: var(--c-fg); border: 1.5px dashed var(--field); }
  .edo__sq span { font-weight: 900; font-size: 18cqi; line-height: 1; white-space: nowrap; }
  .edo__notes { display: flex; flex-direction: column; gap: 12px; }
  .edo__notes li { padding-left: 16px; border-left: 3px solid var(--field); }
  @media (min-width: 768px) { .edo__row { max-width: 880px; } }

  /* S6 */
  .edi__poster { max-width: 9em; }
  .edi__example { font-size: var(--t-s); line-height: 1.75; padding-top: 12px; border-top: 1px solid var(--c-line-strong); }
</style>
