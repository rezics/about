---
// 版本與系列 (v3, SITE.md "Pages"): the heading and lede beside the stack photograph; the four
// kinds of release; translations and their passage states; what keeps one work or makes two;
// the two orders as rows of tiles; the ISBN statement; the closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import Closing from '../../kit/components/Closing.astro';
import NextPage from '../../sites/books/NextPage.astro';
import PhotoHead from '../../sites/books/PhotoHead.astro';
import Notes from '../../sites/books/Notes.astro';
import Orders from '../../sites/books/Orders.astro';
import site from '../../content/sites/books';
import { pictures } from '../../sites/books/pictures';
import '../../sites/books/books.css';

const s = site.strings.editions;
---
<MiniSiteLayout>
  <PhotoHead label={site.name} title={s.hero.headline} lede={s.hero.lede} image={{ ...pictures.editions, alt: s.hero.alt }} />

  <Section eyebrow={s.releases.label} title={s.releases.headline} lead={s.releases.lead}>
    <FactList items={s.releases.kinds} />
  </Section>

  <Section eyebrow={s.translations.label} title={s.translations.headline}>
    <FactList items={s.translations.rows} />
    <div class="bk-states">
      <p class="bk-states__label">{s.translations.stateLabel}</p>
      <ol class="bk-states__list" role="list">
        {s.translations.states.map((st) => <li class="serif">{st}</li>)}
      </ol>
    </div>
    <Notes items={s.translations.notes} />
  </Section>

  <Section eyebrow={s.sameWork.label} title={s.sameWork.headline} lead={s.sameWork.lead}>
    <FactList items={s.sameWork.rows} level="p" />
    <p class="bk-note">{s.sameWork.caption}</p>
  </Section>

  <Section eyebrow={s.orders.label} title={s.orders.headline} lead={s.orders.lead}>
    <Orders />
    <FactList items={s.orders.notes} />
  </Section>

  <Statement text={s.isbn.text} sub={s.isbn.sub} note={s.isbn.note} />

  <NextPage slug="editions" lead={s.finaleLead} />

  <Closing title={site.strings.common.closing.title} body={site.strings.common.closing.body} />
</MiniSiteLayout>

<style>
  .bk-states { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 5fr); gap: 12px var(--gutter); align-items: center; margin-top: 40px; }
  .bk-states__label { font-size: 13px; color: var(--c-muted); letter-spacing: 0.04em; }
  .bk-states__list { display: flex; flex-wrap: wrap; gap: 8px 0; counter-reset: st; }
  .bk-states__list li { counter-increment: st; display: inline-flex; align-items: baseline; gap: 8px; font-size: 18px; font-weight: 600; }
  .bk-states__list li::before { content: counter(st, decimal-leading-zero); font-family: var(--f-body); font-size: 13px; font-weight: 400; color: var(--c-muted); }
  .bk-states__list li:not(:last-child)::after { content: ''; width: 28px; height: 1px; margin: 0 14px 0 6px; align-self: center; background: var(--c-line-strong, rgb(38 41 45 / 0.3)); }
  @media (max-width: 767px) { .bk-states { grid-template-columns: minmax(0, 1fr); } }
</style>
