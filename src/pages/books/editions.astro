---
// 書庫 版本與系列 (DESIGN.md "Direction v2"): the intro beside the shelves, four kinds of
// release, translations and their states, what stays the same work, publication and reading
// order, the ISBN statement, and the next page.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageIntro from '../../kit/components/PageIntro.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Pills from '../../kit/components/Pills.astro';
import Table from '../../kit/components/Table.astro';
import Statement from '../../kit/components/Statement.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.editions;
const reading = s.orders.reading.map((i) => s.orders.squares[i]!);
---
<MiniSiteLayout>
  <PageIntro title={s.hero.headline} lede={s.hero.lede} image={{ base: '/images/sites/books/shelves', alt: s.hero.alt, ratio: 1 }} />

  <section class="bk-sec" aria-labelledby="releases-title">
    <div class="container bk-stack">
      <SectionHead id="releases-title" title={s.releases.headline} lede={s.releases.caption} />
      <ItemGrid items={s.releases.quarters} cols={4} look="cards" />
    </div>
  </section>

  <section class="bk-sec" aria-labelledby="tr-title">
    <div class="container bk-stack">
      <SectionHead id="tr-title" title={s.translations.headline} />
      <ItemGrid items={s.translations.rows} cols={4} />
      <div class="bk-two ed-states">
        <Pills items={s.translations.states} label={s.translations.stateLabel} tone="tint" ordered />
        <ul class="bk-notes">
          {s.translations.notes.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bk-sec" aria-labelledby="same-title">
    <div class="container bk-stack">
      <SectionHead id="same-title" title={s.sameWork.headline} lede={s.sameWork.intro} />
      <Table columns={s.sameWork.columns} rows={s.sameWork.rows} caption={s.sameWork.caption} label={s.sameWork.headline} />
    </div>
  </section>

  <section class="bk-sec" aria-labelledby="orders-title">
    <div class="container bk-stack">
      <SectionHead id="orders-title" title={s.orders.headline} />
      <div class="bk-two ed-orders" data-reveal="slot">
        <div class="ed-order"><Pills items={s.orders.squares} label={s.orders.rows[0]} ordered /></div>
        <div class="ed-order"><Pills items={reading} label={s.orders.rows[1]} tone="tint" ordered /></div>
      </div>
      <ul class="bk-notes">
        {s.orders.notes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <Statement text={s.isbn.poster} sub={s.isbn.body}>
    <p class="bk-note ed-example">{s.isbn.example}</p>
  </Statement>

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
</MiniSiteLayout>

<style>
  .ed-states { align-items: start; }
  .ed-order { padding: 24px; border-radius: var(--r-card); background: var(--c-surface); border: 1px solid var(--c-line); box-shadow: var(--shadow-card); }
  .ed-order :global(.pills__list) { counter-reset: vol; }
  .ed-example { max-width: 34em; }
</style>
