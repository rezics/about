---
// 書庫 出版 (DESIGN.md "Direction v2"): the intro beside the bookshop table, buying a book in four
// steps, the creator's statement line by line, what is distributed here, the shop beside the
// community, and the next site.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageIntro from '../../kit/components/PageIntro.astro';
import SectionHead from '../../kit/components/SectionHead.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import ItemList from '../../kit/components/ItemList.astro';
import Statement from '../../kit/components/Statement.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.publish;
---
<MiniSiteLayout>
  <PageIntro title={s.hero.headline} lede={s.hero.lede} image={{ base: '/images/sites/books/shop', alt: s.hero.alt, ratio: 1 }} />

  <section class="bk-sec" aria-labelledby="buy-title">
    <div class="container bk-stack">
      <SectionHead id="buy-title" title={s.buy.headline} lede={s.buy.caption} />
      <ItemGrid items={s.buy.steps} cols={4} numbered />
    </div>
  </section>

  <ItemList title={s.statement.headline} lede={s.statement.note} items={s.statement.rows} />

  <section class="bk-sec" aria-labelledby="dist-title">
    <div class="container bk-stack">
      <SectionHead id="dist-title" title={s.distributed.headline} />
      <ItemGrid items={s.distributed.rows} cols={4} look="cards" />
      <ul class="bk-notes">
        {s.distributed.policy.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <Statement text={s.community.headline} sub={s.community.body}>
    <p class="bk-note pb-privacy">{s.community.privacy}</p>
  </Statement>

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
</MiniSiteLayout>

<style>
  .pb-privacy { max-width: 34em; }
</style>
