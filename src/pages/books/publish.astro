---
// 出版 (v3, SITE.md "Pages"): the heading and lede; buying one book in
// four steps; the creator's statement line by line; what is and is not distributed; the store
// beside the community; the closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import Closing from '../../kit/components/Closing.astro';
import NextPage from '../../sites/books/NextPage.astro';
import Contents from '../../sites/books/Contents.astro';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.publish;
---
<MiniSiteLayout>
  <PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />
  <Contents items={[s.buy, s.statement, s.distributed]} />

  <Section eyebrow={s.buy.label} title={s.buy.headline}>
    <FactList items={s.buy.steps} numbered />
    <p class="bk-note">{s.buy.caption}</p>
  </Section>

  <Section eyebrow={s.statement.label} title={s.statement.headline}>
    <FactList items={s.statement.rows} />
    <p class="bk-note">{s.statement.note}</p>
  </Section>

  <Section eyebrow={s.distributed.label} title={s.distributed.headline}>
    <FactList items={s.distributed.rows} />
    <FactList items={s.distributed.policy} class="bk-gap" />
  </Section>

  <Statement text={s.community.text} sub={s.community.sub} note={s.community.note} />

  <NextPage slug="publish" lead={s.finaleLead} />

  <Closing title={site.strings.common.closing.title} body={site.strings.common.closing.body} />
</MiniSiteLayout>
