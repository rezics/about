---
// 連載 (v3, SITE.md "Pages"): the heading and lede; the folded strip beside the four safeguards
// of a manuscript; what a reader sees when the author acts; the AI declaration; the world beside
// the manuscript; the backup statement; the closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import PhotoRow from '../../kit/components/PhotoRow.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Statement from '../../kit/components/Statement.astro';
import Closing from '../../kit/components/Closing.astro';
import NextPage from '../../sites/books/NextPage.astro';
import Facts from '../../sites/books/Facts.astro';
import Notes from '../../sites/books/Notes.astro';
import site from '../../content/sites/books';
import { pictures } from '../../sites/books/pictures';
import '../../sites/books/books.css';

const s = site.strings.serial;
---
<MiniSiteLayout>
  <PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

  <PhotoRow eyebrow={s.safe.label} title={s.safe.headline} image={{ ...pictures.serial, alt: s.safe.alt }} />
  <Facts items={s.safe.rows} />

  <Section eyebrow={s.mirror.label} title={s.mirror.headline}>
    <FactList items={s.mirror.rows} />
    <Notes items={s.mirror.notes} />
  </Section>

  <Section eyebrow={s.ai.label} title={s.ai.headline}>
    <FactList items={s.ai.rows} />
    <Notes items={s.ai.notes} />
  </Section>

  <Section eyebrow={s.world.label} title={s.world.headline} lead={s.world.lead}>
    <Notes items={s.world.items} />
  </Section>

  <Statement text={s.backup.text} sub={s.backup.sub} note={s.backup.note} />

  <NextPage slug="serial" lead={s.finaleLead} />

  <Closing title={site.strings.common.closing.title} body={site.strings.common.closing.body} />
</MiniSiteLayout>
