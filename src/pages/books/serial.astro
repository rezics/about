---
// 書庫 連載 (DESIGN.md "Direction v2": Swiss grid, flat tiles): the page head, drafts that do not
// get lost, the writer and the reader side by side, AI disclosure as flat tiles, the world beside
// the draft, the ink band on backup, the next page and the closing block.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import Sec from '../../kit/components/Sec.astro';
import ItemGrid from '../../kit/components/ItemGrid.astro';
import Pills from '../../kit/components/Pills.astro';
import Table from '../../kit/components/Table.astro';
import Band from '../../kit/components/Band.astro';
import SiteFinale from '../../kit/components/SiteFinale.astro';
import Closing from '../../kit/components/Closing.astro';
import { kindFields } from '../../kit/theme';
import site from '../../content/sites/books';
import '../../sites/books/books.css';

const s = site.strings.serial;
const accent = kindFields.books.field;
const page = site.pages.find((p) => p.slug === 'serial')!;
---
<MiniSiteLayout>
  <PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

  <Sec label="01" title={s.safe.headline}>
    <ItemGrid slot="wide" items={s.safe.pairs} cols={4} />
  </Sec>

  <Sec label="02" title={s.mirror.headline}>
    <div class="bk-stack">
      <Table columns={s.mirror.columns} rows={s.mirror.rows} label={s.mirror.headline} />
      <ul class="bk-notes">{s.mirror.notes.map((n) => <li>{n}</li>)}</ul>
    </div>
  </Sec>

  <Sec label="03" title={s.ai.headline}>
    <ul class="bk-notes">{s.ai.notes.map((n) => <li>{n}</li>)}</ul>
    <ItemGrid slot="wide" items={s.ai.squares} cols={3} look="cards" />
  </Sec>

  <Sec label="04" title={s.world.headline}>
    <div class="bk-stack">
      <p class="text">{s.world.body}</p>
      <Pills items={s.world.squares} tone="tint" />
      <ul class="bk-notes">{s.world.items.map((n) => <li>{n}</li>)}</ul>
    </div>
  </Sec>

  <Band label={page.label} title={s.backup.statement} text={s.backup.body} />

  <SiteFinale nextPage={site.strings.common.nextPage} nextSite={site.strings.common.nextSite} body={s.finaleLead} />
  <Closing bg={accent} />
</MiniSiteLayout>
