---
// 製作與演出 (v3): one voice actor across kinds beside the threaded sheets, one credit and its
// five parts, and a studio's years.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import PhotoRow from '../../kit/components/PhotoRow.astro';
import Closing from '../../kit/components/Closing.astro';
import Onward from '../../sites/anime/Onward.astro';
import PhotoPreload from '../../kit/components/PhotoPreload.astro';
import site from '../../content/sites/anime';
import { sectionPhoto } from '../../sites/anime/pictures';
import { kindTile, pageTile } from '../../sites/anime/tiles';
import '../../sites/anime/anime.css';

const s = site.strings.credits;
const photo = sectionPhoto(s.voice.photo);
const voicePhoto = { ...photo, phone: { src: photo.src, widths: [640], width: 640, height: 427 } };
---
<MiniSiteLayout>
  <PhotoPreload slot="head" image={voicePhoto} />
  <PageHead label={site.name} title={s.head.headline} lede={s.head.lede} />

  <PhotoRow priority side="left" eyebrow={s.voice.eyebrow} title={s.voice.headline} body={s.voice.body} image={voicePhoto} />

  <Section eyebrow={s.record.eyebrow} title={s.record.headline}>
    <FactList items={s.record.rows} />
  </Section>

  <Section eyebrow={s.studio.eyebrow} title={s.studio.headline} lead={s.studio.lead} />

  <Onward title={s.next} tiles={[pageTile('adaptations', 0), kindTile('manga')]} />

  <Closing title={s.closing.headline} body={s.closing.body} />
</MiniSiteLayout>
