---
// 關聯 (v3): named, directed relations; the neighbouring kinds; one identity for the people
// who make software; relations need a source. Ends on the next site. Plan: SITE.md "v3".
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import Section from '../../kit/components/Section.astro';
import PhotoRow from '../../kit/components/PhotoRow.astro';
import Statement from '../../kit/components/Statement.astro';
import FactList from '../../kit/components/FactList.astro';
import TileMasonry from '../../kit/components/TileMasonry.astro';
import Closing from '../../kit/components/Closing.astro';
import Body from '../../sites/software/Body.astro';
import Next from '../../sites/software/Next.astro';
import PhonePhotoPreload from '../../sites/software/PhonePhotoPreload.astro';
import site from '../../content/sites/software';
import { kindById } from '../../kit/content';
import { kindTile, sectionPicture } from '../../sites/software/site';

const s = site.strings.connections;
const { common, pictures } = site.strings;
const kindRows = s.kinds.rows.map((r) => ({ title: kindById(r.kind).name, body: r.body }));
const kindTiles = s.kinds.rows.map((r) => kindTile(r.kind, r.line));
const kindColumns = kindTiles.map((t) => [{ id: t.id, h: 1 }]);
const kindPhone = [kindTiles.slice(0, 2).map((t) => ({ id: t.id })), kindTiles.slice(2).map((t) => ({ id: t.id }))];
const nextKind = site.next as 'visual-novels';
const next = [kindTile(nextKind)];
---
<MiniSiteLayout>
  <PhonePhotoPreload image={sectionPicture(pictures.tabs)} />
  <PageHead label={site.name} title={s.hero.headline} lede={s.hero.lede} />

  <PhotoRow side="left" eyebrow={s.relations.label} title={s.relations.headline} body={s.relations.lead} image={sectionPicture(pictures.tabs)} />
  <Body>
    <FactList items={s.relations.rows} />
  </Body>

  <Section eyebrow={s.kinds.label} title={s.kinds.headline}>
    <FactList items={kindRows} />
    <TileMasonry slot="wide" items={kindTiles} columns={kindColumns} phone={kindPhone} height={240} label={s.kinds.label} />
  </Section>

  <Section eyebrow={s.people.label} title={s.people.headline} lead={s.people.lead} />

  <Statement text={s.statement.text} sub={s.statement.sub} />

  <Next label={common.nextSite} items={next} />
  <Closing title={s.closing} />
</MiniSiteLayout>
