---
// 發表 (第 6 話, SITE.md "v3"): the intro, the standing folded sheet beside the five steps from
// manuscript to reader, what the author decides, serials from elsewhere, the next site and the
// closing.
import MiniSiteLayout from '../../kit/layouts/MiniSiteLayout.astro';
import PageHead from '../../kit/components/PageHead.astro';
import PhotoRow from '../../kit/components/PhotoRow.astro';
import PhotoPreload from '../../kit/components/PhotoPreload.astro';
import Section from '../../kit/components/Section.astro';
import FactList from '../../kit/components/FactList.astro';
import Closing from '../../kit/components/Closing.astro';
import RowList from '../../sites/manga/RowList.astro';
import NextChapter from '../../sites/manga/NextChapter.astro';
import { photo } from '../../sites/manga/pictures';
import { nextAfter } from '../../sites/manga/next';
import site from '../../content/sites/manga';
import '../../sites/manga/navigation.css';

const s = site.strings.publish;
---
<MiniSiteLayout>
  <PhotoPreload slot="head" image={photo(s.steps.picture)} />
  <PageHead label={s.intro.eyebrow} title={s.intro.headline} lede={s.intro.lede} />

  <PhotoRow priority eyebrow={s.steps.eyebrow} title={s.steps.heading} body={s.steps.lead} image={photo(s.steps.picture)} />
  <RowList><FactList items={s.steps.items} numbered /></RowList>

  <Section eyebrow={s.decides.eyebrow} title={s.decides.heading}>
    <FactList items={s.decides.items} />
  </Section>

  <Section eyebrow={s.elsewhere.eyebrow} title={s.elsewhere.heading} lead={s.elsewhere.lead} />

  <NextChapter {...nextAfter('publish', s.closing)} />
  <Closing title={s.closing.statement} body="" />
</MiniSiteLayout>
