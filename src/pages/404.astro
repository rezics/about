---
// 404 (DESIGN.md "Direction v2"): the page head on the Swiss grid and a way home.
import PageLayout from '../kit/layouts/PageLayout.astro';
import PageHead from '../kit/components/PageHead.astro';
import ProductCall from '../kit/components/ProductCall.astro';
import { site } from '../kit/content';

const nf = site.notFound;
---
<PageLayout meta={nf.meta} noindex>
  <PageHead label={site.name} title={nf.headline} lede={nf.body} class="nf">
    <ProductCall href="/" label={nf.back} />
  </PageHead>
</PageLayout>
<style>
  .nf { min-height: 60svh; }
</style>
