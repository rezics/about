---
// 404 (DESIGN.md "Direction v2"): the centred intro and a way home.
import PageLayout from '../kit/layouts/PageLayout.astro';
import PageIntro from '../kit/components/PageIntro.astro';
import ProductCall from '../kit/components/ProductCall.astro';
import { site } from '../kit/content';

const nf = site.notFound;
---
<PageLayout meta={nf.meta} noindex>
  <PageIntro title={nf.headline} lede={nf.body} class="nf">
    <ProductCall href="/" label={nf.back} />
  </PageIntro>
</PageLayout>
<style>
  .nf { min-height: 50svh; }
</style>
