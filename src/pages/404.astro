---
// 404 (v3): one photograph (a sheet with a piece cut out), one sentence, the way home; then the
// nine kinds as one quiet row of tiles to start again.
import PageLayout from '../kit/layouts/PageLayout.astro';
import PhotoHero from '../kit/components/PhotoHero.astro';
import Section from '../kit/components/Section.astro';
import TileMasonry from '../kit/components/TileMasonry.astro';
import ProductCall from '../kit/components/ProductCall.astro';
import Closing from '../kit/components/Closing.astro';
import { kinds, site } from '../kit/content';
import { kindTiles, oneRow } from '../kit/tiles';

const nf = site.notFound;
const tiles = kindTiles(kinds.map((k) => k.id)).map((t) => ({ ...t, line: undefined }));
const columns = oneRow(tiles);
const phone = [0, 2, 4, 6, 8].map((i) => tiles.slice(i, i + 2).map((t) => ({ id: t.id })));
---
<PageLayout meta={nf.meta} noindex>
  <PhotoHero
    eyebrow={nf.eyebrow}
    title={nf.headline}
    lede={nf.body}
    class="nf"
    image={{
      src: '/images/home/missing', widths: [960, 1920], width: 1920, height: 1280,
      alt: nf.imageAlt, position: '0% 50%',
      phone: { src: '/images/home/missing-phone', widths: [640, 960], width: 960, height: 640 },
    }}
  >
    <ProductCall href="/" label={nf.back} />
  </PhotoHero>
  <Section title={nf.restart} class="nf-kinds">
    <TileMasonry slot="wide" items={tiles} columns={columns} phone={phone} height={168} phoneRow={104} size="m" label={nf.restart} />
  </Section>
  <Closing body="" />
</PageLayout>
<style>
  :global(section.phero.nf) { --hero-h: min(calc(100svh - var(--header-h)), 720px); }
  :global(.nf-kinds .section__title) { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); }
  :global(.nf-kinds .section__wide) { margin-top: 48px; }
  :global(.nf-kinds .tile__name--latin) { --tile-name: clamp(1rem, 1.4vw, 1.25rem); }
  /* The prose tail binder also sees tile names; narrow tiles need to wrap the four CJK
     characters instead of holding the entire label on one line. */
  :global(.nf-kinds .tile__name .nw) { white-space: normal; word-break: normal; }
  @media (min-width: 768px) and (max-width: 1439px) {
    :global(.nf-kinds .masonry) { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(3, 120px); gap: 3px; height: auto; margin: 0; }
    :global(.nf-kinds .masonry__cell) { grid-column: auto; grid-row: auto; padding: 0; }
  }
  @media (max-width: 1023px) {
    :global(.nf-kinds .tile) { --pad: 12px; }
  }
  @media (max-width: 767px) {
    :global(.nf-kinds .tile__name--latin) { --tile-name: 20px; }
  }
</style>
