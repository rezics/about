---
// 404: one empty square in the grid, the cursor waiting in it, and a way home.
import PageLayout from '../kit/layouts/PageLayout.astro';
import EmptySquare from '../kit/components/EmptySquare.astro';
import Section from '../kit/components/Section.astro';
import { kinds, site } from '../kit/content';
import { kindFields } from '../kit/theme';

const nf = site.notFound;
---
<PageLayout meta={nf.meta} noindex>
  <Section mood="normal" class="nf">
    <div class="col-1-5 nf__text">
      <h1 class="t-xl">{nf.headline}</h1>
      <p class="lede">{nf.body}</p>
      <p><a class="btn" href="/"><span class="btn__label"><span>{nf.back}</span></span></a></p>
    </div>
    <div class="col-7-12 nf__grid" aria-hidden="true">
      {kinds.slice(0, 4).map((k) => <span class="nf__cell" style={`background:${kindFields[k.id].field}`}></span>)}
      <EmptySquare class="nf__empty" />
      {kinds.slice(4, 8).map((k) => <span class="nf__cell" style={`background:${kindFields[k.id].field}`}></span>)}
    </div>
  </Section>
</PageLayout>
<style>
  .nf { min-height: calc(100svh - var(--header-h)); display: grid; align-content: center; }
  .nf__text { display: flex; flex-direction: column; gap: 24px; align-self: center; }
  .nf__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .nf__cell { aspect-ratio: 1; opacity: 0.16; }
</style>
