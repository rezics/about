---
/**
 * The document every page shares: head (SEO, Open Graph, JSON-LD, fonts), the skip link, the
 * persistent transition veil, the global header, an optional bar, <main> and the footer.
 * Pages use PageLayout or MiniSiteLayout, which wrap this.
 */
import { ClientRouter } from 'astro:transitions';
import { site } from '../content';
import { ogPath } from '../seo';
import { locale, localized, titleSeparator } from '../locale';
import { locales, ogLocales } from '../locales';
import type { Field } from '../theme';
import { fieldStyle } from '../theme';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeaderPanels from '../components/HeaderPanels.astro';
import '../../styles/tokens.css';
import '../../styles/engine.css';
import '../../styles/base.css';
// Manrope, the product's Latin interface face, self-hosted from its package (Latin subset only).
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

interface Props {
  /** Page title without the site name; omit on the home page. */
  title?: string;
  description: string;
  /** Colours for the page (a kind's or module's field), exposed as --field and --on-field. */
  field?: Field;
  /** data-site on <body>, for a mini-site's own CSS. */
  siteId?: string;
  kind?: string;
  noindex?: boolean;
  /** End on the footer's closing panel (default); a page with its own closing panel turns it off. */
  action?: boolean;
}
const { title, description, field, siteId, kind, noindex = false, action = true } = Astro.props;
const path = Astro.url.pathname;
const origin = Astro.site ?? new URL(site.url);
const fullTitle = title ? `${title}${titleSeparator}${site.name}` : site.meta.title;
const canonical = new URL(localized(path), origin).href;
const ogImage = new URL(localized(ogPath(path === '/404.html' ? '/404/' : path)), origin).href;
// Every page exists in every locale; x-default is the unprefixed path, which picks a locale.
const alternates = noindex ? [] : [...locales.map((l) => ({ hreflang: l, href: new URL(localized(path, l), origin).href })), { hreflang: 'x-default', href: new URL(path, origin).href }];
const isHome = path === '/';
const websiteId = new URL('/#website', origin).href;
const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        { '@type': 'Organization', '@id': new URL('/#organization', origin).href, name: site.name, url: origin.href, logo: new URL('/favicon.svg', origin).href },
        { '@type': 'WebSite', '@id': websiteId, name: site.name, url: origin.href, inLanguage: locale, description },
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: fullTitle,
      url: canonical,
      description,
      inLanguage: locale,
      isPartOf: { '@type': 'WebSite', '@id': websiteId, name: site.name, url: origin.href },
    };
---
<!doctype html>
<html lang={locale} transition:animate="none" data-site={siteId} data-kind={kind}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#efe9e0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:'Manrope Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${manrope}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`} />
    <meta name="rezics:fonts" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      // A language chosen in the menu is remembered for the unprefixed paths, which pick a locale.
      document.addEventListener('click', (e) => {
        const a = e.target instanceof Element && e.target.closest('a[data-locale]');
        if (a) document.cookie = `rezics_locale=${a.dataset.locale}; path=/; max-age=31536000; samesite=lax; secure`;
      });
    </script>
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body data-site={siteId} data-kind={kind} style={field ? fieldStyle(field) : undefined}>
    <a class="skip-link" href="#main">{site.nav.skip}</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"></div>
    <Header path={path} />
    <slot name="bar" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer action={action} />
    <HeaderPanels path={path} />
    <script>
      import { start } from '../../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
