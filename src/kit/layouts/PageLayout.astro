---
/** A plain page (home, 404, /notified/): the shared document with no site bar. */
import type { Meta } from '../../content/schema';
import type { Field } from '../theme';
import BaseLayout from './BaseLayout.astro';

interface Props {
  meta: Meta;
  /** The home page uses meta.title as the whole document title. */
  home?: boolean;
  field?: Field;
  noindex?: boolean;
}
const { meta, home = false, field, noindex } = Astro.props;
---
<BaseLayout title={home ? undefined : meta.title} description={meta.description} field={field} noindex={noindex}>
  <slot />
</BaseLayout>
