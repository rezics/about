---
/** A plain page (home, 404, /notified/): the shared document with no site bar. */
import type { Meta } from '../../content/schema';
import type { Field } from '../theme';
import BaseLayout from './BaseLayout.astro';

interface Props {
  meta: Meta;
  /** The home page uses meta.title as the whole document title. */
  home?: boolean;
  field?: Field;
  noindex?: boolean;
  /** End on the footer's action square (default true). */
  action?: boolean;
}
const { meta, home = false, field, noindex, action } = Astro.props;
---
<BaseLayout title={home ? undefined : meta.title} description={meta.description} field={field} noindex={noindex} action={action}>
  <slot />
</BaseLayout>
