---
/**
 * A section's heading block: an h2 (or h3), an optional line under it and an optional link
 * (slot). `align="center"` centres it over a centred section.
 */
interface Props {
  title: string;
  lede?: string;
  align?: 'start' | 'center';
  level?: 'h2' | 'h3';
  id?: string;
  class?: string;
}
import Clauses from '../Clauses.astro';
const { title, lede, align = 'start', level: Tag = 'h2', id, class: className } = Astro.props;
---
<div class:list={['shead', `shead--${align}`, className]} data-reveal="up">
  <Tag id={id} class:list={[Tag === 'h2' ? 't-h2' : 't-h3', 'shead__title']}><Clauses text={title} /></Tag>
  {lede && <p class="shead__lede">{lede}</p>}
  {Astro.slots.has('default') && <div class="shead__more"><slot /></div>}
</div>
<style>
  .shead { display: flex; flex-direction: column; gap: 16px; max-width: 46em; }
  .shead--center { align-items: center; text-align: center; margin-inline: auto; }
  .shead :global(.t-h2) { font-size: var(--t-h2); font-weight: 600; line-height: 1.28; }
  .shead__lede { color: var(--c-text); font-size: var(--t-body); line-height: 1.85; }
  .shead__more { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 4px; }
</style>
