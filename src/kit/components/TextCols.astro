---
/** Running text in two columns (the mock's `.cols`): 17 px at 1.85 in the text grey. Phones: one. */
interface Props {
  paragraphs: string[];
  class?: string;
}
const { paragraphs, class: className } = Astro.props;
---
<div class:list={['tcols', className]}>{paragraphs.map((p) => <p>{p}</p>)}</div>
<style>
  .tcols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px var(--gutter); font-size: var(--t-body); line-height: var(--lh-text); color: var(--c-text); }
  @media (max-width: 767px) { .tcols { grid-template-columns: minmax(0, 1fr); gap: 14px; } }
</style>
