---
/**
 * Titled items in two to four columns, each under a hairline (DESIGN.md "Direction v2": inner
 * pages use the same parts with more text). `numbered` sets a small step number in the accent
 * tint before each title, for sequences. `cards` sets each item on a tinted card instead.
 * Phones: one column.
 */
interface Item {
  title: string;
  body?: string;
  /** A short line above the title (a platform, a chapter). */
  label?: string;
}
interface Props {
  items: Item[];
  cols?: 2 | 3 | 4 | 5;
  numbered?: boolean;
  look?: 'lines' | 'cards';
  level?: 'h3' | 'h4';
  class?: string;
}
const { items, cols = 3, numbered = false, look = 'lines', level: Tag = 'h3', class: className } = Astro.props;
const List = numbered ? 'ol' : 'ul';
---
<List class:list={['items', `items--${look}`, numbered && 'items--numbered', className]} role="list" style={`--item-cols:${cols}`} data-reveal="slot">
  {items.map((item, i) => (
    <li class="items__item">
      {numbered && <span class="items__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}
      {item.label && <p class="items__label label">{item.label}</p>}
      <Tag class="items__title">{item.title}</Tag>
      {item.body && <p class="items__body">{item.body}</p>}
    </li>
  ))}
</List>
<style>
  .items { display: grid; grid-template-columns: repeat(var(--item-cols), minmax(0, 1fr)); gap: 28px var(--gutter); }
  .items__item { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .items--lines .items__item { padding-top: 18px; border-top: 1px solid var(--c-line); }
  /* Flat tiles in a tint of the accent, 3 px apart. */
  .items--cards { gap: 3px; }
  .items--cards .items__item { padding: clamp(18px, 1.8vw, 26px); background: var(--tint-strong); }
  .items__n { font-family: var(--f-latin), var(--f-cjk); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; color: var(--c-muted); }
  .items__label { color: var(--c-muted); }
  .items__title { font-size: 18px; font-weight: 600; line-height: 1.5; }
  .items__body { color: var(--c-text); font-size: 16px; line-height: 1.8; }
  @media (max-width: 1023px) {
    .items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .items { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .items--cards { gap: 3px; }
  }
</style>
