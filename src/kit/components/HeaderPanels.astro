---
/**
 * The header's two dropdown panels (產品, 模組) and the phone sheet, rendered at the end of the
 * document by BaseLayout. The panels are native popovers opened by the header's tab buttons
 * (popovertarget); the sheet is a modal <dialog> opened by the 選單 button (invoker commands,
 * script fallback in src/kit/motion/nav.ts).
 *
 * v3 (V3-SPEC "Dropdown panels"): a full-width area under the header, a short introduction on
 * paper and near-seamless flat tiles (3 px apart) in the muted kind colours (modules in ink
 * tints) with the name in the serif and a subtle paper grain; on hover the tone shifts, the name
 * rises and an arrow slides in (Tile).
 */
import { kinds, modules, site, kindHref, moduleHref } from '../content';
import { kindFields, moduleFields } from '../theme';
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import Tile from './Tile.astro';
import Clauses from '../Clauses.astro';

const nav = site.nav;
---
<div class="nav-layers">
  <div id="panel-products" class="panel" popover data-panel>
    <ul class="ptiles ptiles--products" role="list">
      <li class="ptiles__intro">
        <p class="panel__title serif"><Clauses text={nav.productsIntro.title} /></p>
        <p class="panel__body">{nav.productsIntro.body}</p>
        <a class="panel__all link-draw" href="/#products">{nav.productsIntro.all}<Arrow /></a>
      </li>
      {kinds.map((k) => (
        <li>
          <Tile name={k.name} line={k.summary} href={kindHref(k.id)} bg={kindFields[k.id].field} on={kindFields[k.id].on} size="m" grain />
        </li>
      ))}
    </ul>
  </div>

  <div id="panel-engine" class="panel" popover data-panel>
    <ul class="ptiles ptiles--engine" role="list">
      <li class="ptiles__intro">
        <p class="panel__title serif"><Clauses text={nav.engineIntro.title} /></p>
        <p class="panel__body">{nav.engineIntro.body}</p>
        <a class="panel__all link-draw" href="/engine/">{nav.engineIntro.all}<Arrow /></a>
      </li>
      {modules.map((m) => (
        <li>
          <Tile name={m.name} line={m.summary} href={moduleHref(m.id)} bg={moduleFields[m.id].field} on={moduleFields[m.id].on} size="m" grain />
        </li>
      ))}
    </ul>
  </div>

  <dialog id="menu" class="sheet" aria-label={nav.menu} data-menu>
    <div class="sheet__top">
      <Logo label={site.name} />
      <button type="button" class="sheet__close" command="close" commandfor="menu" data-menu-close>{nav.close}</button>
    </div>
    <div class="sheet__body">
      <p class="sheet__label eyebrow">{nav.products}</p>
      <ul class="sheet__tiles" role="list">
        {kinds.map((k) => (
          <li>
            <Tile name={k.name} href={kindHref(k.id)} bg={kindFields[k.id].field} on={kindFields[k.id].on} size="m" grain />
          </li>
        ))}
      </ul>
      <p class="sheet__label eyebrow">{nav.engine}</p>
      <ul class="sheet__list" role="list">
        <li><a class="serif" href="/engine/">{nav.engineIntro.all}</a></li>
        {modules.map((m) => (
          <li><a class="serif" href={moduleHref(m.id)}>{m.name}</a></li>
        ))}
      </ul>
      <ul class="sheet__list sheet__list--main" role="list">
        <li><a class="serif" href="/developers/">{nav.developers}</a></li>
        <li><a class="serif" href="/roadmap/">{nav.roadmap}</a></li>
        <li><a class="serif" href={site.productUrl}>{nav.action}</a></li>
      </ul>
    </div>
  </dialog>
</div>
<style>
  .panel {
    position: fixed;
    inset: var(--header-h) 0 auto 0;
    width: 100%;
    max-width: none;
    max-height: calc(100dvh - var(--header-h));
    margin: 0;
    padding: 0 var(--gutter) var(--gutter);
    border: 0;
    border-radius: 0;
    background: var(--c-bg);
    color: var(--c-fg);
    overflow: auto;
    overscroll-behavior: contain;
    opacity: 1;
    translate: 0 0;
    transition: opacity 0.2s var(--ease-soft), translate 0.28s var(--ease-snap), overlay 0.28s allow-discrete, display 0.28s allow-discrete;
  }
  .panel:not(:popover-open) { opacity: 0; translate: 0 -6px; }
  @starting-style {
    .panel:popover-open { opacity: 0; translate: 0 -6px; }
  }
  .panel::backdrop { background: color-mix(in srgb, var(--c-fg) 12%, transparent); }
  .ptiles { display: grid; gap: 3px; padding: 0; margin: 0; list-style: none; }
  .ptiles--products { grid-template-columns: repeat(5, minmax(0, 1fr)); grid-auto-rows: clamp(148px, 19vh, 196px); }
  .ptiles--engine { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: clamp(176px, 24vh, 232px); }
  .ptiles > li { display: flex; min-width: 0; }
  .ptiles > li > :global(.tile) { flex: 1 1 auto; }
  .ptiles__intro {
    flex-direction: column;
    gap: 10px;
    padding: 18px 28px 20px 0;
  }
  .panel__title { font-size: 22px; line-height: 1.45; }
  .panel__body { color: var(--c-text); font-size: 14px; line-height: 1.8; }
  .panel__all { align-self: flex-start; margin-top: auto; font-size: 14px; }
  @media (max-width: 1100px) {
    .ptiles--engine { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Phone sheet */
  .sheet {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) 40px;
    border: 0;
    background: var(--c-bg);
    color: var(--c-fg);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .sheet::backdrop { background: var(--c-bg); }
  .sheet__top { display: flex; justify-content: space-between; align-items: center; height: var(--header-h); }
  .sheet__close { display: inline-flex; align-items: center; min-height: 44px; padding: 0 2px; color: var(--c-fg); font-size: 14px; font-weight: 600; }
  .sheet__label { margin: 28px 0 12px; }
  .sheet__tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 92px; gap: 3px; }
  .sheet__tiles > li { display: flex; min-width: 0; }
  .sheet__tiles > li > :global(.tile) { flex: 1 1 auto; --pad: 12px; }
  .sheet__tiles :global(.tile__name) { --t-tile: 17px; }
  .sheet__list { border-top: 1px solid var(--c-line); }
  .sheet__list a { display: flex; align-items: center; min-height: 54px; border-bottom: 1px solid var(--c-line); font-size: 19px; }
  .sheet__list--main { margin-top: 28px; }
</style>
