---
/**
 * The header's two dropdown panels (產品, 模組) and the phone sheet, rendered at the end of the
 * document by BaseLayout. The panels are native popovers opened by the header's tab buttons
 * (popovertarget); the sheet is a modal <dialog> opened by the 選單 button (invoker commands,
 * script fallback in src/kit/motion/nav.ts). The flat square tiles live here, the one place
 * squares stay in v2.
 */
import { kinds, modules, site, kindHref, moduleHref, kindImage } from '../content';
import { kindFields, moduleFields } from '../theme';
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import Square from './Square.astro';
import Clauses from '../Clauses.astro';

const nav = site.nav;
---
<div class="nav-layers">
  <div id="panel-products" class="panel" popover data-panel>
    <ul class="ptiles ptiles--products" role="list">
      <li class="ptiles__intro">
        <p class="panel__title"><Clauses text={nav.productsIntro.title} /></p>
        <p class="panel__body">{nav.productsIntro.body}</p>
        <a class="panel__all link-draw" href="/#products">{nav.productsIntro.all}<Arrow /></a>
      </li>
      {kinds.map((k) => (
        <li>
          <Square name={k.name} field={kindFields[k.id]} mode="image" href={kindHref(k.id)} image={{ base: kindImage(k.id), alt: k.imageAlt }} description={k.summary} sizes="(min-width: 900px) 20vw, 33vw"><span class="ptile__arrow" aria-hidden="true"><svg viewBox="0 0 16 16" focusable="false"><path d="M2 8h10.5M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg></span></Square>
        </li>
      ))}
    </ul>
  </div>

  <div id="panel-engine" class="panel" popover data-panel>
    <ul class="ptiles ptiles--engine" role="list">
      <li class="ptiles__intro">
        <p class="panel__title"><Clauses text={nav.engineIntro.title} /></p>
        <p class="panel__body">{nav.engineIntro.body}</p>
        <a class="panel__all link-draw" href="/engine/">{nav.engineIntro.all}<Arrow /></a>
      </li>
      {modules.map((m) => (
        <li>
          <Square name={m.name} field={moduleFields[m.id]} mode="plain" href={moduleHref(m.id)} description={m.summary}><span class="ptile__arrow" aria-hidden="true"><svg viewBox="0 0 16 16" focusable="false"><path d="M2 8h10.5M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg></span></Square>
        </li>
      ))}
    </ul>
  </div>

  <dialog id="menu" class="sheet" aria-label={nav.menu} data-menu>
    <div class="sheet__top">
      <Logo label={site.name} />
      <button type="button" class="sheet__close" command="close" commandfor="menu" data-menu-close>{nav.close}</button>
    </div>
    <div class="sheet__body">
      <p class="sheet__label label">{nav.products}</p>
      <ul class="sheet__squares" role="list">
        {kinds.map((k) => (
          <li>
            <Square name={k.name} field={kindFields[k.id]} mode="image" href={kindHref(k.id)} image={{ base: kindImage(k.id), alt: k.imageAlt }} sizes="33vw" />
          </li>
        ))}
      </ul>
      <p class="sheet__label label">{nav.engine}</p>
      <ul class="sheet__list" role="list">
        <li><a href="/engine/">{nav.engineIntro.all}</a></li>
        {modules.map((m) => (
          <li><a href={moduleHref(m.id)}>{m.name}</a></li>
        ))}
      </ul>
      <ul class="sheet__list sheet__list--main" role="list">
        <li><a href="/developers/">{nav.developers}</a></li>
        <li><a href="/roadmap/">{nav.roadmap}</a></li>
      </ul>
    </div>
  </dialog>
</div>
<style>
  /* Panels: a full-width area that opens under the header bar, filled edge to edge with the
     flat square tiles packed almost seamlessly (3 px), no radius, no shadow: the one place
     squares stay. Each kind tile carries its print with the name on it; module tiles are flat
     colour. On hover and focus the print settles closer or the colour rises, the name steps
     forward and an arrow arrives; a click presses the tile briefly. */
  .panel {
    position: fixed;
    inset: var(--header-h) 0 auto 0;
    width: 100%;
    max-width: none;
    max-height: calc(100dvh - var(--header-h));
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--c-bg);
    color: var(--c-fg);
    overflow: auto;
    overscroll-behavior: contain;
    opacity: 1;
    translate: 0 0;
    transition: opacity 0.18s var(--ease-soft), translate 0.24s var(--ease-snap), overlay 0.24s allow-discrete, display 0.24s allow-discrete;
  }
  .panel:not(:popover-open) { opacity: 0; translate: 0 -6px; }
  @starting-style {
    .panel:popover-open { opacity: 0; translate: 0 -6px; }
  }
  .panel::backdrop { background: color-mix(in srgb, var(--c-fg) 10%, transparent); }
  .ptiles { display: grid; gap: 3px; padding: 0; margin: 0; list-style: none; }
  .ptiles--products { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .ptiles--engine { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .ptiles > li { min-width: 0; }
  .ptiles__intro {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(18px, 2vw, 32px);
    background: var(--c-soft);
  }
  .panel__title { font-size: var(--t-h3); font-weight: 500; line-height: 1.4; }
  .panel__body { color: var(--c-muted); font-size: var(--t-s); line-height: 1.7; }
  .panel__all { align-self: flex-start; margin-top: auto; font-size: var(--t-s); }
  /* The tiles' own motion here: no name roll; the name steps forward instead. */
  .ptiles :global(.sqname__face--roll) { animation: none !important; }
  .ptiles :global(.sqname) { transition: translate var(--d-m) var(--ease-snap); }
  .ptiles :global(.sq__img img) { transition: scale 0.7s var(--ease-snap); }
  .ptiles :global(a.sq) { transition: scale 0.14s var(--ease-soft); }
  .ptiles :global(a.sq:active) { scale: 0.985; }
  .ptile__arrow {
    position: absolute;
    right: 6cqi;
    bottom: 6cqi;
    z-index: 2;
    display: grid;
    place-items: center;
    width: max(28px, 12cqi);
    height: max(28px, 12cqi);
    background: var(--field);
    color: var(--on-field);
    opacity: 0;
    translate: -8px 0;
    transition: opacity var(--d-s) var(--ease-soft), translate var(--d-m) var(--ease-snap);
  }
  .ptile__arrow svg { width: 55%; height: 55%; }
  @media (hover: hover) {
    .ptiles :global(a.sq:hover .sq__img img) { scale: 1.06; }
    .ptiles :global(a.sq:hover .sqname) { translate: 2.5cqi 0; }
    .ptiles :global(a.sq:hover) .ptile__arrow { opacity: 1; translate: 0 0; }
  }
  .ptiles :global(a.sq:focus-visible) { outline: 2px solid var(--on-field); outline-offset: -6px; }
  .ptiles :global(a.sq:focus-visible .sq__img img) { scale: 1.06; }
  .ptiles :global(a.sq:focus-visible .sqname) { translate: 2.5cqi 0; }
  .ptiles :global(a.sq:focus-visible) .ptile__arrow { opacity: 1; translate: 0 0; }
  @media (max-width: 1100px) {
    .ptiles--engine { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Phone sheet */
  .sheet {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--page-pad) 32px;
    border: 0;
    background: var(--c-bg);
    color: var(--c-fg);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .sheet::backdrop { background: var(--c-bg); }
  .sheet__top { display: flex; justify-content: space-between; align-items: center; height: var(--header-h); }
  .sheet__close {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    background: var(--c-soft);
    color: var(--c-fg);
    font-size: var(--t-s);
    font-weight: 500;
  }
  .sheet__label { color: var(--c-muted); margin: 24px 0 12px; }
  .sheet__squares { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3px; }
  .sheet__list { border-top: 1px solid var(--c-line); }
  .sheet__list a {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--c-line);
    font-size: var(--t-h3);
    font-weight: 500;
  }
  .sheet__list--main { margin-top: 24px; }
</style>
