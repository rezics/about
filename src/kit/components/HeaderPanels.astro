---
/**
 * The header's two dropdown panels (產品, 模組) and the phone sheet, rendered at the end of the
 * document by BaseLayout. The panels are native popovers opened by the header's tab buttons
 * (popovertarget); the sheet is a modal <dialog> opened by the 選單 button (invoker commands,
 * script fallback in src/kit/motion/nav.ts). The flat square tiles live here, the one place
 * squares stay in v2.
 */
import { kinds, modules, site, kindHref, moduleHref, kindImage } from '../content';
import { kindFields, moduleFields } from '../theme';
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import Square from './Square.astro';

const nav = site.nav;
const works = kinds.filter((k) => k.group === 'works');
const agents = kinds.filter((k) => k.group === 'agents');
---
<div class="nav-layers">
  <div id="panel-products" class="panel" popover data-panel>
    <div class="panel__inner grid">
      <div class="panel__intro">
        <p class="panel__title">{nav.productsIntro.title}</p>
        <p class="panel__body">{nav.productsIntro.body}</p>
        <a class="panel__all link-draw" href="/#kinds">{nav.productsIntro.all}<Arrow /></a>
      </div>
      <div class="panel__group panel__group--works">
        <p class="panel__label label">{nav.groups.works}</p>
        <ul class="panel__squares" role="list">
          {works.map((k) => (
            <li>
              <Square name={k.name} field={kindFields[k.id]} mode="image" href={kindHref(k.id)} image={{ base: kindImage(k.id), alt: k.imageAlt }} sizes="160px" />
              <span class="panel__summary">{k.summary}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="panel__group panel__group--agents">
        <p class="panel__label label">{nav.groups.agents}</p>
        <ul class="panel__squares" role="list">
          {agents.map((k) => (
            <li>
              <Square name={k.name} field={kindFields[k.id]} mode="image" href={kindHref(k.id)} image={{ base: kindImage(k.id), alt: k.imageAlt }} sizes="160px" />
              <span class="panel__summary">{k.summary}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div id="panel-engine" class="panel" popover data-panel>
    <div class="panel__inner grid">
      <div class="panel__intro">
        <p class="panel__title">{nav.engineIntro.title}</p>
        <p class="panel__body">{nav.engineIntro.body}</p>
        <a class="panel__all link-draw" href="/engine/">{nav.engineIntro.all}<Arrow /></a>
      </div>
      <ul class="panel__squares panel__modules" role="list">
        {modules.map((m) => (
          <li>
            <Square name={m.name} field={moduleFields[m.id]} mode="plain" href={moduleHref(m.id)} />
            <span class="panel__summary">{m.summary}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <dialog id="menu" class="sheet" aria-label={nav.menu} data-menu>
    <div class="sheet__top">
      <Logo label={site.name} />
      <button type="button" class="sheet__close" command="close" commandfor="menu" data-menu-close>{nav.close}</button>
    </div>
    <div class="sheet__body">
      <p class="sheet__label label">{nav.products}</p>
      <ul class="sheet__squares" role="list">
        {kinds.map((k) => (
          <li>
            <Square name={k.name} field={kindFields[k.id]} mode="image" href={kindHref(k.id)} image={{ base: kindImage(k.id), alt: k.imageAlt }} sizes="33vw" />
          </li>
        ))}
      </ul>
      <p class="sheet__label label">{nav.engine}</p>
      <ul class="sheet__list" role="list">
        <li><a href="/engine/">{nav.engineIntro.all}</a></li>
        {modules.map((m) => (
          <li><a href={moduleHref(m.id)}>{m.name}</a></li>
        ))}
      </ul>
      <ul class="sheet__list sheet__list--main" role="list">
        <li><a href="/developers/">{nav.developers}</a></li>
        <li><a href="/roadmap/">{nav.roadmap}</a></li>
      </ul>
    </div>
  </dialog>
</div>
<style>
  /* Panels: floating sheets under the bar (the sheet radius and the float shadow), opening
     with a short fade. Inside, the flat square tiles keep their kind pictures. */
  .panel {
    position: fixed;
    inset: calc(var(--header-h) + 6px) auto auto 50%;
    width: min(calc(100vw - 2 * var(--page-pad)), calc(var(--container) + 2 * var(--page-pad)));
    max-width: none;
    max-height: calc(100dvh - var(--header-h) - 18px);
    margin: 0;
    padding: 0;
    border: 1px solid var(--c-line);
    border-radius: var(--r-sheet);
    background: var(--c-surface);
    color: var(--c-fg);
    box-shadow: var(--shadow-float);
    overflow: auto;
    overscroll-behavior: contain;
    translate: -50% 0;
    opacity: 1;
    transition: opacity 0.2s var(--ease-soft), translate 0.28s var(--ease-snap), overlay 0.28s allow-discrete, display 0.28s allow-discrete;
  }
  .panel:not(:popover-open) { opacity: 0; translate: -50% -8px; }
  @starting-style {
    .panel:popover-open { opacity: 0; translate: -50% -8px; }
  }
  .panel::backdrop { background: color-mix(in srgb, var(--c-fg) 8%, transparent); }
  .panel__inner { padding: clamp(24px, 3vw, 36px); row-gap: 24px; }
  .panel__intro { grid-column: 1 / span 3; display: flex; flex-direction: column; gap: 10px; }
  .panel__title { font-size: var(--t-h3); font-weight: 500; line-height: 1.4; }
  .panel__body { color: var(--c-muted); font-size: var(--t-s); line-height: 1.7; }
  .panel__all { align-self: flex-start; margin-top: 6px; font-size: var(--t-s); }
  .panel__label { color: var(--c-muted); margin-bottom: 12px; }
  .panel__group--works { grid-column: 5 / span 5; }
  .panel__group--agents { grid-column: 10 / span 3; }
  .panel__squares { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 12px; }
  .panel__group--agents .panel__squares { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .panel__modules { grid-column: 5 / span 8; grid-template-columns: repeat(5, minmax(0, 1fr)); align-self: start; }
  .panel__summary { display: block; margin-top: 8px; font-size: var(--t-xs); line-height: 1.5; color: var(--c-muted); }
  @media (max-width: 1100px) {
    .panel__intro { grid-column: 1 / span 4; }
    .panel__group--works { grid-column: 5 / span 8; }
    .panel__group--agents { grid-column: 5 / span 8; }
  }

  /* Phone sheet */
  .sheet {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--page-pad) 32px;
    border: 0;
    background: var(--c-bg);
    color: var(--c-fg);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .sheet::backdrop { background: var(--c-bg); }
  .sheet__top { display: flex; justify-content: space-between; align-items: center; height: var(--header-h); }
  .sheet__close {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    background: var(--c-soft);
    color: var(--c-fg);
    font-size: var(--t-s);
    font-weight: 500;
  }
  .sheet__label { color: var(--c-muted); margin: 24px 0 12px; }
  .sheet__squares { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .sheet__list { border-top: 1px solid var(--c-line); }
  .sheet__list a {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--c-line);
    font-size: var(--t-h3);
    font-weight: 500;
  }
  .sheet__list--main { margin-top: 24px; }
</style>
