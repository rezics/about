---
/**
 * The closing (v3): a final statement in the large serif on paper, one optional sentence under it
 * and the ink pill 「前往 REZICS」 (or the page's own action through `label` and `href`). Every page
 * ends on it, before the footer. `bg` (v2's coloured block) is accepted and ignored.
 */
import { site } from '../content';
import ProductCall from './ProductCall.astro';
import { idFor } from '../ids';

interface Props {
  title?: string;
  body?: string;
  label?: string;
  href?: string;
  /** Deprecated (v2): the closing is on paper in v3. */
  bg?: string;
}
const { title = site.product.headline, body = site.product.body, label, href } = Astro.props;
const id = idFor('close', title);
---
<section class="close" aria-labelledby={id}>
  <div class="grid">
    <h2 id={id} class="close__title t-statement">{title}</h2>
    {body && <p class="close__body">{body}</p>}
    <div class="close__cta"><ProductCall label={label} href={href} /></div>
  </div>
</section>
<style>
  .close { padding-block: var(--space-section) clamp(120px, 12vw, 200px); }
  .close__title { grid-column: 2 / 11; font-weight: var(--w-head); }
  .close__body { grid-column: 2 / 8; margin-top: 28px; font-size: 17px; line-height: 1.9; color: var(--c-text); }
  .close__cta { grid-column: 2 / 8; margin-top: 40px; }
  @media (max-width: 767px) { .close { padding-bottom: 104px; } .close__body { font-size: 16px; margin-top: 20px; } .close__cta { margin-top: 32px; } }
</style>
