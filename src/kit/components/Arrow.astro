---
// A decorative arrow drawn as a shape, not a glyph (no font dependency, nothing for contrast
// checkers to misread). It travels along its direction when its link is hovered (.arrow).
interface Props {
  dir?: 'right' | 'down';
  class?: string;
}
const { dir = 'right', class: className } = Astro.props;
---
<svg class:list={['arrow', 'arrow-svg', className]} viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false" style={dir === 'down' ? 'rotate: 90deg' : undefined}>
  <path d="M1 8h12M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
</svg>
<style>
  .arrow-svg { display: inline-block; width: 0.9em; height: 0.9em; margin-left: 0.35em; vertical-align: -0.08em; flex: none; }
</style>
