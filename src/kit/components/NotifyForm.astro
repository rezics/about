---
/**
 * The notify form: the square you fill with your email. Posts to /api/notify (the Worker); without
 * script the post redirects to /notified/. src/kit/motion/notify.ts sends it with fetch and shows
 * the result in place. Every message is in the markup, so the font subset covers it.
 */
import { site } from '../content';

const n = site.notify;
const messages = { sending: n.sending, done: n.done, ...n.errors };
---
<form class="notify-form" method="post" action="/api/notify" data-notify data-messages={JSON.stringify(messages)}>
  <label class="notify-form__label" for="notify-email">{n.label}</label>
  <div class="notify-form__row">
    <input
      id="notify-email"
      class="notify-form__input"
      name="email"
      type="email"
      required
      maxlength="254"
      autocomplete="email"
      inputmode="email"
      spellcheck="false"
      placeholder={n.placeholder}
      aria-describedby="notify-privacy notify-status"
    />
    <button class="btn notify-form__submit" type="submit">
      <span class="btn__label"><span>{n.submit}</span><span aria-hidden="true">{n.submit}</span></span>
    </button>
  </div>
  <div class="notify-form__trap" aria-hidden="true">
    <input name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p id="notify-status" class="notify-form__status" role="status" aria-live="polite"></p>
  <p id="notify-privacy" class="notify-form__privacy">{n.privacy}</p>
</form>
<style>
  .notify-form { display: flex; flex-direction: column; gap: 12px; }
  .notify-form__label { font-weight: 700; font-size: var(--t-s); letter-spacing: 0.04em; }
  .notify-form__row { display: flex; flex-wrap: wrap; gap: 8px; }
  .notify-form__input {
    flex: 1 1 14em;
    min-width: 0;
    min-height: 48px;
    padding: 0 14px;
    border: 2px solid currentColor;
    border-radius: 0;
    background: transparent;
    font-size: var(--t-body);
  }
  .notify-form__input::placeholder { color: var(--c-muted); opacity: 1; }
  .notify-form__input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .notify-form__trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .notify-form__status { min-height: 1.7em; font-weight: 700; }
  .notify-form__status[data-state='error'] { color: var(--c-fg); text-decoration: underline; text-decoration-color: var(--c-mark); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .notify-form__privacy { font-size: var(--t-s); color: var(--c-muted); max-width: var(--measure); }
</style>
