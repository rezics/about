---
/**
 * Footer on every page: it ends on the action card that leads into REZICS (「前往 REZICS」),
 * then the small print. A page that already ends on its own action square passes
 * `action={false}` (the home page does).
 */
import { site } from '../content';
import Logo from './Logo.astro';
import ProductCall from './ProductCall.astro';

interface Props {
  action?: boolean;
}
const { action = true } = Astro.props;
const f = site.footer;
---
<footer class="footer band-ink">
  {action && (
    <section class="footer__action grid" aria-labelledby="footer-action-title">
      <div class="footer__lead">
        <h2 id="footer-action-title" class="t-l">{site.product.headline}</h2>
      </div>
      <div class="footer__square">
        <p class="footer__body"><span class="footer__cursor" aria-hidden="true" data-cursor></span>{site.product.body}</p>
        <ProductCall />
      </div>
    </section>
  )}
  <div class="footer__meta grid">
    <div class="footer__brand">
      <Logo label={site.name} />
      <p class="footer__tagline">{f.tagline}</p>
    </div>
    <p class="footer__links"><a class="link-utility" href={f.sourceUrl} rel="noopener">{f.source}</a></p>
    <p class="footer__colophon">{f.colophon}</p>
    <p class="footer__copy">{f.copyright}</p>
  </div>
</footer>
<style>
  .footer { position: relative; z-index: var(--z-content); }
  .footer__action { --sq-pad: clamp(20px, 3vw, 40px); padding-block: var(--space-normal); row-gap: 32px; }
  /* The heading sits level with the action at the bottom of the square. */
  .footer__lead { grid-column: 1 / span 7; align-self: end; padding-bottom: var(--sq-pad); }
  /* A page that ends on a finale band has already said where to go: the card keeps its line
     and the action, and the statement is not repeated. */
  :global(main:has(.finale)) ~ .footer .footer__lead { display: none; }
  :global(main:has(.finale)) ~ .footer .footer__square { grid-column: 1 / span 6; }
  .footer__square {
    grid-column: 9 / span 4;
    position: relative;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: var(--sq-pad);
    border: 1px solid var(--c-line-strong);
  }
  .footer__body { max-width: 24em; font-size: var(--t-m); font-weight: 700; line-height: 1.5; }
  .footer__cursor {
    display: inline-block;
    width: 4px;
    height: 1.25em;
    margin-right: 0.4em;
    vertical-align: -0.2em;
    background: var(--c-mark);
  }
  .footer__meta {
    padding-block: 32px 40px;
    border-top: 1px solid var(--c-line);
    row-gap: 16px;
    align-items: center;
    font-size: var(--t-s);
  }
  .footer__brand { grid-column: 1 / span 4; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .footer__tagline { color: var(--c-muted); }
  .footer__links { grid-column: 5 / span 2; }
  .footer__links a { display: inline-flex; align-items: center; min-height: 44px; }
  .footer__colophon { grid-column: 7 / span 4; color: var(--c-muted); }
  .footer__copy { grid-column: 11 / span 2; text-align: right; color: var(--c-muted); }
  @media (max-width: 899px) {
    .footer__lead, .footer__square, .footer__brand, .footer__links, .footer__colophon, .footer__copy { grid-column: 1 / -1; text-align: left; }
    .footer__lead { padding-bottom: 0; }
  }
</style>
