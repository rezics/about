---
/**
 * The footer (the mock): the logo and the line on the left; columns for the six works and
 * software, the three hubs for AI agents, the modules, and REZICS itself; the small print under a
 * hairline. Pages end on their own closing block before it.
 */
import { kinds, modules, site, kindHref, moduleHref } from '../content';
import Logo from './Logo.astro';

interface Props {
  /** Kept for older pages; the closing block is now part of each page. */
  action?: boolean;
}
const f = site.footer;
const nav = site.nav;
const works = kinds.filter((k) => k.group === 'works');
const agents = kinds.filter((k) => k.group === 'agents');
---
<footer class="footer grid">
  <div class="footer__brand">
    <Logo label={site.name} />
    <p>{f.tagline}</p>
  </div>
  <nav class="footer__cols" aria-label={f.sitemap}>
    <div>
      <p class="footer__head">{nav.products}</p>
      <ul role="list">{works.map((k) => <li><a class="link-utility" href={kindHref(k.id)}>{k.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer__head">{f.agents}</p>
      <ul role="list">{agents.map((k) => <li><a class="link-utility" href={kindHref(k.id)}>{k.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer__head">{nav.engine}</p>
      <ul role="list">{modules.map((m) => <li><a class="link-utility" href={moduleHref(m.id)}>{m.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer__head">{site.name}</p>
      <ul role="list">
        <li><a class="link-utility" href="/developers/">{nav.developers}</a></li>
        <li><a class="link-utility" href="/roadmap/">{nav.roadmap}</a></li>
        <li><a class="link-utility" href={f.sourceUrl} rel="noopener">{f.source}</a></li>
      </ul>
    </div>
  </nav>
  <div class="footer__meta">
    <p>{f.colophon}</p>
    <p>{f.copyright}</p>
  </div>
</footer>
<style>
  .footer { position: relative; z-index: var(--z-content); padding-top: 64px; padding-bottom: 40px; row-gap: 40px; font-size: 14px; color: var(--c-fg); }
  .footer__brand { grid-column: 1 / 5; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; color: var(--c-muted); }
  .footer__cols { grid-column: 6 / 13; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px var(--gutter); }
  .footer__head { font-size: 13px; font-weight: 600; color: var(--c-muted); margin-bottom: 12px; }
  .footer__cols li { line-height: 2.1; }
  .footer__cols a { display: inline-block; min-height: 24px; }
  .footer__meta { grid-column: 1 / 13; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 32px; padding-top: 24px; border-top: 1px solid var(--c-line); font-size: 13px; color: var(--c-muted); }
  @media (max-width: 767px) {
    .footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
