---
/**
 * Section shell: spacing mood, ground and the 12-column grid inside the container. Place
 * children with the .col-* classes (base.css). `band`: `soft` (the muted panel) or `tint` (a soft
 * tint of the site's accent); `field` is the tint too, `ink` an ink band kept for older pages.
 * `grid={false}` renders the slot inside the container only.
 */
interface Props {
  id?: string;
  mood?: 'tight' | 'normal' | 'airy' | 'full' | 'none';
  band?: 'paper' | 'soft' | 'tint' | 'ink' | 'field';
  grid?: boolean;
  labelledby?: string;
  class?: string;
  [key: `data-${string}`]: unknown;
}
const { id, mood = 'normal', band = 'paper', grid = true, labelledby, class: className, ...rest } = Astro.props;
---
<section
  id={id}
  class:list={['sec', mood !== 'none' && mood !== 'full' && `pad-${mood}`, mood === 'full' && 'sec--full', band !== 'paper' && `band-${band}`, className]}
  aria-labelledby={labelledby}
  {...rest}
>
  {grid ? <div class="grid container sec__grid"><slot /></div> : <div class="container"><slot /></div>}
</section>
<style>
  .sec { position: relative; }
  .sec--full { min-height: calc(100svh - var(--header-h)); display: grid; align-content: center; }
  .sec__grid { row-gap: clamp(24px, 3vw, 48px); }
</style>
