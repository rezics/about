---
// A kind's square from the shared content: its field, picture and name.
import type { KindId } from '../../content/schema';
import { kindById, kindHref, kindImage } from '../content';
import { kindFields } from '../theme';
import Square from './Square.astro';

interface Props {
  kind: KindId;
  mode?: 'flood' | 'image' | 'plain';
  /** Link to the kind's site (default) or render a static square. */
  link?: boolean;
  sizes?: string;
  eager?: boolean;
  flip?: 'target';
  class?: string;
  describe?: boolean;
  [key: `data-${string}`]: unknown;
}
const { kind, mode = 'flood', link = true, describe = false, ...rest } = Astro.props;
const k = kindById(kind);
---
<Square
  name={k.name}
  field={kindFields[kind]}
  mode={mode}
  href={link ? kindHref(kind) : undefined}
  image={{ base: kindImage(kind), alt: k.imageAlt }}
  description={describe ? k.summary : undefined}
  data-kind={kind}
  {...rest}
/>
