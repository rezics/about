---
// A name set to fill its box (src/kit/fit.ts): the box must set `container-type: inline-size`.
// `roll`: the name rolls one line when its link is hovered or focused (one face leaves upward and
// returns from below, so no decorative copy sits in the DOM). `height` caps the name's height
// (percent of the box) when something shares the square.
import { fitName, MINOR } from '../fit';

interface Props {
  name: string;
  roll?: boolean;
  height?: number;
  class?: string;
}
const { name, roll = false, height, class: className } = Astro.props;
const fit = fitName(name);
// With a height cap the name also carries a shorter size; the square switches to it where there
// is room for what shares the square (a container query in Square.astro).
const short = height === undefined ? fit.size : fitName(name, 88, height).size;
---
<span class:list={['sqname', fit.latin && 'sqname--latin', className]} style={`--fit:${fit.size};--fit-short:${short};--minor:${MINOR}`}>
  <span class="sqname__roll">
    <span class:list={['sqname__face', roll && 'sqname__face--roll']}>{fit.lines.map((line) => <span class:list={['sqname__line', line.minor && 'sqname__line--minor']}>{line.text}</span>)}</span>
  </span>
</span>
<style>
  .sqname {
    position: absolute;
    inset: 6cqi 6cqi auto 6cqi;
    display: block;
    overflow: clip;
    font-family: var(--f-display);
    font-weight: 900;
    font-size: calc(var(--fit) * 1cqi);
    line-height: 1;
    letter-spacing: 0;
    z-index: 1;
    color: var(--on-field);
    /* Over a picture the glyphs keep a trap of the field colour (Square.astro sets
       --sqname-trap where a picture shows), so they stay legible. */
    -webkit-text-stroke: var(--sqname-trap, 0) var(--field);
    paint-order: stroke fill;
    pointer-events: none;
  }
  .sqname--latin { font-stretch: 125%; line-height: 0.92; letter-spacing: -0.01em; }
  .sqname__roll { display: grid; }
  .sqname__face { grid-area: 1 / 1; display: block; }
  .sqname__line { display: block; white-space: nowrap; }
  .sqname__line--minor { font-size: calc(var(--minor) * 1em); line-height: 1.2; padding-left: 0.08em; }
</style>
