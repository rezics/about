---
/**
 * "Next page / next site" (DESIGN.md "Direction v2"): a calm card across the container on a soft
 * tint of the next thing's field, its small label and its name at heading size, with an arrow
 * that steps forward on hover or focus. The whole card is the link. The footer's closing panel
 * (「前往 REZICS」) follows it on every page, so a finale needs no action of its own.
 */
import type { Field } from '../theme';
import { fieldStyle } from '../theme';

interface Props {
  label: string;
  name: string;
  href: string;
  field: Field;
  /** One line under the name (what the next page or site is about). */
  body?: string;
}
const { label, name, href, field, body } = Astro.props;
---
<div class="finale-wrap container">
  <a class="finale" href={href} style={fieldStyle(field)}>
    <span class="finale__text">
      <span class="finale__label label">{label}</span>
      <span class="finale__name">{name}</span>
      {body && <span class="finale__body">{body}</span>}
    </span>
    <span class="finale__go" aria-hidden="true">
      <svg viewBox="0 0 16 16" focusable="false"><path d="M2 8h10.5M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </a>
</div>
<style>
  .finale-wrap { padding-top: calc(var(--space-section) / 2); }
  .finale {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(24px, 3vw, 40px) clamp(24px, 4vw, 48px);
    border-radius: var(--r-card);
    background: var(--tint);
    color: var(--c-fg);
    transition: background-color var(--d-m) var(--ease-soft);
  }
  .finale__text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .finale__label { color: var(--c-muted); }
  .finale__name { font-size: var(--t-h2); font-weight: 500; line-height: 1.3; }
  .finale__body { color: var(--c-muted); font-size: var(--t-s); }
  .finale__go {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--c-surface);
    box-shadow: var(--shadow-card);
    transition: translate var(--d-s) var(--ease-soft);
  }
  .finale__go svg { width: 18px; height: 18px; }
  @media (hover: hover) {
    .finale:hover { background: var(--tint-strong); }
    .finale:hover .finale__go { translate: 4px 0; }
  }
  .finale:focus-visible { background: var(--tint-strong); }
  .finale:focus-visible .finale__go { translate: 4px 0; }
</style>
