---
/**
 * A section on the Swiss grid whose body is a hairline list (the mock's principles): the meta
 * column carries the label (or the section number), the heading runs across columns 4 to 12, and
 * the titled rows run under it. Without a title the label is the section's heading.
 */
import Sec from './Sec.astro';
import HairList from './HairList.astro';

interface Row {
  title: string;
  body: string;
}
interface Props {
  label: string;
  title?: string;
  lede?: string;
  items: Row[];
  id?: string;
  class?: string;
}
const { label, title, lede, items, id, class: className } = Astro.props;
---
<Sec label={label} title={title} id={id} class={className}>
  {lede && <p class="text ilist__lede">{lede}</p>}
  <HairList items={items} />
</Sec>
<style>
  .ilist__lede { max-width: 40em; margin-bottom: 32px; }
</style>
