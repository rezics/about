---
/**
 * A small code block (v3, quiet): one real request on a deeper paper, in the mono face, with a
 * caption under a hairline. Comments are muted, the command is ink and strings are the books
 * green (5.6:1 on its ground). Scrolls sideways on phones; keyboard users can focus it.
 */
interface Props {
  code: string;
  caption?: string;
  /** The accessible name of the code (what the request does). */
  label: string;
  class?: string;
}
const { code, caption, label, class: className } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const html = code
  .split('\n')
  .map((line) => {
    if (/^\s*#/.test(line)) return `<span class="c">${esc(line)}</span>`;
    return esc(line)
      .replace(/("[^"]*")/g, '<span class="s">$1</span>')
      .replace(/^(\s*)(curl|npx|npm|yarn)\b/, '$1<span class="k">$2</span>');
  })
  .join('\n');
---
<figure class:list={['codetile', className]}>
  <pre tabindex="0" aria-label={label}><code set:html={html} /></pre>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .codetile { display: flex; flex-direction: column; gap: 22px; padding: clamp(20px, 2vw, 28px); background: var(--c-panel); color: var(--c-ink); min-width: 0; }
  .codetile pre { font: 13.5px/1.9 var(--f-mono); white-space: pre; overflow-x: auto; }
  .codetile :global(.c) { color: var(--c-muted); }
  .codetile :global(.k) { font-weight: 700; }
  .codetile :global(.s) { color: #3f5a45; }
  .codetile figcaption { padding-top: 14px; border-top: 1px solid var(--c-line); font-size: 13px; line-height: 1.7; color: var(--c-muted); }
  @media (max-width: 767px) { .codetile pre { font-size: 12.5px; } }
</style>
