---
/**
 * The closing call to action (DESIGN.md "Direction v2", Rhythm): a large soft rounded panel (the
 * sheet radius) with a centred line and 「前往 REZICS」. The footer shows one on every page from
 * `site.product`; a page with its own closing line renders this and passes `action={false}` to
 * its layout. `ground="tint"` takes the site's accent tint instead of the muted panel.
 */
import { site } from '../content';
import ProductCall from './ProductCall.astro';
import { idFor } from '../ids';
import Clauses from '../Clauses.astro';

interface Props {
  title?: string;
  body?: string;
  /** Show the title (default). Pages that end on a finale keep only the body and the action. */
  showTitle?: boolean;
  ground?: 'soft' | 'tint';
  label?: string;
  href?: string;
  class?: string;
}
const {
  title = site.product.headline,
  body = site.product.body,
  showTitle = true,
  ground = 'soft',
  label,
  href,
  class: className,
} = Astro.props;
const id = idFor('closing', title);
---
<section class:list={['closing', className]} aria-labelledby={showTitle ? id : undefined} aria-label={showTitle ? undefined : site.nav.action}>
  <div class="container">
    <div class:list={['closing__panel', `closing__panel--${ground}`]} data-reveal="up">
      {showTitle && <h2 id={id} class="t-h2 closing__title"><Clauses text={title} /></h2>}
      {body && <p class:list={['closing__body', !showTitle && 'closing__body--lead']}>{body}</p>}
      <ProductCall label={label} href={href} />
    </div>
  </div>
</section>
<style>
  .closing { padding-block: calc(var(--space-section) / 2); }
  .closing__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: clamp(56px, 2rem + 6vw, 128px) clamp(24px, 6vw, 96px);
    border-radius: var(--r-sheet);
    text-align: center;
  }
  .closing__panel--soft { background: var(--c-soft); }
  .closing__panel--tint { background: var(--tint); }
  .closing__title { max-width: 18em; font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.5rem); }
  .closing__body { max-width: 30em; color: var(--c-muted); margin-bottom: 12px; }
  .closing__body--lead { color: var(--c-fg); font-size: var(--t-h3); font-weight: 500; }
</style>
