---
/**
 * A mini-site's bar under the global header: its small square and name, its page tabs with the
 * current page marked, and its action. Sticky; when the header steps aside on scroll it moves up.
 */
import type { MiniSite, MiniSitePage } from '../../content/schema';
import { site as shared } from '../content';
import { pageHref } from '../sites';

interface Props {
  site: MiniSite;
  page: MiniSitePage;
}
const { site, page } = Astro.props;
const action = site.action ?? { label: shared.nav.action, href: '#notify' };
const initial = [...site.name][0];
---
<nav class="sitebar" aria-label={site.name} data-sitebar>
  <div class="sitebar__inner">
    <a class="sitebar__home" href={site.base} aria-current={page.slug === '' ? 'page' : undefined}>
      <span class="sitebar__sq" aria-hidden="true">{initial}</span>
      <span class="sitebar__name">{site.name}</span>
    </a>
    {site.pages.length > 1 && (
      <ul class="sitebar__tabs" role="list">
        {site.pages.map((p) => (
          <li>
            <a class="sitebar__tab" href={pageHref(site, p)} aria-current={p.slug === page.slug ? 'page' : undefined}>{p.label}</a>
          </li>
        ))}
      </ul>
    )}
    <a class="btn btn--small sitebar__action" href={action.href} data-notify-link={action.href === '#notify' ? '' : undefined}>
      <span class="btn__label"><span>{action.label}</span><span aria-hidden="true">{action.label}</span></span>
    </a>
  </div>
</nav>
<style>
  .sitebar {
    position: sticky;
    top: var(--header-h);
    z-index: var(--z-bar);
    background: var(--field);
    color: var(--on-field);
    transition: translate var(--d-m) var(--ease-snap);
    --c-fg: var(--on-field);
    --c-bg: var(--field);
    --focus: var(--on-field);
  }
  :global(html.frame-away) .sitebar { translate: 0 calc(-1 * var(--header-h)); }
  .sitebar__inner {
    height: var(--bar-h);
    display: flex;
    align-items: center;
    gap: var(--gutter);
    padding-inline: var(--gutter);
  }
  .sitebar__home { display: inline-flex; align-items: center; gap: 10px; min-height: 40px; flex: none; }
  .sitebar__sq {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1.5px solid currentColor;
    font-weight: 900;
    font-size: 15px;
    line-height: 1;
  }
  .sitebar__name { font-weight: 900; font-size: var(--t-s); letter-spacing: 0.02em; white-space: nowrap; }
  .sitebar__tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1 1 auto;
    min-width: 0;
  }
  .sitebar__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 10px;
    font-size: var(--t-s);
    font-weight: 700;
    white-space: nowrap;
  }
  .sitebar__tab[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    background: var(--c-mark);
    box-shadow: 0 0 0 2px var(--on-field);
  }
  @media (hover: hover) { .sitebar__tab:hover { text-decoration: underline; text-underline-offset: 0.35em; text-decoration-thickness: 2px; } }
  .sitebar__action { margin-left: auto; flex: none; }
  @media (max-width: 599px) {
    .sitebar__action { display: none; }
  }
</style>
