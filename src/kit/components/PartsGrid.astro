---
/**
 * A square's 3×3 at rest: the name on its field in the centre, the eight parts around it. With
 * `notes`, each cell also carries one line on what the part gives here (a data/facts grid).
 * `layout` places the parts (src/kit/arrange.ts); by default they follow `parts` in reading order.
 */
import type { PartId } from '../../content/schema';
import type { Field } from '../theme';
import { fieldStyle } from '../theme';
import { arrange, type Layout } from '../arrange';
import { partById } from '../content';
import SquareName from './SquareName.astro';

interface Props {
  name: string;
  field: Field;
  parts: PartId[];
  layout?: Layout;
  notes?: Partial<Record<PartId, string>>;
  /** Heading level for part names when notes are shown. */
  level?: 'h3' | 'h4';
  class?: string;
}
const { name, field, parts, layout = arrange([parts])[0]!, notes, level = 'h3', class: className } = Astro.props;
const cells = Array.from({ length: 9 }, (_, cell) => (cell === 4 ? null : (parts.find((p) => layout[p] === cell) ?? null)));
const Heading = level;
---
<div class:list={['parts', notes && 'parts--notes', className]} style={fieldStyle(field)}>
  <ol class="parts__cells" role="list">
    {cells.map((id, cell) =>
      cell === 4 ? (
        <li class="parts__centre" aria-hidden="true"><SquareName name={name} /></li>
      ) : id ? (
        <li class="parts__cell" data-part={id}>
          {notes ? <Heading class="parts__name">{partById(id).name}</Heading> : <span class="parts__name">{partById(id).name}</span>}
          <span class="parts__id mono">{id}</span>
          {notes?.[id] && <p class="parts__note">{notes[id]}</p>}
        </li>
      ) : (
        <li class="parts__cell parts__cell--empty" aria-hidden="true"></li>
      ),
    )}
  </ol>
</div>
<style>
  .parts { container-type: inline-size; }
  .parts__cells {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--c-line-strong);
    border-left: 1px solid var(--c-line-strong);
  }
  .parts:not(.parts--notes) .parts__cells > * { aspect-ratio: 1; }
  .parts__cell, .parts__centre {
    position: relative;
    border-right: 1px solid var(--c-line-strong);
    border-bottom: 1px solid var(--c-line-strong);
    min-width: 0;
  }
  .parts__cell { padding: 3cqi; display: flex; flex-direction: column; gap: 0.4em; }
  .parts__centre { background: var(--field); container-type: inline-size; min-height: 100%; aspect-ratio: 1; }
  .parts__name { font-weight: 700; font-size: clamp(0.875rem, 4.2cqi, 1.75rem); line-height: 1.2; }
  .parts__id { color: var(--c-muted); font-size: clamp(0.625rem, 1.6cqi, 0.8125rem); }
  .parts__note { font-size: clamp(0.875rem, 2.1cqi, 1.0625rem); line-height: 1.6; margin-top: auto; }
  .parts--notes .parts__cell { min-height: 33cqi; }
</style>
