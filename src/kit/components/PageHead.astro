---
/**
 * An inner page's opening without a picture (v3): the eyebrow (the site's name) in columns 1 to
 * 3, the serif h1 across 4 to 11 and its lead across 4 to 9, actions in the slot. A landing page
 * opens on PhotoHero instead.
 */
import Clauses from '../Clauses.astro';

interface Props {
  /** The eyebrow: the site's name. */
  label: string;
  title: string;
  lede?: string;
  class?: string;
}
const { label, title, lede, class: className } = Astro.props;
---
<section class:list={['phead', className]} aria-labelledby="page-title">
  <div class="grid">
    <p class="eyebrow phead__label">{label}</p>
    <h1 id="page-title" class="phead__title"><Clauses text={title} /></h1>
    {lede && <p class="phead__lede lead">{lede}</p>}
    {Astro.slots.has('default') && <div class="phead__ctas"><slot /></div>}
  </div>
</section>
<style>
  .phead { padding-top: clamp(72px, 10vw, 160px); }
  .phead__label { grid-column: 1 / 4; grid-row: 1; padding-top: 20px; align-self: start; }
  .phead__title { grid-column: 4 / 12; grid-row: 1; font-size: var(--t-hero); line-height: var(--lh-title); }
  .phead__lede { grid-column: 4 / 9; margin-top: 28px; font-size: 17px; max-width: none; }
  .phead__ctas { grid-column: 4 / 13; margin-top: 36px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  @media (max-width: 1023px) { .phead__lede { grid-column: 4 / 12; } }
  @media (max-width: 767px) {
    .phead { padding-top: 48px; }
    .phead__label, .phead__title { grid-row: auto; }
    .phead__label { padding: 0 0 16px; }
    .phead__title { font-size: 30px; }
    .phead__lede { font-size: 16px; margin-top: 20px; }
  }
</style>
