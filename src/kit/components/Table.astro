---
/**
 * A calm data table on a card (DESIGN.md "Direction v2"): a header row, hairlines between rows,
 * the first column as row headers. Phones: each row becomes a small stack, the column names
 * shown beside its cells. `caption` is set under the table.
 */
interface Props {
  columns: string[];
  rows: string[][];
  caption?: string;
  /** An accessible name when the caption is not one (e.g. a heading names it). */
  label?: string;
  class?: string;
}
const { columns, rows, caption, label, class: className } = Astro.props;
---
<figure class:list={['tbl', className]}>
  <div class="tbl__card">
    <table aria-label={label}>
      <thead>
        <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {row.map((cell, i) => (i === 0 ? <th scope="row" data-col={columns[0]}>{cell}</th> : <td data-col={columns[i]}>{cell}</td>))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {caption && <figcaption class="tbl__caption">{caption}</figcaption>}
</figure>
<style>
  .tbl { min-width: 0; }
  .tbl__card { overflow-x: auto; border-top: 1px solid var(--c-line); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; vertical-align: top; padding: 18px var(--gutter) 18px 0; line-height: 1.7; }
  thead th { font-size: 13px; font-weight: 600; color: var(--c-muted); padding-block: 14px 12px; }
  tbody tr { border-top: 1px solid var(--c-line); }
  tbody tr:last-child { border-bottom: 1px solid var(--c-line); }
  tbody th { font-weight: 600; }
  td { color: var(--c-text); }
  .tbl__caption { margin-top: 14px; font-size: 14px; color: var(--c-muted); }
  @media (max-width: 599px) {
    thead { display: none; }
    tr, th, td { display: block; }
    tbody tr { padding-block: 14px; }
    th, td { padding: 0; }
    td { margin-top: 4px; }
    td::before { content: attr(data-col) '：'; color: var(--c-fg); font-weight: 600; }
  }
</style>
