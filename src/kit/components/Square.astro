---
/**
 * The square: the module of the whole site (DESIGN.md "Grid, rhythm, shape"). A field colour,
 * an optional picture and a name that fills it.
 *
 * mode  'flood'  picture hidden at rest; it floods up through the square on hover or focus while
 *                the name rolls one line (index tiles)
 *       'image'  picture visible, name over it (hero squares, navigation tiles)
 *       'plain'  field and name only (modules, anything without a picture)
 * href  makes the square a link; linked squares are page-transition sources ([data-flip-src]).
 *       Its accessible name is the name unsplit (plus the description), not the set lines.
 * flip  'target' marks the square a transition lands on (one per page, the hero square)
 * facets up to five short captions set in mono under the name (plain squares: a module's
 *       points, a site's sections), so a square without a picture still fills its frame. They
 *       show where the square is at least 260 px wide. A linked plain square floods with a
 *       deeper shade of its field from the bottom on hover, as a picture floods a kind square.
 * image `${base}-960.avif|webp` and `${base}-320.avif|webp`; the field shows while it loads or
 *       when it is missing. Inside a link the picture is decorative (the name names the link).
 */
import type { Field } from '../theme';
import { fieldStyle } from '../theme';
import SquareName from './SquareName.astro';

interface Props {
  name: string;
  field: Field;
  mode?: 'flood' | 'image' | 'plain';
  href?: string;
  image?: { base: string; alt: string };
  /** Width of the square in the layout, for the picture's `sizes`. */
  sizes?: string;
  eager?: boolean;
  flip?: 'target';
  class?: string;
  /** Hidden text appended to a linked square's name, e.g. its summary. */
  description?: string;
  /** Short captions under the name (at most five are shown). */
  facets?: string[];
  [key: `data-${string}`]: unknown;
}
const {
  name,
  field,
  mode = 'plain',
  href,
  image,
  sizes = '(max-width: 767px) 50vw, 25vw',
  eager = false,
  flip,
  class: className,
  description,
  facets = [],
  ...rest
} = Astro.props;
const shownFacets = facets.slice(0, 5);
const Tag = href ? 'a' : 'div';
const escapeAttr = (v: string) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
const showPicture = mode !== 'plain' && image;
---
<Tag
  class:list={['sq', `sq--${mode}`, shownFacets.length > 0 && 'sq--facets', className]}
  href={href}
  aria-label={href ? (description ? `${name} ${description}` : name) : undefined}
  style={fieldStyle(field)}
  data-flip-src={href ? '' : undefined}
  data-flip-target={flip === 'target' ? '' : undefined}
  data-square
  {...rest}
>
  {showPicture && (
    <picture class="sq__img">
      <source type="image/avif" srcset={`${image.base}-320.avif 320w, ${image.base}-960.avif 960w`} sizes={sizes} />
      <source type="image/webp" srcset={`${image.base}-320.webp 320w, ${image.base}-960.webp 960w`} sizes={sizes} />
      {/* A linked square's name is its link text, so its picture is decorative. Astro would print
          an empty alt as a bare attribute, which some validators misread, so it is set via HTML. */}
      <Fragment set:html={`<img src="${image.base}-960.webp" alt="${escapeAttr(href ? '' : image.alt)}" width="960" height="960" loading="${eager ? 'eager' : 'lazy'}" fetchpriority="${eager ? 'high' : 'auto'}" decoding="async" data-square-img>`} />
    </picture>
  )}
  <SquareName name={name} roll={!!href} height={shownFacets.length ? 50 : undefined} />
  {href && mode === 'plain' && <span class="sq__shade" aria-hidden="true"></span>}
  {shownFacets.length > 0 && (
    <ul class="sq__facets mono" role="list" aria-hidden={href ? 'true' : undefined}>
      {shownFacets.map((f) => <li><span class="sq__dot" aria-hidden="true"></span>{f}</li>)}
    </ul>
  )}
  {description && !href && <span class="sr-only">{description}</span>}
  <slot />
</Tag>
<style>
  .sq {
    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    overflow: clip;
    background: var(--field);
    color: var(--on-field);
  }
  .sq__img { position: absolute; inset: 0; }
  .sq__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sq__img :global(img.is-missing) { visibility: hidden; }
  .sq--flood .sq__img { clip-path: inset(100% 0 0 0); transition: clip-path var(--d-m) var(--ease-snap); }
  /* Facets: mono captions in the bottom row of the square, where it is wide enough. */
  .sq__facets {
    position: absolute;
    left: 6cqi;
    right: 6cqi;
    bottom: 5cqi;
    z-index: 1;
    display: none;
    gap: 0.35em;
    font-size: clamp(0.75rem, 3.4cqi, 1.375rem);
    line-height: 1.3;
    color: var(--on-field);
  }
  .sq__facets li { display: flex; gap: 0.6em; align-items: baseline; }
  .sq__dot { flex: none; width: 0.5em; height: 0.5em; background: currentColor; }
  @container (min-width: 260px) {
    .sq--facets .sq__facets { display: grid; }
    .sq--facets :global(.sqname) { font-size: calc(var(--fit-short) * 1cqi); }
  }
  /* A picture under the name: the name keeps a trap of the field colour. `.is-lit` floods a
     flood square's picture from script (an idle sequence, a chosen item). */
  .sq--image, a.sq--flood:hover, a.sq--flood:focus-visible, .sq--flood.is-lit { --sqname-trap: 0.08em; }
  .sq--flood.is-lit .sq__img { clip-path: inset(0 0 0 0); }
  /* A linked plain square answers by inverting: its text colour floods up through it from the
     bottom and the name and facets turn to the field colour (the same AA pair, reversed). */
  .sq__shade {
    position: absolute;
    inset: 0;
    background: var(--on-field);
    clip-path: inset(100% 0 0 0);
    transition: clip-path var(--d-m) var(--ease-snap);
  }
  a.sq--plain :global(.sqname), a.sq--plain .sq__facets { transition: color 0.2s linear 0.08s; }
  @media (hover: hover) {
    a.sq--flood:hover .sq__img { clip-path: inset(0 0 0 0); }
    a.sq--plain:hover .sq__shade { clip-path: inset(0 0 0 0); }
    a.sq--plain:hover :global(.sqname), a.sq--plain:hover .sq__facets { color: var(--field); }
    a.sq:hover :global(.sqname__face--roll) { animation: rz-roll var(--d-m) var(--ease-snap); }
  }
  a.sq--flood:focus-visible .sq__img { clip-path: inset(0 0 0 0); }
  a.sq--plain:focus-visible .sq__shade { clip-path: inset(0 0 0 0); }
  a.sq--plain:focus-visible :global(.sqname), a.sq--plain:focus-visible .sq__facets { color: var(--field); }
  a.sq:focus-visible :global(.sqname__face--roll) { animation: rz-roll var(--d-m) var(--ease-snap); }
  a.sq:focus-visible { outline-offset: 4px; }
  a.sq:active { scale: 0.985; }
  @media (prefers-reduced-motion: reduce) {
    .sq :global(.sqname__face) { animation: none !important; }
  }
</style>
