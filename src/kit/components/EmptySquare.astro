---
// An empty square of the grid with the red cursor waiting in it (the 404, "the next kind").
interface Props {
  label?: string;
  class?: string;
  /** Render the label as a heading at this level instead of a plain line. */
  as?: 'h1' | 'h2' | 'p';
}
const { label, class: className, as: Tag = 'p' } = Astro.props;
---
<div class:list={['empty', className]} data-empty-square>
  <span class="empty__cursor" aria-hidden="true" data-cursor></span>
  {label && <Tag class="empty__label">{label}</Tag>}
</div>
<style>
  .empty {
    position: relative;
    aspect-ratio: 1;
    container-type: inline-size;
    border: 1px dashed var(--c-line-strong);
    background:
      linear-gradient(var(--c-line) 0 0) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--c-line) 0 0) 0 50% / 100% 1px no-repeat;
  }
  .empty__cursor {
    position: absolute;
    left: 6cqi;
    top: 6cqi;
    width: 3cqi;
    min-width: 4px;
    height: 22cqi;
    background: var(--c-mark);
  }
  .empty__label {
    position: absolute;
    left: 6cqi;
    right: 6cqi;
    bottom: 5cqi;
    font-size: clamp(0.875rem, 6cqi, 1.5rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--c-muted);
  }
</style>
