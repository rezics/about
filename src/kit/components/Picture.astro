---
/**
 * A responsive photograph (v3): AVIF and WebP at the widths the files exist in, with an optional
 * art-directed phone crop. Files follow one naming rule: `${src}-${width}.avif|webp` (and
 * `${phone.src}-${width}.avif|webp`), so `src="/images/home/hero"` with `widths={[960, 1920]}`
 * reads `/images/home/hero-960.avif` … `/images/home/hero-1920.webp`. Square corners; the
 * paper's own tone shows while it loads. `width` and `height` are the intrinsic ratio (no layout
 * shift); `position` is the CSS object-position when the frame crops it (`cover`).
 *
 * Make the files with `.temp/images-v3/encode.mjs` (V3-SPEC sizes: a hero at 1920 and 960 wide,
 * ≤ 180 KB and ≤ 70 KB; a section picture at 1200 and 640 wide, ≤ 110 KB and ≤ 45 KB).
 */
interface Crop {
  src: string;
  widths: number[];
  width: number;
  height: number;
  /** object-position on phones. */
  position?: string;
}
interface Props {
  src: string;
  widths: number[];
  alt: string;
  width: number;
  height: number;
  /** The rendered width, for the browser's choice of file. */
  sizes?: string;
  /** A different crop for phones (below 768 px). */
  phone?: Crop;
  /** Fill the parent and crop (object-fit: cover) instead of keeping the ratio. */
  cover?: boolean;
  position?: string;
  /** The page's largest picture: load at once with high priority. */
  priority?: boolean;
  class?: string;
}
const { src, widths, alt, width, height, sizes = '100vw', phone, cover = false, position, priority = false, class: className } = Astro.props;
const set = (base: string, list: number[], ext: string) => [...list].sort((a, b) => a - b).map((w) => `${base}-${w}.${ext} ${w}w`).join(', ');
const sorted = [...widths].sort((a, b) => a - b);
const fallback = `${src}-${sorted[Math.min(1, sorted.length - 1)]}.webp`;
const PHONE = '(max-width: 767px)';
const style = [position && `--pos:${position}`, phone?.position && `--pos-phone:${phone.position}`].filter(Boolean).join(';');
---
<picture class:list={['pic', cover && 'pic--cover', className]} style={style || undefined}>
  {phone && <source media={PHONE} type="image/avif" srcset={set(phone.src, phone.widths, 'avif')} sizes="100vw" width={phone.width} height={phone.height} />}
  {phone && <source media={PHONE} type="image/webp" srcset={set(phone.src, phone.widths, 'webp')} sizes="100vw" width={phone.width} height={phone.height} />}
  <source type="image/avif" srcset={set(src, widths, 'avif')} sizes={sizes} />
  <source type="image/webp" srcset={set(src, widths, 'webp')} sizes={sizes} />
  <img
    src={fallback}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>
<style>
  .pic { display: block; position: relative; overflow: hidden; background: var(--c-panel); }
  .pic img { display: block; width: 100%; height: auto; }
  .pic--cover { position: absolute; inset: 0; }
  .pic--cover img { height: 100%; object-fit: cover; object-position: var(--pos, center); }
  @media (max-width: 767px) {
    .pic--cover img { object-position: var(--pos-phone, var(--pos, center)); }
  }
</style>
