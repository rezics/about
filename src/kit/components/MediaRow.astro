---
/**
 * A text-and-image row (DESIGN.md "Direction v2", Rhythm): a short text block beside a large
 * rounded image, vertically centred. `reverse` puts the image first; rows on a page alternate.
 * Phones: one column, text before the image, the image full width with its radius. The default
 * slot follows the body (links, a short list).
 *
 *   <MediaRow title={…} body={…} image={{ base: '/images/home/index', alt: '…' }}>
 *     <a class="link-draw" href="/engine/">…<Arrow /></a>
 *   </MediaRow>
 */
import Picture from './Picture.astro';
import Clauses from '../Clauses.astro';
import { idFor } from '../ids';

interface Props {
  title: string;
  /** One paragraph, or several. */
  body?: string | string[];
  image: { base: string; alt: string; widths?: number[]; ratio?: number };
  reverse?: boolean;
  level?: 'h2' | 'h3';
  id?: string;
  class?: string;
}
const { title, body, image, reverse = false, level: Tag = 'h2', id, class: className } = Astro.props;
const paragraphs = body === undefined ? [] : Array.isArray(body) ? body : [body];
const headingId = id ?? idFor('row', title);
---
<section class:list={['row', reverse && 'row--reverse', className]} aria-labelledby={headingId}>
  <div class="container row__inner">
    <div class="row__text" data-reveal="up">
      <Tag id={headingId} class="t-h2 row__title"><Clauses text={title} /></Tag>
      {paragraphs.map((p) => <p class="row__body">{p}</p>)}
      {Astro.slots.has('default') && <div class="row__more"><slot /></div>}
    </div>
    <div class="frame row__frame" data-reveal="image">
      <Picture base={image.base} alt={image.alt} widths={image.widths ?? [640, 1024]} ratio={image.ratio ?? 1} sizes="(max-width: 767px) 100vw, 560px" />
    </div>
  </div>
</section>
<style>
  .row { padding-block: calc(var(--space-section) / 2); }
  .row__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
  }
  .row__text { grid-column: 1 / span 5; grid-row: 1; display: flex; flex-direction: column; gap: 16px; }
  .row__frame { grid-column: 7 / span 6; grid-row: 1; aspect-ratio: 1; }
  .row--reverse .row__text { grid-column: 8 / span 5; }
  .row--reverse .row__frame { grid-column: 1 / span 6; }
  .row__title { margin-bottom: 4px; }
  .row__body { color: var(--c-muted); }
  .row__more { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 8px; }
  @media (max-width: 767px) {
    .row__inner { grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
    .row__text, .row--reverse .row__text { grid-column: 1; grid-row: 1; }
    .row__frame, .row--reverse .row__frame { grid-column: 1; grid-row: 2; }
  }
</style>
