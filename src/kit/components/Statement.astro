---
/**
 * A statement (v3; the mock's `.quote`): one or two lines of large serif across columns 2 to 11,
 * the second half (`sub`) in muted ink. A `note` in body size may follow, and the default slot
 * under it across the grid. Set as a paragraph; `level="h2"` makes it the heading of what
 * follows in the slot.
 */
import { idFor } from '../ids';
import { locale } from '../locale';

interface Props {
  text: string;
  /** The muted second half, in the same size. */
  sub?: string;
  /** A short line in body size under the statement. */
  note?: string;
  level?: 'p' | 'h2';
  id?: string;
  class?: string;
}
const { text, sub, note, level, id: given, class: className } = Astro.props;
const Tag = level ?? (Astro.slots.has('default') ? 'h2' : 'p');
const id = given ?? idFor('statement', text);
// Chinese and Japanese run the halves together; other languages need a space between them.
const gap = /^(zh|ja)/.test(locale) ? '' : ' ';
---
<div class:list={['stmt', className]}>
  <div class="grid">
    <Tag id={id} class="stmt__text t-statement">{text}{sub && <>{gap}<span class="quiet">{sub}</span></>}</Tag>
    {note && <p class="stmt__note">{note}</p>}
    {Astro.slots.has('default') && <div class="stmt__more"><slot /></div>}
  </div>
</div>
<style>
  .stmt { padding-top: var(--space-section); }
  .stmt__text { grid-column: 2 / 12; }
  .stmt__note { grid-column: 2 / 8; margin-top: 32px; font-size: var(--t-body); line-height: var(--lh-text); color: var(--c-text); }
  .stmt__more { grid-column: 1 / 13; margin-top: 72px; min-width: 0; }
  @media (max-width: 767px) { .stmt__note { margin-top: 24px; } .stmt__more { margin-top: 44px; } }
</style>
