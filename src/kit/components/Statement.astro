---
/**
 * A statement on the grid (the mock's platform statement): set across columns 4 to 12 at the
 * section size, with an optional muted continuation in the same size. The default slot
 * follows under it across the width (an index, a list).
 */
import Clauses from '../Clauses.astro';
import { idFor } from '../ids';

interface Props {
  text: string;
  /** A muted continuation in the same size. */
  sub?: string;
  /** A short line in body size under the statement. */
  note?: string;
  id?: string;
  class?: string;
}
const { text, sub, note, id: given, class: className } = Astro.props;
const id = given ?? idFor('statement', text);
---
<section class:list={['stmt', className]} aria-labelledby={id}>
  <div class="grid">
    <h2 id={id} class="stmt__text"><Clauses text={text} />{sub && <span class="stmt__sub">{sub}</span>}</h2>
    {note && <p class="stmt__note">{note}</p>}
    {Astro.slots.has('default') && <div class="stmt__more"><slot /></div>}
  </div>
</section>
<style>
  .stmt { padding-top: var(--space-section); }
  .stmt__text { grid-column: 4 / 12; font-size: var(--t-h2); font-weight: 600; line-height: 1.28; letter-spacing: 0.01em; }
  .stmt__sub { color: var(--c-muted); }
  .stmt__note { grid-column: 4 / 11; margin-top: 28px; font-size: var(--t-body); line-height: 1.85; color: var(--c-text); }
  .stmt__more { grid-column: 1 / 13; margin-top: 56px; min-width: 0; }
</style>
