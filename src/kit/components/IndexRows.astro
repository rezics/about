---
/**
 * An index of links as full-width rows under hairlines (the mock's module list): the name, one
 * line, an arrow. On hover and focus the row floods with ink from the left and its text inverts.
 */
interface Row {
  name: string;
  desc: string;
  href: string;
}
interface Props {
  rows: Row[];
  class?: string;
}
const { rows, class: className } = Astro.props;
---
<ul class:list={['irows', className]} role="list">
  {rows.map((r) => (
    <li>
      <a class="irow" href={r.href}>
        <span class="irow__name">{r.name}</span>
        <span class="irow__desc">{r.desc}</span>
        <svg class="irow__arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h10.5M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </li>
  ))}
</ul>
<style>
  .irows { border-top: 1px solid var(--c-line); }
  .irow {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--gutter);
    padding: 26px var(--gutter);
    margin: 0 calc(var(--gutter) * -1);
    border-bottom: 1px solid var(--c-line);
    color: var(--c-fg);
    transition: color 0.35s var(--ease-snap);
  }
  .irow::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--c-ink-band); transform: scaleX(0); transform-origin: left; transition: transform 0.45s var(--ease-snap); }
  .irow__name { font-size: 24px; font-weight: 600; line-height: 1.3; }
  .irow__desc { font-size: 16px; line-height: 1.7; }
  .irow__arrow { justify-self: end; width: 20px; height: 20px; transition: translate 0.45s var(--ease-snap); }
  @media (hover: hover) {
    .irow:hover { color: var(--c-paper); }
    .irow:hover::before { transform: none; }
    .irow:hover .irow__arrow { translate: 6px 0; }
  }
  .irow:focus-visible { color: var(--c-paper); outline-offset: -4px; outline-color: var(--c-paper); }
  .irow:focus-visible::before { transform: none; }
  .irow:active { scale: 0.995; }
  @media (max-width: 767px) {
    .irow { grid-template-columns: minmax(0, 1fr) auto; row-gap: 6px; padding-block: 20px; }
    .irow__desc { grid-column: 1; grid-row: 2; }
    .irow__arrow { grid-column: 2; grid-row: 1; }
  }
</style>
