---
/**
 * A calm index of links (v3): full-width rows under hairlines, the name in the serif, one line,
 * an arrow. On hover and focus the name takes the link accent and slides a few pixels, the arrow
 * steps forward. Use it where a tile masonry would be too loud (the home page's five modules, a
 * site's further reading). Place it in a Section's default slot or slot `wide`.
 */
interface Row {
  name: string;
  desc: string;
  href: string;
}
interface Props {
  rows: Row[];
  class?: string;
}
const { rows, class: className } = Astro.props;
---
<ul class:list={['irows', className]} role="list">
  {rows.map((r) => (
    <li>
      <a class="irow" href={r.href}>
        <span class="irow__name serif">{r.name}</span>
        <span class="irow__desc">{r.desc}</span>
        <svg class="irow__arrow" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h10.5M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </li>
  ))}
</ul>
<style>
  .irows { border-top: 1px solid var(--c-line); }
  .irow {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) 24px;
    align-items: baseline;
    gap: var(--gutter);
    padding: 28px 0 30px;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-fg);
  }
  .irow__name { font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); line-height: 1.4; transition: color 0.3s var(--ease-soft), translate 0.45s var(--ease-snap); }
  .irow__desc { font-size: 16px; line-height: 1.8; color: var(--c-text); }
  .irow__arrow { align-self: center; justify-self: end; width: 18px; height: 18px; color: var(--c-muted); transition: translate 0.45s var(--ease-snap), color 0.3s var(--ease-soft); }
  @media (hover: hover) {
    .irow:hover .irow__name { color: var(--c-link); translate: 6px 0; }
    .irow:hover .irow__arrow { color: var(--c-link); translate: 4px 0; }
  }
  .irow:focus-visible { outline-offset: -2px; }
  .irow:focus-visible .irow__name { color: var(--c-link); translate: 6px 0; }
  .irow:focus-visible .irow__arrow { color: var(--c-link); translate: 4px 0; }
  .irow:active .irow__name { translate: 3px 0; }
  .irow:active .irow__arrow { translate: 2px 0; }
  @media (max-width: 767px) {
    .irow { grid-template-columns: minmax(0, 1fr) 20px; row-gap: 6px; padding: 22px 0 24px; }
    .irow__desc { grid-column: 1; grid-row: 2; font-size: 15px; }
    .irow__arrow { grid-column: 2; grid-row: 1; }
  }
</style>
