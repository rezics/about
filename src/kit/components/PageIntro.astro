---
/**
 * A page's opening (DESIGN.md "Direction v2", Rhythm): a centred page title, one sentence under
 * it, the page's actions (slot), and optionally a large rounded image across the container. No
 * eyebrow. `align="start"` sets the title on the left for inner pages that open on more text. A
 * square image (`ratio: 1`) sits beside the text instead of under it (inner pages).
 *
 *   <PageIntro title={…} lede={…} image={{ base: '/images/home/hero', alt: '…', widths: [640, 1024, 1536], ratio: 16 / 9 }}>
 *     <ProductCall />
 *   </PageIntro>
 */
import Picture from './Picture.astro';
import Clauses from '../Clauses.astro';

interface Props {
  title: string;
  lede?: string;
  align?: 'center' | 'start';
  /** Heading level: the page's h1 (default). */
  level?: 'h1' | 'h2';
  id?: string;
  image?: { base: string; alt: string; widths?: number[]; ratio?: number };
  class?: string;
}
const { title, lede, align = 'center', level: Tag = 'h1', id = 'intro-title', image, class: className } = Astro.props;
const hasActions = Astro.slots.has('default');
const split = !!image && (image.ratio ?? 16 / 9) === 1;
---
<section class:list={['intro', `intro--${split ? 'start' : align}`, split && 'intro--split', className]} aria-labelledby={id}>
  {split && image ? (
    <div class="container intro__split">
      <div class="intro__text">
        <Tag id={id} class="t-title intro__title"><Clauses text={title} /></Tag>
        {lede && <p class="lede intro__lede">{lede}</p>}
        {hasActions && <div class="intro__actions"><slot /></div>}
      </div>
      <div class="frame intro__square">
        <Picture base={image.base} alt={image.alt} widths={image.widths ?? [640, 1024]} ratio={1} sizes="(max-width: 767px) 100vw, 520px" eager />
      </div>
    </div>
  ) : (
  <div class:list={['container', align === 'center' && 'container--narrow', 'intro__text']}>
    <Tag id={id} class="t-title intro__title"><Clauses text={title} /></Tag>
    {lede && <p class="lede intro__lede">{lede}</p>}
    {hasActions && <div class="intro__actions"><slot /></div>}
  </div>
  )}
  {image && !split && (
    <div class="container intro__media">
      <div class="frame intro__frame">
        <Picture base={image.base} alt={image.alt} widths={image.widths ?? [640, 1024, 1536]} ratio={image.ratio ?? 16 / 9} sizes="(max-width: 767px) 100vw, min(1120px, 92vw)" eager />
      </div>
    </div>
  )}
</section>
<style>
  .intro { padding-top: clamp(40px, 1.5rem + 5vw, 112px); padding-bottom: calc(var(--space-section) / 2); }
  .intro__text { display: flex; flex-direction: column; gap: 20px; }
  .intro--center .intro__text { align-items: center; text-align: center; }
  .intro--center .intro__lede { margin-inline: auto; }
  .intro__title { max-width: 22em; }
  .intro--start .intro__title { max-width: 18em; }
  .intro__lede { color: var(--c-muted); }
  .intro__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 12px; }
  .intro--center .intro__actions { justify-content: center; }
  .intro__media { margin-top: clamp(40px, 1.5rem + 4vw, 88px); }
  .intro__frame { aspect-ratio: 16 / 9; }
  /* The picture settles from a slight scale as the page opens; it is never hidden, so it can be
     the page's largest paint. */
  :global(.motion) .intro__frame :global(img), :global(.motion) .intro__square :global(img) { animation: intro-settle 1.6s var(--ease-snap) both; }
  .intro__split { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 32px; align-items: center; }
  .intro__split .intro__text { grid-column: 1 / span 6; }
  .intro__square { grid-column: 8 / span 5; aspect-ratio: 1; }
  @media (max-width: 767px) {
    .intro__split .intro__text, .intro__square { grid-column: 1 / -1; }
  }
  @keyframes intro-settle { from { scale: 1.05; } }
  @media (max-width: 599px) {
    .intro__frame { aspect-ratio: 4 / 3; }
    .intro__text { gap: 16px; }
  }
</style>
