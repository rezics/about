---
/**
 * The action into the live product: 「前往 REZICS」 to `site.productUrl`. The header, the closing
 * panel and any page that needs a primary action use this one component: an ink-blue pill with
 * an arrow after the label that steps forward on hover or focus.
 */
import { site } from '../content';

interface Props {
  label?: string;
  href?: string;
  /** `small` for bars. `secondary` is the muted-panel pill. */
  size?: 'normal' | 'small';
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { label = site.nav.action, href = site.productUrl, size = 'normal', variant = 'primary', class: className } = Astro.props;
---
<a class:list={['btn', 'btn--icon', size === 'small' && 'btn--small', variant === 'secondary' && 'btn--secondary', className]} href={href}>
  <span class="btn__label"><span>{label}</span></span>
  <svg class="btn__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M2.5 8h10M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
