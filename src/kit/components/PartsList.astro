---
/**
 * A kind's parts as a compact list, one line each: the part's name with a dot in the site's
 * accent, its id as a small label, and what it gives (the kind's own note when given, else what
 * the part gives any kind). Soft cards in v2; one column on a phone. Prefer it to PartsGrid.
 */
import type { PartId } from '../../content/schema';
import { partById } from '../content';

interface Props {
  parts: PartId[];
  notes?: Partial<Record<PartId, string>>;
  /** Heading level for the part names; omit for plain text. */
  level?: 'h3' | 'h4';
  class?: string;
}
const { parts, notes, level, class: className } = Astro.props;
const Name = level ?? 'span';
---
<ul class:list={['partslist', className]} role="list">
  {parts.map((id, i) => {
    const part = partById(id);
    return (
      <li class="chip" style={`--i:${i}`} data-part={id}>
        <span class="chip__head">
          <span class="chip__mark" aria-hidden="true"></span>
          <Name class="chip__name">{part.name}</Name>
          <span class="chip__id label">{id}</span>
        </span>
        <span class="chip__note">{notes?.[id] ?? part.gives}</span>
      </li>
    );
  })}
</ul>
<style>
  .partslist { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); border-top: 1px solid var(--c-line); }
  .chip { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 4px var(--gutter); padding: 18px 0; border-bottom: 1px solid var(--c-line); min-width: 0; }
  .chip__head { display: flex; flex-direction: column; gap: 2px; }
  .chip__mark { display: none; }
  .chip__name { font-weight: 600; font-size: 17px; line-height: 1.4; }
  .chip__id { color: var(--c-muted); font-family: var(--f-latin), var(--f-cjk); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; }
  .chip__note { font-size: 15px; line-height: 1.75; color: var(--c-text); }
  @media (max-width: 767px) {
    .partslist { grid-template-columns: minmax(0, 1fr); }
    .chip { grid-template-columns: minmax(0, 1fr); }
  }
</style>
