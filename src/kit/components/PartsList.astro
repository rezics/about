---
/**
 * A kind's parts as a compact list, one line each: the part's name with a dot in the site's
 * accent, its id as a small label, and what it gives (the kind's own note when given, else what
 * the part gives any kind). Soft cards in v2; one column on a phone. Prefer it to PartsGrid.
 */
import type { PartId } from '../../content/schema';
import { partById } from '../content';

interface Props {
  parts: PartId[];
  notes?: Partial<Record<PartId, string>>;
  /** Heading level for the part names; omit for plain text. */
  level?: 'h3' | 'h4';
  class?: string;
}
const { parts, notes, level, class: className } = Astro.props;
const Name = level ?? 'span';
---
<ul class:list={['partslist', className]} role="list">
  {parts.map((id, i) => {
    const part = partById(id);
    return (
      <li class="chip" style={`--i:${i}`} data-part={id}>
        <span class="chip__head">
          <span class="chip__mark" aria-hidden="true"></span>
          <Name class="chip__name">{part.name}</Name>
          <span class="chip__id label">{id}</span>
        </span>
        <span class="chip__note">{notes?.[id] ?? part.gives}</span>
      </li>
    );
  })}
</ul>
<style>
  .partslist {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 10px;
  }
  .chip {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border-radius: var(--r-lg);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    color: var(--c-fg);
    min-width: 0;
  }
  .chip__head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .chip__mark { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--field); }
  .chip__name { font-weight: 500; font-size: var(--t-body); line-height: 1.4; }
  .chip__id { color: var(--c-muted); font-family: var(--f-latin), var(--f-cjk); }
  .chip__note { font-size: var(--t-s); line-height: 1.7; color: var(--c-muted); }
</style>
