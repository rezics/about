---
// The REZICS Z mark in logo red (a non-text mark) and the wordmark.
interface Props {
  href?: string;
  label: string;
  wordmark?: boolean;
}
const { href = '/', label, wordmark = true } = Astro.props;
---
<a href={href} class="logo" aria-label={label}>
  <svg viewBox="0 142.857 1000 714.286" aria-hidden="true" focusable="false">
    <path d="M0 571.429 642.857 142.857 571.429 428.571 1000 142.857v285.714L357.143 857.143l71.428-285.714L0 857.143Z" />
  </svg>
  {wordmark && <span class="logo__word" aria-hidden="true">REZICS</span>}
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--c-fg);
    transition: opacity var(--d-s) var(--ease-soft);
  }
  /* Quiet: the logo eases back a little under the pointer. */
  @media (hover: hover) { .logo:hover { opacity: 0.72; } }
  .logo:active { opacity: 0.6; }
  .logo svg { width: 25px; height: 18px; fill: var(--c-mark); flex: none; }
  /* The wordmark in the interface face, as in the product. */
  .logo__word {
    font-family: var(--f-latin), sans-serif;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.22em;
  }
</style>
