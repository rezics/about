---
/**
 * Global header (v3, V3-SPEC "Parts"): paper ground, the logo left, the four tabs centred
 * (產品 ▾, 模組 ▾, 開發者, 路線圖), 「前往 REZICS」 as an underlined text link on the right; phones
 * show the logo and 選單. 產品 and 模組 are disclosure buttons for the two dropdown panels
 * (full-width areas of flat paper-colour tiles). The
 * panels and the phone sheet are rendered at the end of the document (HeaderPanels.astro), so
 * a page's own content comes first in the HTML; the browser keeps a popover after its invoker
 * in the focus order. The panels are native popovers, so
 * they open, close on Escape and light-dismiss without script; src/kit/motion/nav.ts adds the
 * pointer intent delay, the grace period and the safe area, and keeps aria-expanded in step.
 * Phones get a 選單 button that opens a modal sheet (native <dialog> through invoker commands,
 * with a script fallback).
 */
import { kinds, site, kindHref } from '../content';
import Logo from './Logo.astro';

interface Props {
  path: string;
}
const { path } = Astro.props;
const nav = site.nav;
const section = kinds.some((k) => path.startsWith(kindHref(k.id)))
  ? 'products'
  : path.startsWith('/engine/')
    ? 'engine'
    : path.startsWith('/developers/')
      ? 'developers'
      : path.startsWith('/roadmap/')
        ? 'roadmap'
        : '';
---
<header class="header" data-header>
  <div class="header__bar">
    <div class="header__logo"><Logo label={site.name} /></div>
    <nav class="header__tabs" data-tabs>
      <ul role="list">
        <li>
          <button type="button" class="tab" popovertarget="panel-products" aria-controls="panel-products" data-panel-button="panel-products" aria-current={section === 'products' ? 'true' : undefined}>
            <span>{nav.products}</span><span class="tab__caret" aria-hidden="true"></span>
          </button>
        </li>
        <li>
          <button type="button" class="tab" popovertarget="panel-engine" aria-controls="panel-engine" data-panel-button="panel-engine" aria-current={section === 'engine' ? 'true' : undefined}>
            <span>{nav.engine}</span><span class="tab__caret" aria-hidden="true"></span>
          </button>
        </li>
        <li><a class="tab" href="/developers/" aria-current={section === 'developers' ? 'page' : undefined}><span>{nav.developers}</span></a></li>
        <li><a class="tab" href="/roadmap/" aria-current={section === 'roadmap' ? 'page' : undefined}><span>{nav.roadmap}</span></a></li>
      </ul>
    </nav>
    <div class="header__end">
      <a class="header__go link-draw" href={site.productUrl}>{nav.action}</a>
      <button type="button" class="header__menu" command="show-modal" commandfor="menu" aria-haspopup="dialog" data-menu-open>
        {nav.menu}
      </button>
    </div>
  </div>


</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--c-bg);
    color: var(--c-fg);
    transition: translate var(--d-m) var(--ease-snap);
  }
  :global(html.frame-away) .header { translate: 0 -100%; }
  .header__bar {
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gutter);
    padding-inline: var(--gutter);
  }
  .header__end { display: flex; justify-content: flex-end; align-items: center; gap: 10px; }
  /* Tabs: plain text, 14 px 500, 36 px apart; the current section is underlined, hover and an
     open panel take the link accent. */
  .header__tabs ul { display: flex; gap: 36px; }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--c-fg);
    transition: color var(--d-s) var(--ease-soft);
  }
  .tab > span:first-child { padding-block: 2px; border-bottom: 1px solid transparent; transition: translate var(--d-m) var(--ease-snap), border-color var(--d-s) var(--ease-soft); }
  .tab[aria-current] > span:first-child { border-bottom-color: currentColor; }
  @media (hover: hover) {
    .tab:hover { color: var(--c-link); }
    .tab:hover > span:first-child { border-bottom-color: currentColor; translate: 0 -2px; }
  }
  .tab:focus-visible > span:first-child { border-bottom-color: currentColor; translate: 0 -2px; }
  .tab:active > span:first-child { translate: 0 0; }
  .tab[aria-expanded='true'] { color: var(--c-link); }
  .tab__caret {
    width: 5px;
    height: 5px;
    border-right: 1.25px solid currentColor;
    border-bottom: 1.25px solid currentColor;
    rotate: 45deg;
    translate: 0 -2px;
    opacity: 0.55;
    transition: rotate var(--d-s) var(--ease-snap), translate var(--d-s) var(--ease-snap);
  }
  .tab[aria-expanded='true'] .tab__caret { rotate: 225deg; translate: 0 1px; }
  .header__go { font-size: 14px; }
  .header__menu {
    display: none;
    min-height: 44px;
    padding: 0 2px;
    color: var(--c-fg);
    font-size: 14px;
    font-weight: 600;
  }
  .header__menu:active { translate: 0 1px; }
  @media (max-width: 899px) {
    .header__bar { grid-template-columns: auto 1fr; }
    .header__tabs { display: none; }
    .header__menu { display: inline-flex; align-items: center; }
    .header__go { display: none; }
  }
</style>
